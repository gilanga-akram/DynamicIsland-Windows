<Window x:Class="DynamicIsland.QuickControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pusat Kontrol"
        Width="360"
        Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- macOS Control Center module -->
        <Style x:Key="CcModule" TargetType="Border">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <!-- Invisible button wrapper with a soft hover -->
        <Style x:Key="ControlTileBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Control Center slider: thick rounded track, white fill, white knob -->
        <Style x:Key="MacSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22">
                            <Border Background="#2EFFFFFF" CornerRadius="11"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#F2FFFFFF" Height="22" CornerRadius="11,0,0,11" Margin="0,0,-11,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="22">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#FFFFFF" Stroke="#1A000000" StrokeThickness="0.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.35"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <!-- Dark frosted panel -->
        <Border CornerRadius="20" BorderThickness="0.8" Padding="12" VerticalAlignment="Bottom">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F02C2C30" Offset="0.0"/>
                    <GradientStop Color="#F51C1C1F" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#0FFFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <!-- MAIN VIEW (Control Center) -->
                <StackPanel x:Name="PanelMainView" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Connectivity module: Wi-Fi + Bluetooth -->
                        <Border Grid.Column="0" Style="{StaticResource CcModule}" Padding="4">
                            <StackPanel>
                                <Button Style="{StaticResource ControlTileBtn}" Padding="6" Click="BtnWifiTile_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BdWifiTile" Width="30" Height="30" CornerRadius="15" Background="#0A84FF">
                                            <Path x:Name="IconWifi" Stretch="Uniform" Width="14" Height="11" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12,4C7.31,4,3.07,5.9,0,8.98L12,21l12-12.02C20.93,5.9,16.69,4,12,4z"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                            <TextBlock x:Name="TxtWifiHeader" Text="Wi-Fi" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock x:Name="TxtWifiStatus" Text="Tidak terhubung" Foreground="#99EBEBF5" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtWifiArrow" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#73EBEBF5" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ControlTileBtn}" Padding="6" Click="BtnBluetoothTile_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BdBtTile" Width="30" Height="30" CornerRadius="15" Background="#0A84FF">
                                            <Path x:Name="IconBt" Stretch="Uniform" Width="10" Height="14" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M14.24,12.01L19,7.24l-6.5-6.5C12.12,0.36,11.5,0.78,11.5,1.31v8.83L6.84,5.49L5.43,6.9l5.66,5.66l-5.66,5.66l1.41,1.41L11.5,15v8.130c0,0.53,0.62,0.95,1,0.57l6.5-6.5L14.24,12.01z M13.5,3.95l3.05,3.05l-3.05,3.05V3.95z M13.5,19.24v-6.1l3.05,3.05L13.5,19.24z"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                            <TextBlock x:Name="TxtBtHeader" Text="Bluetooth" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock x:Name="TxtBtStatus" Text="Nyala" Foreground="#99EBEBF5" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtBtArrow" Grid.Column="2" Text="" Foreground="#73EBEBF5" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right column: Focus + Battery saver modules -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CcModule}" Padding="3">
                                <Button Style="{StaticResource ControlTileBtn}" Padding="6,4" Click="BtnDndTile_Click" VerticalAlignment="Stretch">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BdDndTile" Width="30" Height="30" CornerRadius="15" Background="#48484A">
                                            <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M9.37,5.51C9.19,6.15,9.1,6.82,9.1,7.5c0,4.08,3.32,7.4,7.4,7.4c0.68,0,1.35-0.09,1.99-0.27C17.45,17.19,14.93,19,12,19c-3.86,0-7-3.14-7-7C5,9.07,6.81,6.55,9.37,5.51z"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                            <TextBlock Text="Fokus" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock x:Name="TxtDndStatus" Text="Mati" Foreground="#99EBEBF5" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Border>

                            <Border Grid.Row="2" x:Name="BdBatSaverTile" Style="{StaticResource CcModule}" Padding="3">
                                <Button Style="{StaticResource ControlTileBtn}" Padding="6,4" Click="BtnBatterySaver_Click" VerticalAlignment="Stretch">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#48484A">
                                            <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M17,8C8,10,5.9,16.17,3.82,21.34L5.71,22l1-2.3A4.49,4.49,0,0,0,8,20C19,20,22,3,22,3,21,5,14,5.25,9,6.25V8c4-0.5,8-0.5,8,0z"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                            <TextBlock Text="Hemat Baterai" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Buka pengaturan" Foreground="#99EBEBF5" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Display module -->
                    <Border Style="{StaticResource CcModule}" Padding="12,9,12,11" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Layar" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtBrightnessVal" Text="23" Foreground="#99EBEBF5" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Slider x:Name="SliderBrightness" Style="{StaticResource MacSlider}" ValueChanged="SliderBrightness_ValueChanged"/>
                                <Path Stretch="Uniform" Width="12" Height="12" Fill="#8E8E93" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False" Data="M12,7c-2.76,0-5,2.24-5,5s2.24,5,5,5 5-2.24,5-5-2.24-5-5-5zM2,13h2c0.55,0,1-0.45,1-1s-0.45-1-1-1H2c-0.55,0-1,0.45-1,1s0.45,1,1,1zm18,0h2c0.55,0,1-0.45,1-1s-0.45-1-1-1h-2c-0.55,0-1,0.45-1,1s0.45,1,1,1zM11,2v2c0,0.55,0.45,1,1,1s1-0.45,1-1V2c0-0.55-0.45-1-1-1s-1,0.45-1,1zm0,18v2c0,0.55,0.45,1,1,1s1-0.45,1-1v-2c0-0.55-0.45-1-1-1s-1,0.45-1,1z"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Sound module -->
                    <Border Style="{StaticResource CcModule}" Padding="12,9,12,11" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Suara" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtVolumeVal" Text="12" Foreground="#99EBEBF5" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Slider x:Name="SliderVolume" Style="{StaticResource MacSlider}" ValueChanged="SliderVolume_ValueChanged"/>
                                <Path Stretch="Uniform" Width="12" Height="11" Fill="#8E8E93" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False" Data="M3,9v6h4l5,5V4L7,9H3zm13.5,3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73,2.5-2.25,2.5-4.02z"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Footer: battery + settings -->
                    <Grid Height="30" Margin="6,10,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border BorderBrush="#99EBEBF5" BorderThickness="1" CornerRadius="3" Width="22" Height="11" Padding="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border x:Name="BdPowerBar" Background="#30D158" CornerRadius="1.5" Width="14" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock x:Name="TxtBatteryPercent" Text="86%" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBatteryState" Text="  mengisi daya" Foreground="#99EBEBF5" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ControlTileBtn}" Padding="5" Click="BtnOpenSettings_Click" ToolTip="Pengaturan">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#99EBEBF5"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- WIFI DETAIL VIEW (Flyout with available networks) -->
                <Grid x:Name="PanelWifiView" Visibility="Collapsed" Height="330">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Style="{StaticResource ControlTileBtn}" Padding="6,3" Click="BtnBackToMain_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#0A84FF" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Kembali" Foreground="#0A84FF" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Wi-Fi" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ControlTileBtn}" Padding="6,4" Click="BtnRefreshWifi_Click" ToolTip="Muat ulang">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#99EBEBF5" FontSize="13"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6">
                        <StackPanel x:Name="PanelWifiList">
                            <!-- Populated in code-behind -->
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Style="{StaticResource ControlTileBtn}" Click="BtnOpenFullWifiSettings_Click" HorizontalAlignment="Stretch" Padding="0">
                        <Border Style="{StaticResource CcModule}" Padding="8,7">
                            <TextBlock Text="Pengaturan Jaringan Lainnya..." Foreground="#FFFFFF" FontSize="11.5" HorizontalAlignment="Center"/>
                        </Border>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

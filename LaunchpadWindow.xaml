<Window x:Class="DynamicIsland.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launchpad"
        Height="560"
        Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- App Grid Hover Style -->
        <Style x:Key="AppTileBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTrans" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Result Row Style -->
        <Style x:Key="SearchResultBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Glass card -->
        <Border Width="446" Height="524" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="22" BorderThickness="1.2" Padding="14,14,14,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4A3C5166" Offset="0.0"/>
                    <GradientStop Color="#301B283C" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#25FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.42"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Search bar -->
                    <RowDefinition Height="40"/>
                    <!-- App grid (default) OR Search results -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom profile bar -->
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- ── Row 0: Search bar ── -->
                <Border Grid.Row="0" Background="#30FFFFFF" BorderBrush="#40FFFFFF"
                        BorderThickness="1" CornerRadius="12" Padding="10,0" Margin="0,0,0,10">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <!-- 🔍 -->
                        <Path Grid.Column="0" Stretch="Uniform" Width="13" Height="13" Fill="#CCFFFFFF"
                              VerticalAlignment="Center"
                              Data="M15.5,14h-.79l-.28-.27A6.471,6.471,0,0,0,16,9.5,6.5,6.5,0,1,0,9.5,16a6.471,6.471,0,0,0,4.23-1.57l.27.28v.79l5,4.99L20.49,19Zm-6,0C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5,14,7.01,14,9.5,11.99,14,9.5,14Z"/>
                        <!-- TextBox -->
                        <TextBox Grid.Column="1" x:Name="TxtSearchBox"
                                 Text="" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI"
                                 VerticalAlignment="Center" Margin="8,0,0,0"
                                 TextChanged="TxtSearchBox_TextChanged"
                                 KeyDown="TxtSearchBox_KeyDown"/>
                        <!-- Placeholder -->
                        <TextBlock Grid.Column="1" x:Name="TxtSearchPlaceholder"
                                   Text="Cari aplikasi, file, atau web..."
                                   Foreground="#80FFFFFF" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsHitTestVisible="False"/>
                        <!-- Clear button -->
                        <Button Grid.Column="2" x:Name="BtnClearSearch"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Visibility="Collapsed"
                                Click="BtnClearSearch_Click">
                            <TextBlock Text="✕" Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Row 1A: Default App Grid (visible when no search) ── -->
                <ScrollViewer Grid.Row="1" x:Name="ScrollApps"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Visible">
                    <WrapPanel x:Name="PanelApps" ItemWidth="86" ItemHeight="76"
                               HorizontalAlignment="Center">
                        <!-- 1. File Explorer -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchExplorer_Click" Tag="File Explorer">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_Explorer.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="File Explorer" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Spotify -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchSpotify_Click" Tag="Spotify">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_Spotify.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="Spotify" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Microsoft Edge -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchEdge_Click" Tag="Microsoft Edge">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_Edge.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="Microsoft Edge" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Antigravity -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchAntigravity_Click" Tag="Antigravity IDE">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_Antigravity.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="Antigravity" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. Google Chrome -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchChrome_Click" Tag="Google Chrome">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_Chrome.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="Google Chrome" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. Email -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchMail_Click" Tag="Email Gmail">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_Email.png" Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="Email" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 7. WhatsApp -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchWhatsApp_Click" Tag="WhatsApp">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_WhatsApp.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="WhatsApp" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 8. Discord -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchDiscord_Click" Tag="Discord">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_Discord.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="Discord" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 9. Musik -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchMusic_Click" Tag="Musik">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="#FA2D48" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.2"/></Border.Effect>
                                    <Path Stretch="Uniform" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"/>
                                </Border>
                                <TextBlock Text="Musik" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 10. Catatan -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchNotes_Click" Tag="Catatan Notepad">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/></Border.Effect>
                                    <Image Source="Assets/icon_Notepad.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="Catatan" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 11. Kalender -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchCalendar_Click" Tag="Kalender Calendar">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="#FFFFFF" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.2"/></Border.Effect>
                                    <Grid>
                                        <Border Height="12" VerticalAlignment="Top" Background="#FF3B30" CornerRadius="12,12,0,0">
                                            <TextBlock x:Name="TxtLaunchCalMonth" Text="OKT" Foreground="#FFFFFF" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="TxtLaunchCalDay" Text="24" Foreground="#111111" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,9,0,0"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Kalender" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 12. Pengaturan -->
                        <Button Style="{StaticResource AppTileBtn}" Click="LaunchSettings_Click" Tag="Pengaturan Settings">
                            <StackPanel HorizontalAlignment="Center" Width="80">
                                <Border Width="44" Height="44" CornerRadius="12" Background="#4A5263" BorderBrush="#606A80" BorderThickness="1" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.2"/></Border.Effect>
                                    <Path Stretch="Uniform" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M19.14,12.94c0.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24,0-.43.17-.47.41l-.36,2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47,0-.59.22L2.74,8.87c-.12.21-.08.47.12.61l2.03,1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03,1.58c-.18.14-.23.41-.12.61l1.92,3.32c.12.22.37.29.59.22l2.39-.96c.5.38,1.03.7,1.62.94l.36,2.54c.05.24.24.41.48.41h3.84c.24,0,.44-.17.47-.41l.36-2.54c.59-.24,1.13-.56,1.62-.94l2.39.96c.22.08.47,0,.59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6 3.6,1.62,3.6,3.6-1.62,3.6-3.6,3.6z"/>
                                </Border>
                                <TextBlock Text="Pengaturan" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </ScrollViewer>

                <!-- ── Row 1B: Search Results Panel (visible when typing) ── -->
                <Grid Grid.Row="1" x:Name="PanelSearchView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- Cari di web footer -->
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelSearchResults" Margin="0,0,0,6"/>
                    </ScrollViewer>

                    <!-- Search web footer button -->
                    <Button Grid.Row="1" x:Name="BtnSearchWeb"
                            Style="{StaticResource SearchResultBtn}"
                            Background="#28FFFFFF" Click="BtnSearchWeb_Click"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🌐" FontSize="14" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock x:Name="TxtWebSearchLabel"
                                           Text="Cari di Google: ..."
                                           Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Buka di browser" Foreground="#88FFFFFF" FontSize="9.5"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- ── Row 2: Bottom Profile + Power ── -->
                <Border Grid.Row="2" Background="#20FFFFFF" BorderBrush="#30FFFFFF"
                        BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,8,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#2A384D" BorderBrush="#4A5D78" BorderThickness="1">
                                <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtUserProfileName" Text="Gilang Akram"
                                       Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnPower" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="BtnPower_Click" ToolTip="Daya &amp; Kunci Layar">
                            <Path Stretch="Uniform" Width="14" Height="14" Fill="#FFFFFF"
                                  Data="M13,3h-2v10h2V3z M17.83,5.17l-1.42,1.42C18.25,7.99,19,9.9,19,12c0,3.87-3.13,7-7,7s-7-3.13-7-7c0-2.1,0.75-4.01,2.59-5.42L6.17,5.17C3.99,6.86,2.5,9.48,2.5,12.5c0,5.25,4.25,9.5,9.5,9.5s9.5-4.25,9.5-9.5C21.5,9.48,20.01,6.86,17.83,5.17z"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

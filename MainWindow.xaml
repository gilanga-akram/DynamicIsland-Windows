<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DynamicIsland"
        mc:Ignorable="d"
        Title="Dynamic Island Pro"
        Height="350" Width="920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInverted"/>
        <local:CountToVisibilityConverter x:Key="CountToVis" Invert="False"/>
        <local:CountToVisibilityConverter x:Key="CountToVisInverted" Invert="True"/>

        <!-- macOS Palette -->
        <SolidColorBrush x:Key="NotchBg" Color="#000000" />
        <SolidColorBrush x:Key="NotchBorder" Color="#222228" />
        <SolidColorBrush x:Key="BatteryTrack" Color="#17351F" />
        <SolidColorBrush x:Key="BatteryGreen" Color="#30D158" />
        <SolidColorBrush x:Key="AccentBlue" Color="#0A84FF" />
        <SolidColorBrush x:Key="AccentAppleMusic" Color="#FA2D48" />
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9F0A" />
                <SolidColorBrush x:Key="GlassCardBg" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="GlassCardBorder" Color="#38FFFFFF" />
        <SolidColorBrush x:Key="CardBg" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#38FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextMuted" Color="#585860" />

        <!-- Navigation Pill Button Style -->
        <Style x:Key="NavPillBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F0F5FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,2.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22222A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Action Button Style -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="Opacity" Value="1.0" />
                                <Setter Property="Background" Value="#1C1C22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Media Action Button Style -->
        <Style x:Key="RoundActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E24" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#32323C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline Media Action Button Style -->
        <Style x:Key="InlineMediaBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DCDCE0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25252E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Tool Card Button Style -->
        <!-- Quick Tool Card Button Style (macOS Crystal Frosted Glass matching Dock) -->
        <Style x:Key="ToolCardBtn" TargetType="Button">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="toolBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#40FFFFFF" />
                                <Setter Property="BorderBrush" Value="#70FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Ultra-sleek macOS Style ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#45FFFFFF" CornerRadius="2" Margin="0"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#45FFFFFF" CornerRadius="2" Margin="0"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Apple-style Clean Responsive Slider -->
        <Style x:Key="AppleSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#0A84FF" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#262632" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="14" Height="14">
                                                    <Ellipse Fill="#FFFFFF"/>
                                                    <Ellipse Width="14" Height="14" Stroke="#0A84FF" StrokeThickness="1"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Thin Track iOS/macOS Volume Slider matching Screenshot -->
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="#D1D1D6" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="#383842" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="11" Height="11">
                                                    <Ellipse Fill="#FFFFFF"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Top Header Square/Pill Icon Button -->
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F0F5FF" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25252A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting Pill Button Style -->
        <Style x:Key="SettingPillBtn" TargetType="Button">
            <Setter Property="Background" Value="#16161E" />
            <Setter Property="Foreground" Value="#F0F5FF" />
            <Setter Property="BorderBrush" Value="#252530" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#242432" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist macOS Menu Separator -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#242434" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist macOS / Dynamic Island ContextMenu Style -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border x:Name="MenuBorder"
                                Background="#20FFFFFF"
                                BorderBrush="#282836"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="5,5">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist macOS / Dynamic Island MenuItem Style -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#E2E2EA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <!-- The Item Row Capsule -->
                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="10,5.5" Margin="2,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="16"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Integrated Checkmark (No gray square gutter) -->
                                    <Path x:Name="CheckMark" Grid.Column="0" 
                                          Data="M 1,5 L 4.5,8.5 L 11,2" 
                                          Stroke="#0A84FF" StrokeThickness="1.8" 
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" 
                                          Visibility="Collapsed" Margin="0,0,6,0"/>

                                    <!-- Header Content (Includes emoji & title text) -->
                                    <ContentPresenter x:Name="HeaderHost" Grid.Column="1" 
                                                      ContentSource="Header" 
                                                      RecognizesAccessKey="True" 
                                                      VerticalAlignment="Center"/>

                                    <!-- Submenu Arrow (Chevron) -->
                                    <TextBlock x:Name="SubMenuArrow" Grid.Column="2" 
                                               Text="›" FontSize="13" FontWeight="Bold" 
                                               Foreground="#8E8E98" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" 
                                               Margin="8,-1,0,0" 
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Submenu Popup Container -->
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Right" 
                                   HorizontalOffset="2" 
                                   VerticalOffset="-4" 
                                   PopupAnimation="Fade">
                                <Border Background="#20FFFFFF" 
                                        BorderBrush="#282836" 
                                        BorderThickness="1" 
                                        CornerRadius="14" 
                                        Padding="5,5">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover / Highlighted State -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Checkable Checked State -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Has Submenu (SubmenuHeader Role) -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555562"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Screen Anchor (Supports Top, Left, and Right Docking) -->
    <Grid x:Name="IslandRootGrid" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">

        <!-- Dynamic Island Pill (Zero Box Shadow, Pure Capsule Corners, Scroll-Switchable) -->
        <!-- Dynamic Island Hardware Notch (Flared ears seamlessly attached to top/side bezels) -->
        <Border x:Name="IslandBorder"
                Width="240"
                Height="36"
                CornerRadius="0"
                Background="Transparent"
                BorderThickness="0"
                MouseEnter="IslandBorder_MouseEnter"
                MouseLeave="IslandBorder_MouseLeave"
                MouseLeftButtonDown="IslandBorder_MouseLeftButtonDown"
                MouseLeftButtonUp="IslandBorder_MouseLeftButtonUp"
                MouseRightButtonUp="IslandBorder_MouseRightButtonUp"
                MouseMove="IslandBorder_MouseMove"
                PreviewMouseWheel="IslandBorder_PreviewMouseWheel"
                SizeChanged="IslandBorder_SizeChanged"
                Cursor="Arrow"
                AllowDrop="True"
                DragEnter="IslandBorder_DragEnter"
                DragOver="IslandBorder_DragOver"
                DragLeave="IslandBorder_DragLeave"
                Drop="IslandBorder_Drop"
                ToolTip="Klik kiri: Buka Dynamic Island • Klik kanan: Buka Pengaturan Poni Settings">

            <Grid>
                <!-- Attached Notch Shape (Hardware cutout fused to screen top bezel) -->
                <Path x:Name="NotchFillPath" Fill="#000000" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                <Path x:Name="NotchBorderPath" Stroke="#25252C" StrokeThickness="1" IsHitTestVisible="False" SnapsToDevicePixels="True"/>

                <!-- Content Container (Clipped to Notch Geometry) -->
                <Grid x:Name="NotchContentGrid">
                    <!-- DRAG & DROP OVERLAY TARGET -->
                    <Border x:Name="DropZoneOverlay" Visibility="Collapsed" Opacity="0" Background="#F2080812" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="18" Margin="2" Panel.ZIndex="99" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="LEPASKAN BERKAS DI SINI" Foreground="#00F0FF" FontWeight="Bold" FontSize="10.5"/>
                                <TextBlock Text="Simpan ke Shelf &amp; Siap Dibagikan" Foreground="#C7C7CC" FontSize="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- 1. COMPACT NOTCH (Modes: Battery, Music, Perf) -->
                    <!-- ============================================== -->
                    <Grid x:Name="CompactView" Visibility="Visible" Opacity="1">

                        <!-- 1A. HORIZONTAL COMPACT CONTAINER (DOCK TOP) -->
                        <Grid x:Name="CompactHorizontalContainer" Visibility="Visible">

                        <!-- Mode A: Status Baterai (Matches Image 1) -->
                        <Grid x:Name="CompactBatteryView" Visibility="Visible" Opacity="1" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: AirPods Earbuds Graphic -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="ToggleDeviceIcon_Click" ToolTip="Klik untuk ganti Headset / Mouse">
                                <Grid Width="28" Height="20" VerticalAlignment="Center">
                                    <Path Data="M 5,2 C 8,2 9,5 8,9 L 8,16 C 8,17 7,18 6,18 C 5,18 4,17 4,16 L 4,10 C 2.5,9 2,6 3,4 Z" Fill="#FFFFFF" Margin="0,0,10,0"/>
                                    <Path Data="M 15,2 C 12,2 11,5 12,9 L 12,16 C 12,17 13,18 14,18 C 15,18 16,17 16,16 L 16,10 C 17.5,9 18,6 17,4 Z" Fill="#FFFFFF" Margin="6,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- Center: Camera Notch Reflection Dot -->
                            <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" Background="#25FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactCenterDot_Click" ToolTip="Klik untuk ganti mode (Baterai / Musik / Performa)">
                                <Ellipse Width="3" Height="3" Fill="#0E1726"/>
                            </Border>

                            <!-- Right: Glowing Circular Green Battery Ring -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="ToggleDeviceIcon_Click" ToolTip="Klik untuk ganti Headset / Mouse">
                                <TextBlock Text="{Binding Battery.ActiveDisplayDevice.BatteryPercent, StringFormat={}{0}%}" 
                                           Foreground="{StaticResource TextPrimary}" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,6,0"/>

                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse Width="18" Height="18" Stroke="{StaticResource BatteryTrack}" StrokeThickness="2.5"/>
                                    <local:CircularProgress Width="18" Height="18" 
                                                            Stroke="{StaticResource BatteryGreen}" 
                                                            StrokeThickness="2.5" 
                                                            Percentage="{Binding Battery.ActiveDisplayDevice.BatteryPercent}"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Mode B: Pemutar Musik (Now Playing Mini Pill) -->
                        <Grid x:Name="CompactMusicView" Visibility="Collapsed" Opacity="0" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Album Art & Track Info -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactMusicLeft_Click" ToolTip="Klik untuk Buka Pemutar Musik">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="0.8">
                                    <Grid>
                                        <!-- Gradient / Note Icon Fallback -->
                                        <Border CornerRadius="4.5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FA2D48" Offset="0"/>
                                                    <GradientStop Color="#1C1022" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="🎵" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Real Album Art Image -->
                                        <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill" 
                                               Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Media.SongTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="85"/>
                                    <TextBlock Text="{Binding Media.ArtistName}" Foreground="{StaticResource TextSecondary}" FontSize="8" TextTrimming="CharacterEllipsis" MaxWidth="85" Margin="0,-1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Center: Camera Notch Reflection Dot -->
                            <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" Background="#25FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactCenterDot_Click" ToolTip="Klik untuk ganti mode (Baterai / Musik / Performa)">
                                <Ellipse Width="3" Height="3" Fill="#0E1726"/>
                            </Border>

                            <!-- Right: Dancing Equalizer Wave Bars -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="CompactMusicPlayPause_Click" ToolTip="Klik untuk Play / Pause">
                                <Rectangle x:Name="CompactEq1" Width="2.8" Height="6" Margin="1.2,0" RadiusX="1.4" RadiusY="1.4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#FA2D48" Offset="0"/>
                                            <GradientStop Color="#FF9F0A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="CompactEq2" Width="2.8" Height="12" Margin="1.2,0" RadiusX="1.4" RadiusY="1.4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#FA2D48" Offset="0"/>
                                            <GradientStop Color="#FF9F0A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="CompactEq3" Width="2.8" Height="8" Margin="1.2,0" RadiusX="1.4" RadiusY="1.4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#FA2D48" Offset="0"/>
                                            <GradientStop Color="#FF9F0A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="CompactEq4" Width="2.8" Height="14" Margin="1.2,0" RadiusX="1.4" RadiusY="1.4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#FA2D48" Offset="0"/>
                                            <GradientStop Color="#FF9F0A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </StackPanel>
                        </Grid>

                        <!-- Mode L: Lirik Lagu Realtime (Live Synced Lyrics Pill) -->
                        <Grid x:Name="CompactLyricsView" Visibility="Collapsed" Opacity="0" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Album Art / Lyrics Badge -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactLyrics_Click" ToolTip="Klik untuk Buka Lirik Penuh">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="0.8">
                                    <Grid>
                                        <Border CornerRadius="4.5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#BF5AF2" Offset="0"/>
                                                    <GradientStop Color="#00D2FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="🎤" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill" 
                                               Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Center: Current Realtime Synced Lyric Line -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Cursor="Hand" MouseLeftButtonDown="CompactLyrics_Click" ToolTip="Lirik Lagu Realtime (Klik untuk Buka Tab Lirik)">
                                <TextBlock x:Name="TxtCompactLyric"
                                           Text="{Binding Media.Lyrics.CurrentLyricDisplay}"
                                           Foreground="#FFFFFF"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#BF5AF2" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>

                            <!-- Right: Dancing Equalizer Wave Bars -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="CompactMusicPlayPause_Click" ToolTip="Klik untuk Play / Pause">
                                <Rectangle x:Name="CompactLyricsEq1" Width="2.8" Height="6" Margin="1.2,0" RadiusX="1.4" RadiusY="1.4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#BF5AF2" Offset="0"/>
                                            <GradientStop Color="#00D2FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="CompactLyricsEq2" Width="2.8" Height="12" Margin="1.2,0" RadiusX="1.4" RadiusY="1.4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#BF5AF2" Offset="0"/>
                                            <GradientStop Color="#00D2FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="CompactLyricsEq3" Width="2.8" Height="8" Margin="1.2,0" RadiusX="1.4" RadiusY="1.4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#BF5AF2" Offset="0"/>
                                            <GradientStop Color="#00D2FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="CompactLyricsEq4" Width="2.8" Height="14" Margin="1.2,0" RadiusX="1.4" RadiusY="1.4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#BF5AF2" Offset="0"/>
                                            <GradientStop Color="#00D2FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </StackPanel>
                        </Grid>

                        <!-- Mode C: Telemetri Performa Realtime (CPU, RAM, GPU) -->
                        <Grid x:Name="CompactPerfView" Visibility="Collapsed" Opacity="0" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: CPU Telemetry -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactPerf_Click" ToolTip="Klik untuk buka Performance Task Manager">
                                <TextBlock Text="{Binding Metrics.CpuPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#00D2FF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" MinWidth="26"/>
                                <TextBlock Text=" CPU" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center" Margin="2,1,0,0"/>
                            </StackPanel>

                            <!-- Center: RAM Telemetry -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactPerf_Click" ToolTip="Klik untuk buka Performance Task Manager">
                                <TextBlock Text="{Binding Metrics.RamPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#BF5AF2" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" MinWidth="26"/>
                                <TextBlock Text=" RAM" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center" Margin="2,1,0,0"/>
                            </StackPanel>

                            <!-- Right: GPU Telemetry -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactPerf_Click" ToolTip="Klik untuk buka Performance Task Manager">
                                <TextBlock Text="{Binding Metrics.GpuPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" MinWidth="26"/>
                                <TextBlock Text=" GPU" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center" Margin="2,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mode D & E: Jam, Siri Orb, Mic Indicator & Kucing Animasi (Matches media_1792501941831_ee2ccb5d.png) -->
                        <Grid x:Name="CompactClockMixerView" Visibility="Collapsed" Opacity="0" Margin="10,0" Cursor="Hand" MouseLeftButtonDown="CompactClock_Click" ToolTip="Audio &amp; Mic Center (Klik untuk buka Mixer)">

                            <!-- 1. Center Walking Track: Animated Dancing Nailong (Panel.ZIndex=10, in front of wave) -->
                            <Canvas x:Name="CatCanvas" Panel.ZIndex="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                                <!-- Floating Emote Bubble (Hidden) -->
                                <Border x:Name="CatEmoteBubble" Canvas.Left="60" Canvas.Top="0" 
                                        Background="#25FFFFFF" BorderBrush="#FF529A" BorderThickness="1" 
                                        CornerRadius="7" Padding="5,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="TxtCatEmote" Text="" FontSize="8.5" Foreground="#FF75A5" FontWeight="Bold"/>
                                </Border>

                                <!-- Animated Dancing Nailong Avatar (Cutout from User Upload) -->
                                <Grid x:Name="CatAvatar" Width="26" Height="28" Canvas.Left="60" Canvas.Top="1.5" 
                                      Cursor="Hand" MouseLeftButtonDown="CatAvatar_MouseDown" 
                                      ToolTip="🦖 Dinosaurus Nailong (Klik untuk ajak main!)" RenderTransformOrigin="0.5,0.9">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CatScaleTransform" ScaleX="1" ScaleY="1" CenterX="13" CenterY="26"/>
                                            <RotateTransform x:Name="CatWaddleRotate" Angle="0" CenterX="13" CenterY="26"/>
                                            <TranslateTransform x:Name="CatJumpTransform" X="0" Y="0"/>
                                            <ScaleTransform x:Name="DinoSquashTransform" ScaleX="1.0" ScaleY="1.0" CenterX="13" CenterY="26"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>

                                    <!-- Cutout Transparent Dancing Nailong Character -->
                                    <Image x:Name="CatAvatarImage" 
                                           Source="pack://application:,,,/DynamicIsland;component/Assets/nailong_dance/nailong_00.png" 
                                           Width="26" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Canvas>

                            <!-- 2. Overlay: Clock on Left, Siri Orb + Orange Mic Dot on Right -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Modern Digital Clock (e.g. 19:46) -->
                                <TextBlock Grid.Column="0" x:Name="TxtClockTime" Text="19:46"
                                           Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>

                                <!-- Right: Siri/AI Glowing Rainbow Orb & Orange Privacy Mic Dot -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Siri / AI Glowing Rainbow Orb -->
                                    <Grid x:Name="SiriOrbContainer" Width="20" Height="20" Cursor="Hand" MouseLeftButtonDown="SiriOrb_Click" ToolTip="Audio &amp; Mic Center (Klik untuk buka Mixer)" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="SiriOrbScale" ScaleX="1.0" ScaleY="1.0"/>
                                                <RotateTransform x:Name="SiriOrbRotate" Angle="0"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>

                                        <!-- Outer soft glow -->
                                        <Ellipse x:Name="SiriOrbGlow" Width="20" Height="20" Opacity="0.45">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#8A2BE2" Offset="0.0"/>
                                                    <GradientStop Color="#00FFFF" Offset="0.7"/>
                                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- Inner gradient orb -->
                                        <Ellipse x:Name="SiriOrbInner" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="SiriInnerRotate" Angle="0"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Fill>
                                                <LinearGradientBrush x:Name="SiriOrbBrush" StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#00D2FF" Offset="0.0"/>
                                                    <GradientStop Color="#BF5AF2" Offset="0.32"/>
                                                    <GradientStop Color="#FF2D55" Offset="0.68"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- Core highlight -->
                                        <Ellipse x:Name="SiriOrbCore" Width="6.5" Height="6.5" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                                    <GradientStop Color="#BF5AF2" Offset="0.6"/>
                                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Orange Microphone Indicator Dot (Matches media_1792501941831_ee2ccb5d.png) -->
                                    <Border x:Name="MicIndicatorDot" Width="7" Height="7" CornerRadius="3.5" Background="#FF9F0A"
                                            VerticalAlignment="Center" Margin="2,0,2,0"
                                            Visibility="{Binding Audio.IsMicInUse, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Audio.ActiveMicAppNames, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.95"/>
                                        </Border.Effect>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Bottom vibrant flowing rainbow wave (Layer 0: subtle glowing border accent at bottom, never touches Nailong) -->
                            <Grid Panel.ZIndex="0" VerticalAlignment="Bottom" Height="4" HorizontalAlignment="Stretch" Margin="6,0,6,0.5" IsHitTestVisible="False">
                                <Path x:Name="RainbowWavePath" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush x:Name="RainbowLineBrush" StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RainbowStop0" Color="#00D2FF" Offset="0.0"/>
                                            <GradientStop x:Name="RainbowStop1" Color="#7B42F6" Offset="0.25"/>
                                            <GradientStop x:Name="RainbowStop2" Color="#FF2D55" Offset="0.50"/>
                                            <GradientStop x:Name="RainbowStop3" Color="#FF9F0A" Offset="0.75"/>
                                            <GradientStop x:Name="RainbowStop4" Color="#00FFC6" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                    <Path.Effect>
                                        <DropShadowEffect x:Name="RainbowDropShadow" Color="#FF2D55" BlurRadius="3" ShadowDepth="0" Opacity="0.80"/>
                                    </Path.Effect>
                                </Path>
                            </Grid>
                        </Grid>
                        <!-- End of 1A. CompactHorizontalContainer -->
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 1B. VERTICAL SIDE COMPACT (DOCK LEFT / RIGHT)  -->
                        <!-- ============================================== -->
                        <Grid x:Name="CompactSideContainer" Visibility="Collapsed">
                            <!-- Side Mode C: Performa Realtime (CPU, RAM, GPU vertically stacked) -->
                            <Grid x:Name="SidePerfView" Visibility="Collapsed" Opacity="0" Margin="0,8" Cursor="Hand" MouseLeftButtonDown="CompactPerf_Click" ToolTip="Klik untuk buka Performance Task Manager">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- CPU Slot -->
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="CPU" Foreground="#00D2FF" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Metrics.CpuPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#00D2FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- RAM Slot -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="RAM" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Metrics.RamPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#BF5AF2" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- GPU Slot -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="GPU" Foreground="{StaticResource BatteryGreen}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Metrics.GpuPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode A: Battery (Device Icon + Circular Progress + %) -->
                            <Grid x:Name="SideBatteryView" Visibility="Visible" Opacity="1" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="ToggleDeviceIcon_Click" ToolTip="Klik untuk ganti Headset / Mouse">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="20" Height="15" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Path Data="M 5,2 C 8,2 9,5 8,9 L 8,16 C 8,17 7,18 6,18 C 5,18 4,17 4,16 L 4,10 C 2.5,9 2,6 3,4 Z" Fill="#FFFFFF" Margin="0,0,7,0"/>
                                        <Path Data="M 15,2 C 12,2 11,5 12,9 L 12,16 C 12,17 13,18 14,18 C 15,18 16,17 16,16 L 16,10 C 17.5,9 18,6 17,4 Z" Fill="#FFFFFF" Margin="7,0,0,0"/>
                                    </Grid>

                                    <Grid Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Ellipse Width="22" Height="22" Stroke="{StaticResource BatteryTrack}" StrokeThickness="2.5"/>
                                        <local:CircularProgress Width="22" Height="22" 
                                                                Stroke="{StaticResource BatteryGreen}" 
                                                                StrokeThickness="2.5" 
                                                                Percentage="{Binding Battery.ActiveDisplayDevice.BatteryPercent}"
                                                                StrokeStartLineCap="Round"
                                                                StrokeEndLineCap="Round"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Battery.ActiveDisplayDevice.BatteryPercent, StringFormat={}{0}%}" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               FontWeight="Bold" 
                                               FontSize="9.5" 
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode B: Pemutar Musik (Art + Mini Waves + Controls) -->
                            <Grid x:Name="SideMusicView" Visibility="Collapsed" Opacity="0" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="CompactMusicLeft_Click" ToolTip="Klik untuk Buka Pemutar Musik">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="0.8" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Grid>
                                            <Border CornerRadius="4.5">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FA2D48" Offset="0"/>
                                                        <GradientStop Color="#1C1022" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="🎵" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill" 
                                                   Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="14" Margin="0,0,0,6">
                                        <Rectangle x:Name="SideEq1" Width="2.2" Height="5" Margin="1,0" RadiusX="1" RadiusY="1">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#FA2D48" Offset="0"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle x:Name="SideEq2" Width="2.2" Height="11" Margin="1,0" RadiusX="1" RadiusY="1">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#FA2D48" Offset="0"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle x:Name="SideEq3" Width="2.2" Height="8" Margin="1,0" RadiusX="1" RadiusY="1">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#FA2D48" Offset="0"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </StackPanel>

                                    <TextBlock Text="▶" Foreground="{StaticResource TextSecondary}" FontSize="8.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode: Lirik Lagu Realtime -->
                            <Grid x:Name="SideLyricsView" Visibility="Collapsed" Opacity="0" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="CompactLyrics_Click" ToolTip="Klik untuk Buka Lirik Penuh">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="0.8" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Grid>
                                            <Border CornerRadius="4.5">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#BF5AF2" Offset="0"/>
                                                        <GradientStop Color="#00D2FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="🎤" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill" 
                                                   Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="LIRIK" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode D: Kucing Animasi di Tepi Layar -->
                            <Grid x:Name="SideCatView" Visibility="Collapsed" Opacity="0" ClipToBounds="True">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border x:Name="SideCatEmoteBubble" Background="#25FFFFFF" BorderBrush="#FF529A" BorderThickness="1" 
                                            CornerRadius="6" Padding="4,1" Margin="0,0,0,6" Opacity="0" HorizontalAlignment="Center">
                                        <TextBlock Text="❤️" FontSize="8" Foreground="#FF75A5" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Side Mode Animated Nailong Avatar -->
                                    <Grid x:Name="SideCatAvatar" Width="26" Height="30" Cursor="Hand" MouseLeftButtonDown="CatAvatar_MouseDown" ToolTip="🦖 Dinosaurus Nailong (Klik untuk ajak main!)" RenderTransformOrigin="0.5,0.9">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="SideCatScale" ScaleX="1" ScaleY="1" CenterX="13" CenterY="27"/>
                                                <RotateTransform x:Name="SideCatRotate" Angle="0" CenterX="13" CenterY="27"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Image x:Name="SideCatAvatarImage" 
                                               Source="pack://application:,,,/DynamicIsland;component/Assets/nailong_dance/nailong_00.png" 
                                               Width="26" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode E: Jam & Indikator Audio/Mic -->
                            <Grid x:Name="SideClockView" Visibility="Collapsed" Opacity="0" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="CompactClock_Click" ToolTip="Audio &amp; Mic Center (Klik untuk buka Mixer)">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtSideClockTime" Text="19:46" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <!-- Siri Orb -->
                                    <Grid Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#00D2FF" Offset="0.0"/>
                                                    <GradientStop Color="#BF5AF2" Offset="0.32"/>
                                                    <GradientStop Color="#FF2D55" Offset="0.68"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFFFFF" Opacity="0.8"/>
                                    </Grid>
                                    <!-- Mic Dot if in use -->
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#FF9F0A" HorizontalAlignment="Center"
                                            Visibility="{Binding Audio.IsMicInUse, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Audio.ActiveMicAppNames, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF9F0A" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                                        </Border.Effect>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>





                <!-- ============================================== -->
                <!-- 1.5 NOTIFICATION BANNER (DISCORD / STEAM / APP) -->
                <!-- ============================================== -->
                <Grid x:Name="NotificationBannerView" Visibility="Collapsed" Opacity="0" Margin="10,0" Cursor="Hand" MouseLeftButtonDown="NotificationBanner_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon / Badge -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" x:Name="NotifIconBadge" Background="#5865F2" VerticalAlignment="Center" Margin="0,0,9,0">
                        <TextBlock x:Name="TxtNotifIcon" Text="💬" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Title & Message Text -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtNotifTitle" Text="Discord" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtNotifSubtitle" Text=" • Pesan Masuk" Foreground="#8E8E93" FontSize="9.5" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtNotifBody" Text="hey bro login CS2 let's play premier!" Foreground="#C7C7CC" FontSize="10" MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Actions: Dismiss Button -->
                    <Border Grid.Column="2" Width="20" Height="20" CornerRadius="10" Background="#25FFFFFF" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BtnDismissNotif_Click" ToolTip="Tutup Notifikasi">
                        <TextBlock Text="✕" FontSize="9" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                </Grid>

                <!-- ============================================== -->
                <!-- PONI HUD: VOLUME & BRIGHTNESS ON-SCREEN BANNER -->
                <!-- ============================================== -->
                <Border x:Name="HudBanner" Visibility="Collapsed" Opacity="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14"
                        Padding="14,4" Height="28" Margin="0,0,0,0">
                    <Grid Width="160">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtHudIcon" Grid.Column="0" Text="🔊" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#25FFFFFF" VerticalAlignment="Center">
                            <ProgressBar x:Name="BarHudLevel" Height="5" BorderThickness="0" Background="Transparent" Value="50" Maximum="100" Foreground="#0A84FF"/>
                        </Border>
                        <TextBlock x:Name="TxtHudPercent" Grid.Column="2" Text="50%" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>


                <!-- ============================================== -->
                <!-- 2. EXPANDED NOTCH WITH ALL PREVIOUS MENUS      -->
                <!-- ============================================== -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0" Margin="16,2,16,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Top Header Strip -->
                        <RowDefinition Height="*" />    <!-- Content Body -->
                    </Grid.RowDefinitions>

                    <!-- Top Sub-Bar (Matches Poni Reference: 🏠 🎛️ 📦 ⊞ 💬 🔊 ⛅ ❤️ ⏳ 📋 ⚡ 🛡️ 🛠️ + Clock + Refresh + Battery + Pin) -->
                    <Grid x:Name="TopHeaderGrid" Grid.Row="0" Margin="0,0,0,3" PreviewMouseWheel="TopHeaderGrid_PreviewMouseWheel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Navigation Tabs (Poni Suite Exact Order in Pill Container) -->
                        <ScrollViewer x:Name="TabsScrollViewer" Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="TabsScrollViewer_PreviewMouseWheel">
                            <Border x:Name="TabsBorder" Background="#221A2838" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="10" Padding="3,2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnHome" Style="{StaticResource HeaderIconBtn}" Click="BtnHome_Click" ToolTip="Home (Musik &amp; Kalender)">
                                        <Path Stretch="Uniform" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M10,20v-6h4v6h5v-8h3L12,3 2,12h3v8z" />
                                    </Button>
                                    <Button x:Name="BtnLyrics" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnLyrics_Click" ToolTip="Lirik Lagu (Synced Lyrics)">
                                        <Path Stretch="Uniform" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z" />
                                    </Button>
                                    <Button x:Name="BtnNook" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnNook_Click" ToolTip="Control Center (Quick Toggles &amp; Apps)">
                                        <Path Stretch="Uniform" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3,17v2h6v-2H3zM3,5v2h10V5H3zm10,16v-2h8v-2h-8v-2h-2v6h2zM7,9v2H3v2h4v2h2V9H7zm14,4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
                                    </Button>
                                    <Button x:Name="BtnShelf" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnShelf_Click" ToolTip="Shelf &amp; AirDrop">
                                        <Path Stretch="Uniform" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M19,3H5c-1.1,0-2,0.9-2,2v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5c0-1.1-0.9-2-2-2zm0,16H5v-3h3.56c0.69,1.19,1.97,2,3.44,2s2.75-0.81,3.44-2H19v3zm0-5h-4.18c-0.41,0.58-1.07,1-1.82,1s-1.41-0.42-1.82-1H5V5h14v9z" />
                                    </Button>
                                    <Button x:Name="BtnTaskbar" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnTaskbar_Click" ToolTip="Startbar &amp; Apps">
                                        <Path Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3,3h7v7H3V3zm9,0h7v7h-7V3zM3,12h7v7H3v-7zm9,0h7v7h-7v-7z" />
                                    </Button>
                                    <Button x:Name="BtnTodo" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnTodo_Click" ToolTip="Notes">
                                        <Path Stretch="Uniform" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M20,2H4c-1.1,0-2,0.9-2,2v18l4-4h14c1.1,0,2-0.9,2-2V4c0-1.1-0.9-2-2-2zm0,14H6l-2,2V4h16v12z" />
                                    </Button>
                                    <Button x:Name="BtnMixerTab" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnMixerTab_Click" ToolTip="Audio Mixer">
                                        <Path Stretch="Uniform" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3,9v6h4l5,5V4L7,9H3zm13.5,3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-0.73,2.5-2.25,2.5-4.02zM14,3.23v2.06c2.89,0.86,5,3.54,5,6.71s-2.11,5.85-5,6.71v2.06c4.01-0.91,7-4.49,7-8.77s-2.99-7.86-7-8.77z" />
                                    </Button>
                                    <Button x:Name="BtnWeather" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnWeather_Click" ToolTip="Weather">
                                        <Path Stretch="Uniform" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M19.35,10.04C18.67,6.59,15.64,4,12,4c-3.72,0-6.84,2.56-7.65,6.04C1.84,10.61,0,12.8,0,15.5 0,18.54,2.46,21,5.5,21h13c2.48,0,4.5-2.02,4.5-4.5 0-2.3-1.73-4.18-3.95-4.46z" />
                                    </Button>
                                    <Button x:Name="BtnHealth" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnHealth_Click" ToolTip="Health">
                                        <Path Stretch="Uniform" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12,21.35l-1.45-1.32C5.4,15.36,2,12.28,2,8.5,2,5.42,4.42,3,7.5,3c1.74,0,3.41,0.81,4.5,2.09C13.09,3.81,14.76,3,16.5,3,19.58,3,22,5.42,22,8.5c0,3.78-3.4,6.86-8.55,11.54L12,21.35z" />
                                    </Button>
                                    <Button x:Name="BtnScreenTime" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnScreenTime_Click" ToolTip="Screen Time">
                                        <Path Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6,2v6h.01L6,8.01 10,12l-4,4 .01.01H6V22h12v-5.99h-.01L18,16l-4-4 4-3.99-.01-.01H18V2H6zm10,14.5V20H8v-3.5l4-4 4,4zM12,11.5L8,7.5V4h8v3.5l-4,4z" />
                                    </Button>
                                    <Button x:Name="BtnClipboard" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnClipboard_Click" ToolTip="Clipboard">
                                        <Path Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M19,3h-4.18C14.4,1.84,13.3,1,12,1c-1.3,0-2.4,0.84-2.82,2H5c-1.1,0-2,0.9-2,2v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5c0-1.1-0.9-2-2-2zm-7,0c0.55,0,1,0.45,1,1s-0.45,1-1,1-1-0.45-1-1 0.45-1 1-1zm7,16H5V5h2v3h10V5h2v14z" />
                                    </Button>
                                    <Button x:Name="BtnPerf" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnPerf_Click" ToolTip="Telemetry">
                                        <Path Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M7,2v11h3v9l7-12h-4l4-8z" />
                                    </Button>
                                    <Button x:Name="BtnGameMode" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnGameMode_Click" ToolTip="Game Mode">
                                        <Path Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12 5.16-1.26,9-6.45,9-12V5l-9-4zm0,10.99h7c-.53,4.12-3.28,7.79-7,8.94V12H5V6.3l7-3.11v8.8z" />
                                    </Button>
                                    <Button x:Name="BtnTools" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnTools_Click" ToolTip="Tools">
                                        <Path Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M22.7,19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9,6 6,9 1.6,4.7C.4,7.1.9,10.1 2.9,12.1c1.9,1.9,4.6,2.4,6.9,1.5l9.1,9.1c.4.4,1,.4,1.4,0l2.3-2.3c.5-.4.5-1.1.1-1.4z" />
                                    </Button>

                                    <!-- Secondary views preserved for shortcuts and full functionality -->
                                    <Button x:Name="BtnTimer" Style="{StaticResource HeaderIconBtn}" Margin="2,0,0,0" Click="BtnTimer_Click" ToolTip="Pomodoro &amp; Stand (@weldraws_)"><Path Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M15,1H9v2h6V1zm-4,13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42,1.42C16.07,4.74,14.12,4,12,4c-4.97,0-9,4.03-9,9s4.02,9,9,9 9-4.03,9-9c0-2.12-.74-4.07-1.97-5.61zM12,20c-3.87,0-7-3.13-7-7s3.13-7,7-7 7,3.13,7,7-3.13,7-7,7z"/></Button>
                                    <Button x:Name="BtnSettingsTab" Visibility="Collapsed" Click="BtnSettingsTab_Click"/>
                                    <Button x:Name="BtnBattery" Visibility="Collapsed" Click="BtnBattery_Click"/>
                                    <Button x:Name="BtnMusic" Visibility="Collapsed" Click="BtnMusic_Click"/>
                                    <Button x:Name="BtnAgenda" Visibility="Collapsed" Click="BtnAgenda_Click"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Right: Clock/Date, Refresh, Battery, Location/Pin (Matches Poni Screenshot) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Digital Clock & Date (Matches Poni '1:33 PM  Mon, Oct 26') -->
                            <TextBlock Text="{Binding Metrics.HeaderTimeFormatted, FallbackValue='1:33 PM'}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Metrics.HeaderDateFormatted, FallbackValue='Mon, Oct 26'}" Foreground="#8E8E93" FontSize="11" Margin="5,0,8,0" VerticalAlignment="Center"/>

                            <!-- Refresh / Sync Button -->
                            <Button Style="{StaticResource GhostBtn}" Padding="3,2" Margin="1,0" Click="BtnQuickSync_Click" ToolTip="Refresh">
                                <Path Stretch="Uniform" Width="11" Height="11" Fill="#FFFFFF" Opacity="0.85" Data="M17.65,6.35C16.2,4.9,14.21,4,12,4c-4.42,0-7.99,3.58-7.99,8s3.57,8,7.99,8c3.73,0,6.84-2.55,7.73-6h-2.08c-.82,2.33-3.04,4-5.65,4-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14.69,4.22,1.78L13,11h7V4l-2.35,2.35z"/>
                            </Button>

                            <!-- Orange Battery Badge -->
                            <Border Background="#FF9500" CornerRadius="4" Padding="3,2" Margin="3,0" ToolTip="Baterai">
                                <Path Stretch="Uniform" Width="8" Height="10" Fill="#000000" Data="M15.67,4H14V2h-4v2H8.33C7.6,4,7,4.6,7,5.33v15.33C7,21.4,7.6,22,8.33,22h7.33c.74,0,1.34-.6,1.34-1.33V5.33C17,4.6,16.4,4,15.67,4z"/>
                            </Border>

                            <!-- Location / Pin Toggle -->
                            <Button x:Name="PinButton" Style="{StaticResource GhostBtn}" Padding="3,2" Margin="2,0,0,0" Click="PinButton_Click" ToolTip="Pin Window">
                                <TextBlock x:Name="PinIcon" Text="📍" FontSize="9.5" Foreground="#FFFFFF" Opacity="0.85"/>
                            </Button>

                            <!-- Collapse Button -->
                            <Button Style="{StaticResource GhostBtn}" Padding="3,2" Margin="2,0,0,0" Click="CollapseButton_Click" ToolTip="Tutup ke Notch">
                                <Path Stretch="Uniform" Width="8" Height="8" Fill="#8E8E93" Data="M7.41,15.41L12,10.83l4.59,4.58L18,14l-6-6-6,6z"/>
                            </Button>
                        </StackPanel>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- SCROLLABLE CONTENT BODY (Fits smaller island)  -->
                    <!-- ============================================== -->
                    <ScrollViewer x:Name="ContentScrollViewer" 
                                  Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  PreviewMouseWheel="ContentScrollViewer_PreviewMouseWheel"
                                  Focusable="False">
                        <Grid>
                            <!-- VIEW 0: HOME / MUSIC + CALENDAR + MIRROR (PONI SCREENSHOT 1) -->
                            <Grid x:Name="ViewHome" Visibility="Visible" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" /> <!-- Col 0: Music Player Card -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="220" /> <!-- Col 1: Calendar / Agenda Card -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="*" />   <!-- Col 2: Mirror / Camera Quick Launch -->
                                </Grid.ColumnDefinitions>

                                <!-- COL 0: MUSIC PLAYER CARD -->
                                <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Album Box + Song / Artist -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Album Art Box -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#2AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0">
                                                <Grid>
                                                    <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill"
                                                           Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                                    <Path Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"
                                                          Stretch="Uniform" Width="18" Height="18" Fill="#8E8E93"
                                                          Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVisInverted}}"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Media.SongTitle, TargetNullValue='Nothing playing', FallbackValue='Nothing playing'}" 
                                                           Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Media.ArtistName, TargetNullValue='Play something in Spotify, YouTube, Apple...', FallbackValue='Play something in Spotify, YouTube, Apple...'}" 
                                                           Foreground="#8E8E93" FontSize="8.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Middle Row: Seeker Slider -->
                                        <Grid Grid.Row="1" Margin="0,6,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Media.CurrentPosition, FallbackValue='0:00'}" Foreground="#9CA3AF" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <Slider x:Name="SliderMediaSeek" Grid.Column="1" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="100" 
                                                    Value="{Binding Media.TimelineProgress, Mode=OneWay}" 
                                                    PreviewMouseDown="SliderMediaSeek_PreviewMouseDown"
                                                    PreviewMouseUp="SliderMediaSeek_PreviewMouseUp"
                                                    Height="16" VerticalAlignment="Center" Cursor="Hand"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Media.TotalDuration, FallbackValue='-0:00'}" Foreground="#9CA3AF" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>

                                        <!-- Bottom Row: Transport Buttons & Lyrics Toggle -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <Button Style="{StaticResource GhostBtn}" Padding="6,3" Click="MediaPrev_Click" ToolTip="Sebelumnya">
                                                <Path Stretch="Uniform" Width="10" Height="10" Fill="#FFFFFF" Data="M6,6h2v12H6zm3.5,6l8.5,6V6z"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostBtn}" Padding="10,3" Margin="8,0" Click="MediaPlayPause_Click" ToolTip="Putar / Jeda">
                                                <Grid>
                                                    <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" Data="M8,5v14l11-7z"
                                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisInverted}}"/>
                                                    <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" Data="M6,19h4V5H6v14zm8-14v14h4V5h-4z"
                                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource GhostBtn}" Padding="6,3" Click="MediaNext_Click" ToolTip="Berikutnya">
                                                <Path Stretch="Uniform" Width="10" Height="10" Fill="#FFFFFF" Data="M6,18l8.5-6L6,6v12zM16,6v12h2V6h-2z"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostBtn}" Padding="6,3" Margin="8,0,0,0" Click="BtnLyrics_Click" ToolTip="Lirik Lagu (Synced Lyrics)">
                                                <Path Stretch="Uniform" Width="10" Height="10" Fill="#38BDF8" Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Row 3: Realtime Karaoke Lyric Line Preview -->
                                        <Border Grid.Row="3" Background="#25FFFFFF" CornerRadius="6" Padding="6,3" Margin="0,4,0,0"
                                                Cursor="Hand" MouseLeftButtonDown="KaraokePreview_Click" ToolTip="Klik untuk buka Tampilan Lirik Penuh">
                                            <Grid>
                                                <ProgressBar Height="2" Minimum="0" Maximum="100" 
                                                             Value="{Binding Media.Lyrics.CurrentLineProgress, Mode=OneWay}"
                                                             VerticalAlignment="Bottom" BorderThickness="0" Background="Transparent" Foreground="#38BDF8" Opacity="0.85"/>
                                                <TextBlock Text="{Binding Media.Lyrics.CurrentLyricText, FallbackValue='♪'}" 
                                                           Foreground="#60A5FA" FontSize="8" FontWeight="SemiBold" 
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"
                                                           Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Media.Lyrics.StatusMessage, FallbackValue='Lirik Lagu'}" 
                                                           Foreground="#6B7280" FontSize="8"
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"
                                                           Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVisInverted}}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Rectangle Grid.Column="1" Fill="#25FFFFFF" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COL 1: CALENDAR / AGENDA CARD -->
                                <Border Grid.Column="2" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="6,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Month Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="October 2026" Foreground="#FFFFFF" FontSize="9.5" FontWeight="Bold"/>
                                            <Button Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Padding="2" Click="BtnAddEvent_Click" ToolTip="Tambah Agenda">
                                                <TextBlock Text="+" FontSize="11" Foreground="#8E8E93"/>
                                            </Button>
                                        </Grid>

                                        <!-- Days of Week Row -->
                                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,2,0,2">
                                            <TextBlock Text="Mo" Foreground="#8E8E93" FontSize="7.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Tu" Foreground="#8E8E93" FontSize="7.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="We" Foreground="#8E8E93" FontSize="7.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Th" Foreground="#8E8E93" FontSize="7.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Fr" Foreground="#8E8E93" FontSize="7.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Sa" Foreground="#8E8E93" FontSize="7.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Su" Foreground="#8E8E93" FontSize="7.5" HorizontalAlignment="Center"/>
                                        </UniformGrid>

                                        <!-- Dates Row -->
                                        <UniformGrid Grid.Row="2" Columns="7" Margin="0,2,0,4">
                                            <TextBlock Text="26" Foreground="#FF453A" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="27" Foreground="#C7C7CC" FontSize="8.5" HorizontalAlignment="Center"/>
                                            <Border Background="#25FFFFFF" CornerRadius="4" Padding="2,1">
                                                <TextBlock Text="28" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="29" Foreground="#C7C7CC" FontSize="8.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="30" Foreground="#C7C7CC" FontSize="8.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="31" Foreground="#C7C7CC" FontSize="8.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="1" Foreground="#8E8E93" FontSize="8.5" HorizontalAlignment="Center"/>
                                        </UniformGrid>

                                        <!-- Event Subtext & Connect Link -->
                                        <StackPanel Grid.Row="3" Margin="0,2,0,0">
                                            <TextBlock Text="No new event yet" Foreground="#8E8E93" FontSize="8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Connect Google / Outlook calendar" Foreground="#0A84FF" FontSize="7.5" HorizontalAlignment="Center" Cursor="Hand" Margin="0,2,0,0" MouseLeftButtonDown="BtnConnectCalendar_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Rectangle Grid.Column="3" Fill="#25FFFFFF" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COL 2: MIRROR QUICK LAUNCH CARD -->
                                <Border Grid.Column="4" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8" Margin="6,0,0,0">
                                    <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchCamera_Click" ToolTip="Buka Kamera / Mirror" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="12" Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                                                <Path Stretch="Uniform" Width="18" Height="18" Fill="#FFFFFF" Data="M18,10.48V6c0-1.1-.9-2-2-2H4c-1.1,0-2,.9-2,2v12c0,1.1.9,2,2,2h12c1.1,0,2-.9,2-2v-4.48l4,3.98v-11l-4,3.5z"/>
                                            </Border>
                                            <TextBlock Text="Mirror" Foreground="#C7C7CC" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>

                            <!-- VIEW LYRICS: REALTIME SYNCED LYRICS (APPLE MUSIC STYLE) -->
                            <Grid x:Name="ViewLyrics" Visibility="Collapsed" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" /> <!-- Col 0: Now Playing Left Card -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="*" />   <!-- Col 1: Realtime Synced Lyrics Scroller -->
                                </Grid.ColumnDefinitions>

                                <!-- Col 0: Now Playing Left Card -->
                                <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Song Art + Title -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#2AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0">
                                                <Grid>
                                                    <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill"
                                                           Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                                    <Path Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"
                                                          Stretch="Uniform" Width="18" Height="18" Fill="#8E8E93"
                                                          Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVisInverted}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Media.SongTitle, TargetNullValue='Nothing playing', FallbackValue='Nothing playing'}" 
                                                           Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Media.ArtistName, TargetNullValue='Play something...', FallbackValue='Play something...'}" 
                                                           Foreground="#8E8E93" FontSize="8.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Progress bar -->
                                        <Grid Grid.Row="1" Margin="0,8,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Media.CurrentPosition, FallbackValue='0:00'}" Foreground="#9CA3AF" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <Slider Style="{StaticResource AppleSlider}" Grid.Column="1" Minimum="0" Maximum="100" 
                                                    Value="{Binding Media.TimelineProgress, Mode=OneWay}" 
                                                    PreviewMouseDown="SliderMediaSeek_PreviewMouseDown"
                                                    PreviewMouseUp="SliderMediaSeek_PreviewMouseUp"
                                                    Height="16" VerticalAlignment="Center" Cursor="Hand"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Media.TotalDuration, FallbackValue='-0:00'}" Foreground="#9CA3AF" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>

                                        <!-- Transport Buttons -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource GhostBtn}" Padding="6,3" Click="MediaPrev_Click" ToolTip="Sebelumnya">
                                                <Path Stretch="Uniform" Width="10" Height="10" Fill="#FFFFFF" Data="M6,6h2v12H6zm3.5,6l8.5,6V6z"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostBtn}" Padding="10,3" Margin="8,0" Click="MediaPlayPause_Click" ToolTip="Putar / Jeda">
                                                <Grid>
                                                    <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" Data="M8,5v14l11-7z"
                                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisInverted}}"/>
                                                    <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" Data="M6,19h4V5H6v14zm8-14v14h4V5h-4z"
                                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource GhostBtn}" Padding="6,3" Click="MediaNext_Click" ToolTip="Berikutnya">
                                                <Path Stretch="Uniform" Width="10" Height="10" Fill="#FFFFFF" Data="M6,18l8.5-6L6,6v12zM16,6v12h2V6h-2z"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostBtn}" Padding="6,3" Margin="8,0,0,0" Click="BtnRetryLyrics_Click" ToolTip="Muat Ulang Lirik">
                                                <TextBlock Text="🔄" FontSize="10" Foreground="#8E8E93"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Rectangle Grid.Column="1" Fill="#25FFFFFF" Width="1" Height="118" VerticalAlignment="Center"/>

                                <!-- Col 2: Apple Music-Style Synced Lyrics Scroller -->
                                <Border Grid.Column="2" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Status Bar in Lyrics Card -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="10" Height="10" Fill="#38BDF8" Margin="0,0,5,0" Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"/>
                                                <TextBlock Text="LIRIK LAGU" Foreground="#8E8E93" FontSize="8.5" FontWeight="Bold"/>
                                                <Border Background="#25FFFFFF" CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                                        Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="SYNCED" Foreground="#38BDF8" FontSize="7.5" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#25FFFFFF" CornerRadius="4" Padding="4,1" Margin="4,0,0,0"
                                                        Visibility="{Binding Media.Lyrics.IsAppleMusicSource, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="APPLE MUSIC" Foreground="#C084FC" FontSize="7.5" FontWeight="Bold"/>
                                                </Border>

                                                <!-- Quick Realtime Sync Calibration Offset -->
                                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource GhostBtn}" Padding="3,1" Click="BtnOffsetMinusLarge_Click" ToolTip="Tunda lirik 2 detik (Gunakan jika lirik LEBIH CEPAT dari lagu)">
                                                        <TextBlock Text="◀ -2s" FontSize="7.5" Foreground="#94A3B8"/>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostBtn}" Padding="3,1" Click="BtnOffsetMinusSmall_Click" ToolTip="Tunda lirik 0.5 detik (Gunakan jika lirik sedikit lebih cepat)">
                                                        <TextBlock Text="-0.5s" FontSize="7.5" Foreground="#94A3B8"/>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostBtn}" Padding="4,1" Margin="2,0" Click="BtnOffsetReset_Click" ToolTip="Klik untuk Reset Offset ke 0.0s (Default)">
                                                        <Border Background="#25FFFFFF" CornerRadius="3" Padding="4,1">
                                                            <TextBlock Text="{Binding Media.Lyrics.OffsetFormatted}" Foreground="#38BDF8" FontSize="7.5" FontWeight="Bold"/>
                                                        </Border>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostBtn}" Padding="3,1" Click="BtnOffsetPlusSmall_Click" ToolTip="Percepat lirik 0.5 detik (Gunakan jika lirik terlambat)">
                                                        <TextBlock Text="+0.5s" FontSize="7.5" Foreground="#94A3B8"/>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostBtn}" Padding="3,1" Click="BtnOffsetPlusLarge_Click" ToolTip="Percepat lirik 2 detik (Gunakan jika lirik terlambat)">
                                                        <TextBlock Text="+2s ▶" FontSize="7.5" Foreground="#94A3B8"/>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource GhostBtn}" Padding="4,2" Click="BtnRetryLyrics_Click" ToolTip="Muat Ulang Lirik">
                                                    <TextBlock Text="↻" FontSize="11" Foreground="#9CA3AF"/>
                                                </Button>
                                                <Button Style="{StaticResource GhostBtn}" Padding="4,2" Margin="4,0,0,0" Click="BtnHome_Click" ToolTip="Tutup Lirik">
                                                    <TextBlock Text="✕" FontSize="10" Foreground="#9CA3AF"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Lyrics Content Area -->
                                        <Grid Grid.Row="1">
                                            <!-- State 1: Synced Lyrics Active (Scrollable) -->
                                            <ScrollViewer x:Name="LyricsScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                          Height="124" PanningMode="VerticalOnly" PreviewMouseWheel="LyricsScrollViewer_PreviewMouseWheel"
                                                          Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}">
                                                <ScrollViewer.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0.0"/>
                                                        <GradientStop Color="#FF000000" Offset="0.05"/>
                                                        <GradientStop Color="#FF000000" Offset="0.95"/>
                                                        <GradientStop Color="#00000000" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </ScrollViewer.OpacityMask>
                                                <ItemsControl x:Name="LyricsItemsControl" ItemsSource="{Binding Media.Lyrics.Lines}" Margin="0,38,0,50">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource GhostBtn}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                    Padding="8,3" Margin="0,1" Click="LyricLine_Click" Cursor="Hand">
                                                                <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Stretch">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Background" Value="#1C2D4A"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Grid Grid.Row="0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding TimestampFormatted}" FontSize="7.5" Width="26" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="#475569"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                                        <Setter Property="FontSize" Value="10"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                                <Setter Property="FontSize" Value="11.5"/>
                                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#475569"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Padding="4,1" Margin="4,0,0,0"
                                                                                    Click="BtnSyncThisLine_Click" ToolTip="⚡ Selaraskan pemutar tepat ke baris ini">
                                                                                <TextBlock Text="⚡" FontSize="8" Foreground="#38BDF8" Opacity="0.75"/>
                                                                            </Button>
                                                                        </Grid>

                                                                        <!-- Realtime Karaoke line progress highlight -->
                                                                        <ProgressBar Grid.Row="1" Height="2" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                                                     BorderThickness="0" Background="Transparent" Foreground="#38BDF8" Margin="0,3,0,0">
                                                                            <ProgressBar.Style>
                                                                                <Style TargetType="ProgressBar">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ProgressBar.Style>
                                                                        </ProgressBar>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- State 2: Loading State -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding Media.Lyrics.IsLoading, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="⏳" FontSize="14" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Media.Lyrics.StatusMessage, FallbackValue='Memuat lirik...'}" 
                                                           Foreground="#94A3B8" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- State 3: No Lyrics Available -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Media.Lyrics.HasLyrics}" Value="False"/>
                                                                    <Condition Binding="{Binding Media.Lyrics.IsLoading}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="♪" FontSize="18" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Media.Lyrics.StatusMessage, FallbackValue='Lirik tidak ditemukan'}" 
                                                           Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,4"/>
                                                <Button Content="Coba Cari Lagi" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#38BDF8"
                                                        FontSize="8" Padding="8,2" HorizontalAlignment="Center" Click="BtnRetryLyrics_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- VIEW 1: NOOK 4-COLUMN CONTROL CENTER DASHBOARD (THREADS / ATOLL REFERENCE) -->
                            <Grid x:Name="ViewNook" Visibility="Collapsed" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" /> <!-- Col 0: Weather & Prayer Card -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="156" /> <!-- Col 1: Quick Toggles (Capsules + Buttons) -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="230" /> <!-- Col 2: Apps Grid (2x3 Quick Launch) -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="136" /> <!-- Col 3: Day Progress Card -->
                                </Grid.ColumnDefinitions>

                                <!-- COLUMN 0: WEATHER CARD (Screenshot 2: Jakarta 32° Light Drizzle) -->
                                <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,4,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Location Pin + JAKARTA -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Path Stretch="Uniform" Width="7" Height="9" Fill="#8E8E93" Margin="0,0,3,0" Data="M16,12V4h1V2H7v2h1v8l-2,2v2h5v6l1,1 1-1v-6h5v-2l-2-2z"/>
                                            <TextBlock Text="JAKARTA" Foreground="#8E8E93" FontSize="8" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Rain Cloud Icon + 32° -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,2">
                                            <Path Stretch="Uniform" Width="20" Height="18" Fill="#FFFFFF" Margin="0,0,6,0" Data="M19.35,10.04C18.67,6.59,15.64,4,12,4c-3.72,0-6.84,2.56-7.65,6.04C1.84,10.61,0,12.8,0,15.5 0,18.54,2.46,21,5.5,21h13c2.48,0,4.5-2.02,4.5-4.5 0-2.3-1.73-4.18-3.95-4.46z"/>
                                            <TextBlock Text="{Binding Metrics.WeatherTemp, FallbackValue='32°'}" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Weather Condition: Light Drizzle -->
                                        <TextBlock Grid.Row="2" Text="{Binding Metrics.WeatherCondition, FallbackValue='Light drizzle'}" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                        <!-- High / Low -->
                                        <TextBlock Grid.Row="3" Text="{Binding Metrics.WeatherHighLow, FallbackValue='H: 33° · L: 26°'}" Foreground="#8E8E93" FontSize="8" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>

                                <Rectangle Grid.Column="1" Fill="#25FFFFFF" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COLUMN 1: QUICK TOGGLES (Screenshot 2: 8 Capsule Pills) -->
                                <Grid Grid.Column="2" Margin="5,0,4,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <TextBlock Grid.Row="0" Text="✦ QUICK TOGGLES" Foreground="#8E8E93" FontSize="8" FontWeight="Bold" Margin="2,0,0,4"/>

                                    <!-- Row 1: 4 Vertical Capsule Pills -->
                                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,4">
                                        <!-- Wi-Fi Toggle Capsule -->
                                        <Button x:Name="BtnToggleWifi" Style="{StaticResource GhostBtn}" Click="BtnToggleWifi_Click" ToolTip="Wi-Fi" Margin="1.5,0">
                                            <Border x:Name="PillWifi" Width="28" Height="36" CornerRadius="14" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12,4C7.31,4,3.07,5.9,0,8.98L12,21l12-12.02C20.93,5.9,16.69,4,12,4z"/>
                                            </Border>
                                        </Button>

                                        <!-- Bluetooth Toggle Capsule -->
                                        <Button x:Name="BtnToggleBluetooth" Style="{StaticResource GhostBtn}" Click="BtnToggleBluetooth_Click" ToolTip="Bluetooth" Margin="1.5,0">
                                            <Border x:Name="PillBluetooth" Width="28" Height="36" CornerRadius="14" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="11" Height="14" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M17.71,7.71L12,2h-1v7.59L6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 11,14.41V22h1l5.71-5.71-4.3-4.29 4.3-4zM13,5.83l1.88,1.88L13,9.59V5.83zm1.88,10.46L13,18.17v-3.76l1.88,1.88z"/>
                                            </Border>
                                        </Button>

                                        <!-- Caffeine (Keep Screen Awake) Capsule -->
                                        <Button x:Name="BtnToggleCaffeine" Style="{StaticResource GhostBtn}" Click="BtnToggleCaffeine_Click" ToolTip="Caffeine (Cegah Layar Tidur)" Margin="1.5,0">
                                            <Border x:Name="PillCaffeine" Width="28" Height="36" CornerRadius="14" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M20,3H4v10c0,2.21,1.79,4,4,4h6c2.21,0,4-1.79,4-4v-3h2c1.1,0,2-.9,2-2V5c0-1.1-.9-2-2-2zm0,5h-2V5h2v3zM2,21h18v-2H2v2z"/>
                                            </Border>
                                        </Button>

                                        <!-- Dark Mode Capsule -->
                                        <Button x:Name="BtnToggleDarkMode" Style="{StaticResource GhostBtn}" Click="BtnToggleDarkMode_Click" ToolTip="Mode Gelap / Terang (Dark Mode)" Margin="1.5,0">
                                            <Border x:Name="PillDarkMode" Width="28" Height="36" CornerRadius="14" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12.3,2C6.9,2.5,2.7,6.9,2.7,12.3c0,5.5,4.5,10,10,10c5.4,0,9.8-4.2,10.3-9.6c-0.9,0.3-1.8,0.5-2.8,0.5c-4.4,0-8-3.6-8-8C12.2,4.1,12.5,3,12.3,2z"/>
                                            </Border>
                                        </Button>
                                    </UniformGrid>

                                    <!-- Row 2: 4 Vertical Capsule Pills (Mixer, Mute, Crop, Lock) -->
                                    <UniformGrid Grid.Row="2" Columns="4">
                                        <!-- Audio Mixer Button -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnQuickMicMute_Click" ToolTip="Audio Mixer &amp; Volume" Margin="1.5,0">
                                            <Border Width="28" Height="36" CornerRadius="14" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M3,17v2h6v-2H3zM3,5v2h10V5H3zm10,16v-2h8v-2h-8v-2h-2v6h2zM7,9v2H3v2h4v2h2V9H7zm14,4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
                                            </Border>
                                        </Button>

                                        <!-- Speaker Mute Button -->
                                        <Button Style="{StaticResource GhostBtn}" Click="ToolMute_Click" ToolTip="Bisukan / Aktifkan Audio" Margin="1.5,0">
                                            <Border Width="28" Height="36" CornerRadius="14" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="13" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M3,9v6h4l5,5V4L7,9H3zm13.5,3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73,2.5-2.25,2.5-4.02zM14,3.23v2.06c2.89,0.86,5,3.54,5,6.71s-2.11,5.85-5,6.71v2.06c4.01-0.91,7-4.49,7-8.77s-2.99-7.86-7-8.77z"/>
                                            </Border>
                                        </Button>

                                        <!-- Screenshot Camera Button -->
                                        <Button Style="{StaticResource GhostBtn}" Click="ToolScreenshot_Click" ToolTip="Cuplikan Layar (Screenshot)" Margin="1.5,0">
                                            <Border Width="28" Height="36" CornerRadius="14" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="13" Height="11" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12,12m-3.2,0a3.2,3.2,0,1,0,6.4,0a3.2,3.2,0,1,0,-6.4,0 M9,2L7.17,4H4c-1.1,0-2,0.9-2,2v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6c0-1.1-0.9-2-2-2h-3.17L15,2H9zm3,15c-2.76,0-5-2.24-5-5s2.24-5,5-5,5,2.24,5,5-2.24,5-5,5z"/>
                                            </Border>
                                        </Button>

                                        <!-- Lock Screen Button -->
                                        <Button Style="{StaticResource GhostBtn}" Click="ToolLock_Click" ToolTip="Kunci Windows (Lock Screen)" Margin="1.5,0">
                                            <Border Width="28" Height="36" CornerRadius="14" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="11" Height="13" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,.9-2,2v10c0,1.1.9,2,2,2h12c1.1,0,2-.9,2-2V10c0-1.1-.9-2-2-2zm-6,9c-1.1,0-2-.9-2-2s.9-2,2-2 2,.9,2,2-.9,2-2,2zm3.1-9H8.9V6c0-1.71,1.39-3.1,3.1-3.1 1.71,0,3.1,1.39,3.1,3.1v2z"/>
                                            </Border>
                                        </Button>
                                    </UniformGrid>
                                </Grid>

                                <Rectangle Grid.Column="3" Fill="#25FFFFFF" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COLUMN 2: APPS GRID (Screenshot 2: 2x3 Stacked Icons) -->
                                <Grid Grid.Column="4" Margin="5,0,4,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="🚀 APPS" Foreground="#8E8E93" FontSize="8" FontWeight="Bold" Margin="2,0,0,3"/>

                                    <UniformGrid Grid.Row="1" Rows="2" Columns="3">
                                        <!-- 1. File Explorer -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchExplorer_Click" ToolTip="File Explorer" Margin="1.5,1">
                                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="8" Padding="3,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📁" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="File Expl..." Foreground="#FFFFFF" FontSize="7.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 2. Console -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchTerminal_Click" ToolTip="Console / Terminal" Margin="1.5,1">
                                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="8" Padding="3,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="💻" FontSize="11" Foreground="#5AC8FA" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Console" Foreground="#FFFFFF" FontSize="7.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 3. Calculator -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchCalc_Click" ToolTip="Calculator" Margin="1.5,1">
                                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="8" Padding="3,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🧮" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Calculator" Foreground="#FFFFFF" FontSize="7.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 4. Notepad -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchNotepad_Click" ToolTip="Notepad" Margin="1.5,1">
                                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="8" Padding="3,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📝" FontSize="11" Foreground="#0A84FF" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Notepad" Foreground="#FFFFFF" FontSize="7.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 5. Task Manager -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchTaskmgr_Click" ToolTip="Task Manager" Margin="1.5,1">
                                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="8" Padding="3,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📊" FontSize="11" Foreground="#30D158" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Task Ma..." Foreground="#FFFFFF" FontSize="7.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 6. Settings -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchSettings_Click" ToolTip="Settings" Margin="1.5,1">
                                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="8" Padding="3,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Stretch="Uniform" Width="11" Height="11" Fill="#FFFFFF" HorizontalAlignment="Center" Data="M19.14,12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24,0-.43.17-.47.41l-.36,2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47,0-.59.22L2.74,8.87c-.12.21-.08.47.12.61l2.03,1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03,1.58c-.18.14-.23.41-.12.61l1.92,3.32c.12.22.37.29.59.22l2.39-.96c.5.38,1.03.7,1.62.94l.36,2.54c.05.24.24.41.48.41h3.84c.24,0,.44-.17.47-.41l.36-2.54c.59-.24,1.13-.56,1.62-.94l2.39.96c.22.08.47,0,.59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6 3.6,1.62,3.6,3.6-1.62,3.6-3.6,3.6z"/>
                                                    <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="7.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </UniformGrid>
                                </Grid>

                                <Rectangle Grid.Column="5" Fill="#25FFFFFF" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COLUMN 3: DAY PROGRESS CARD (Screenshot 2: 40% & 7h 25m until bedtime) -->
                                <Border Grid.Column="6" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="4,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="◷ " FontSize="8.5" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                            <TextBlock Text="DAY" Foreground="#8E8E93" FontSize="8.5" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- Big Bold 40% -->
                                        <TextBlock Grid.Row="1" Text="{Binding Metrics.DayPercentage, StringFormat={}{0}%, FallbackValue='40%'}" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

                                        <!-- Blue Progress Bar -->
                                        <ProgressBar Grid.Row="2" Value="{Binding Metrics.DayPercentage, FallbackValue=40}" Minimum="0" Maximum="100" Height="4"
                                                     Background="#25FFFFFF" Foreground="#0A84FF" BorderThickness="0" Margin="0,3,0,4"/>

                                        <!-- Subtext -->
                                        <TextBlock Grid.Row="3" Text="{Binding Metrics.DayPassedText, FallbackValue='7h 25m until bedtime'}" Foreground="#8E8E93" FontSize="7.5" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 2: 📊 SYSTEM STATS (ATOLL TELEMETRY PRO)  -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewPerf" Visibility="Collapsed" VerticalAlignment="Stretch" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" /> <!-- Left Hardware Cards Column -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Right Live Wave Graph & Metrics -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT HARDWARE TELEMETRY CARDS (Spacious Apple Cards) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- CPU Card -->
                            <Border x:Name="CardCpu" Background="#20FFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,0,5" Cursor="Hand" MouseLeftButtonDown="CardCpu_Click" ToolTip="Klik untuk monitor CPU">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#25FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="CPU" Foreground="#00D2FF" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Metrics.CpuGhz, StringFormat={}{0:F2} GHz}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metrics.CpuPercentage, StringFormat={}{0}%}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Metrics.ProcessCount, StringFormat={}{0} Proses}" Foreground="{StaticResource TextMuted}" FontSize="8.5"/>
                                        <TextBlock Text="{Binding Metrics.ThreadCount, StringFormat={}{0} Utas}" Foreground="{StaticResource TextMuted}" FontSize="8.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Memory Card -->
                            <Border x:Name="CardMemory" Background="#28FFFFFF" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,5" Cursor="Hand" MouseLeftButtonDown="CardMemory_Click" ToolTip="Klik untuk monitor Memory (RAM)">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#25FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="RAM" Foreground="{StaticResource AccentBlue}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Metrics.RamSpeed}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metrics.RamPercentage, StringFormat={}{0}%}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="8.5">
                                            <Run Text="{Binding Metrics.RamUsedGb, StringFormat={}{0:F1}, Mode=OneWay}"/> / <Run Text="{Binding Metrics.RamTotalGb, StringFormat={}{0:F1} GB, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Metrics.RamAvailGb, StringFormat={}Sisa {0:F1} GB}" Foreground="{StaticResource TextMuted}" FontSize="8.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- GPU Card -->
                            <Border x:Name="CardGpu" Background="#20FFFFFF" CornerRadius="8" Padding="10,6" Cursor="Hand" MouseLeftButtonDown="CardGpu_Click" ToolTip="Klik untuk monitor NVIDIA GPU">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#25FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="NVIDIA" Foreground="{StaticResource BatteryGreen}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Metrics.GpuTemp, StringFormat={}{0}°C}" Foreground="{StaticResource BatteryGreen}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metrics.GpuPercentage, StringFormat={}{0}%}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="8.5">
                                            VRAM <Run Text="{Binding Metrics.GpuMemUsedGb, Mode=OneWay}"/> / <Run Text="{Binding Metrics.GpuMemTotalGb, Mode=OneWay}"/> GB
                                        </TextBlock>
                                        <TextBlock Text="{Binding Metrics.GpuModel}" Foreground="{StaticResource TextMuted}" FontSize="8.5" HorizontalAlignment="Right" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- DIVIDER -->
                        <Rectangle Grid.Column="1" Fill="#222230" Width="1" VerticalAlignment="Stretch" Margin="0,2"/>

                        <!-- RIGHT LIVE TELEMETRY DASHBOARD (Tall Smooth Real-time Graph) -->
                        <Grid Grid.Column="2" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" /> <!-- Header -->
                                <RowDefinition Height="*" />  <!-- Real-time Graph (Spacious & Tall) -->
                                <RowDefinition Height="14" /> <!-- Axis Markers -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Header & Real-time Live Stats Inline -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Metrics.ActiveHeaderTitle}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Metrics.ActiveHeaderSubtitle}" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                </StackPanel>

                                <!-- Memory Live Details -->
                                <StackPanel x:Name="GridMemoryDetails" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Visible">
                                    <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Digunakan " Foreground="{StaticResource TextSecondary}" FontSize="8.5"/>
                                            <TextBlock Text="{Binding Metrics.RamUsedGb, StringFormat={}{0:F1} GB}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text=" • Tersedia " Foreground="{StaticResource TextSecondary}" FontSize="8.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.RamAvailGb, StringFormat={}{0:F1} GB}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- CPU Live Details -->
                                <StackPanel x:Name="GridCpuDetails" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Beban " Foreground="{StaticResource TextSecondary}" FontSize="8.5"/>
                                            <TextBlock Text="{Binding Metrics.CpuPercentage, StringFormat={}{0}%}" Foreground="#00D2FF" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text=" • Speed " Foreground="{StaticResource TextSecondary}" FontSize="8.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.CpuGhz, StringFormat={}{0:F2} GHz}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text=" • Uptime " Foreground="{StaticResource TextSecondary}" FontSize="8.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.UpTimeString}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- GPU Live Details -->
                                <StackPanel x:Name="GridGpuDetails" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="NVIDIA " Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="8.5"/>
                                            <TextBlock Text="Load " Foreground="{StaticResource TextSecondary}" FontSize="8.5"/>
                                            <TextBlock Text="{Binding Metrics.GpuPercentage, StringFormat={}{0}%}" Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text=" • Suhu " Foreground="{StaticResource TextSecondary}" FontSize="8.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.GpuTemp, StringFormat={}{0}°C}" Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text=" • Clock " Foreground="{StaticResource TextSecondary}" FontSize="8.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.GpuClockMhz, StringFormat={}{0} MHz}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Real-time 60-Second Scrolling Wave Graph -->
                            <Border Grid.Row="1" Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6" MinHeight="56">
                                <Viewbox Stretch="Fill">
                                    <Grid Width="600" Height="100">
                                        <!-- Horizontal Grid Lines -->
                                        <Rectangle Fill="#141422" Height="1" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                        <Rectangle Fill="#141422" Height="1" VerticalAlignment="Top" Margin="0,50,0,0"/>
                                        <Rectangle Fill="#141422" Height="1" VerticalAlignment="Top" Margin="0,75,0,0"/>

                                        <!-- Vertical Grid Lines (10s intervals) -->
                                        <Rectangle Fill="#141422" Width="1" HorizontalAlignment="Left" Margin="100,0,0,0"/>
                                        <Rectangle Fill="#141422" Width="1" HorizontalAlignment="Left" Margin="200,0,0,0"/>
                                        <Rectangle Fill="#141422" Width="1" HorizontalAlignment="Left" Margin="300,0,0,0"/>
                                        <Rectangle Fill="#141422" Width="1" HorizontalAlignment="Left" Margin="400,0,0,0"/>
                                        <Rectangle Fill="#141422" Width="1" HorizontalAlignment="Left" Margin="500,0,0,0"/>

                                        <!-- Area Gradient Fill -->
                                        <Polygon x:Name="GraphAreaPolygon" Points="{Binding Metrics.ActiveAreaPoints}">
                                            <Polygon.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop x:Name="GraphGradTop" Color="#600A84FF" Offset="0"/>
                                                    <GradientStop x:Name="GraphGradBottom" Color="#050A84FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Polygon.Fill>
                                        </Polygon>

                                        <!-- Dynamic Wave Line -->
                                        <Polyline x:Name="GraphLinePolyline" Points="{Binding Metrics.ActiveLinePoints}" Stroke="{StaticResource AccentBlue}" StrokeThickness="2.2"/>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <!-- Row 2: Sub-Axis Markers -->
                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                <TextBlock Text="60 detik lalu" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                                <TextBlock Text="{Binding Metrics.ActiveGraphLabel}" Foreground="{StaticResource TextMuted}" FontSize="8" HorizontalAlignment="Center"/>
                                <TextBlock Text="0 detik (langsung)" Foreground="{StaticResource AccentBlue}" FontSize="8" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                        </Grid>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 2B: 🎮 GAMING HUB & PERFORMANCE OPTIMIZER -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewGameMode" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" /> <!-- Hero Card: Active Game & FPS -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="260" /> <!-- Live Gaming Hardware Stats -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Gaming Optimizer Toggles -->
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 0: HERO CARD (Detected Game & FPS) -->
                        <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Detected Game Title -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GameMode.ActiveGameTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="195"/>
                                </StackPanel>

                                <!-- Big Glowing FPS Display -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                                    <Border Background="#25FFFFFF" BorderBrush="#28683E" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " Foreground="#30D158" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Metrics.FpsDisplayString}" Foreground="#30D158" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Consolas" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Latency" Foreground="{StaticResource TextMuted}" FontSize="7.5"/>
                                        <TextBlock Text="{Binding GameMode.FrameTimeMs, StringFormat={}{0:F1} ms}" Foreground="#5AC8FA" FontSize="9.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Status Subtitle -->
                                <TextBlock Grid.Row="2" Text="{Binding GameMode.BoostStatusText}" Foreground="{StaticResource TextSecondary}" FontSize="8" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="#25FFFFFF" Width="1" Height="86" VerticalAlignment="Center"/>

                        <!-- COLUMN 2: HARDWARE STATS (GPU NVIDIA, CPU, RAM) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,10,0">
                            <!-- GPU Card -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="#25FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,5,0">
                                            <TextBlock Text="NVIDIA" Foreground="#30D158" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Metrics.GpuTemp, StringFormat={}{0}°C}" Foreground="#30D158" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" • VRAM " Foreground="{StaticResource TextMuted}" FontSize="8" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        <TextBlock Text="{Binding Metrics.GpuMemUsedGb, StringFormat={}{0}G}" Foreground="{StaticResource TextPrimary}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Metrics.GpuPercentage, StringFormat={}{0}% Load}" Foreground="#30D158" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- CPU Card -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="#1A2840" CornerRadius="4" Padding="4,1" Margin="0,0,5,0">
                                            <TextBlock Text="CPU" Foreground="#0A84FF" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Metrics.CpuGhz, StringFormat={}{0:F2} GHz}" Foreground="{StaticResource TextPrimary}" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Metrics.CpuPercentage, StringFormat={}{0}% Load}" Foreground="#0A84FF" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- RAM Card -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="#25FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,5,0">
                                            <TextBlock Text="RAM" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Metrics.RamUsedGb, StringFormat={}{0:F1} GB}" Foreground="{StaticResource TextPrimary}" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" / " Foreground="{StaticResource TextMuted}" FontSize="8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Metrics.RamTotalGb, StringFormat={}{0:F0} GB}" Foreground="{StaticResource TextMuted}" FontSize="8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Metrics.RamPercentage, StringFormat={}{0}%}" Foreground="#BF5AF2" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Fill="#25FFFFFF" Width="1" Height="86" VerticalAlignment="Center"/>

                        <!-- COLUMN 4: GAMING OPTIMIZER ACTION BUTTONS -->
                        <Grid Grid.Column="4" Margin="10,0,2,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Game Boost Toggle -->
                            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,3,3" Style="{StaticResource ToolCardBtn}" Click="BtnGameBoost_Click" ToolTip="Prioritas Game Tinggi &amp; Optimasi I/O">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🚀" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GameMode.BoostButtonText}" FontSize="8" FontWeight="Bold" Foreground="#0A84FF" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. WinLock -->
                            <Button Grid.Row="0" Grid.Column="1" Margin="3,0,0,3" Style="{StaticResource ToolCardBtn}" Click="BtnWinLock_Click" ToolTip="Kunci Tombol Windows (Cegah Start Menu Pop-up)">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GameMode.WinLockButtonText}" FontSize="8" FontWeight="Bold" Foreground="#FF9F0A" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Clean RAM -->
                            <Button Grid.Row="1" Grid.Column="0" Margin="0,3,3,0" Style="{StaticResource ToolCardBtn}" Click="BtnCleanRam_Click" ToolTip="Bersihkan Cache Memori &amp; Standby List">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🧹" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GameMode.CleanRamStatus}" FontSize="8" Foreground="#30D158" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. DND Gaming -->
                            <Button Grid.Row="1" Grid.Column="1" Margin="3,3,0,0" Style="{StaticResource ToolCardBtn}" Click="BtnGameDnd_Click" ToolTip="Mode Senyap / Jangan Ganggu Saat Gaming">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌙" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Mode Senyap" FontSize="8" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 3: 🔋 BATTERIES (HEADSET & MOUSE)         -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewBattery" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Headset Card -->
                        <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Stroke="{StaticResource BatteryTrack}" StrokeThickness="3.5"/>
                                    <local:CircularProgress Width="42" Height="42" 
                                                            Stroke="{StaticResource BatteryGreen}" 
                                                            StrokeThickness="3.5" 
                                                            Percentage="{Binding Battery.Headset.BatteryPercent}"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round"/>
                                    <TextBlock Text="{Binding Battery.Headset.BatteryPercent, StringFormat={}{0}%}" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎧" FontSize="12" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Battery.Headset.Name}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>
                                    <TextBlock Text="Razer Barracuda X (2.4G)" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,1,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource BatteryGreen}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Terkoneksi (Aktif)" Foreground="{StaticResource BatteryGreen}" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mouse Card -->
                        <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Stroke="{StaticResource BatteryTrack}" StrokeThickness="3.5"/>
                                    <local:CircularProgress Width="42" Height="42" 
                                                            Stroke="{StaticResource BatteryGreen}" 
                                                            StrokeThickness="3.5" 
                                                            Percentage="{Binding Battery.Mouse.BatteryPercent}"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round"/>
                                    <TextBlock Text="{Binding Battery.Mouse.BatteryPercent, StringFormat={}{0}%}" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖱️" FontSize="12" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Battery.Mouse.Name}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>
                                    <TextBlock Text="Wireless 2.4G Mouse" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,1,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource BatteryGreen}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Terkoneksi (Aktif)" Foreground="{StaticResource BatteryGreen}" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 4: 🎵 FULL MUSIC PLAYER CONTROLLER        -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewMusic" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Album Art Cover -->
                        <Grid Grid.Column="0" Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border CornerRadius="10" Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3D1222" Offset="0"/>
                                                <GradientStop Color="#121018" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="🎵" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill"
                                           Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                            <Border Width="15" Height="15" CornerRadius="3" Background="{StaticResource AccentAppleMusic}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                    Cursor="Hand" MouseLeftButtonDown="BtnAppleBadge_Click" ToolTip="Buka Apple Music">
                                <TextBlock Text="" Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </Grid>

                        <!-- Track Info & Controls -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Media.SongTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Media.ArtistName}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,0.5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Control Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Button Width="26" Height="26" Style="{StaticResource RoundActionBtn}" Click="MediaPrev_Click" ToolTip="Previous">
                                    <TextBlock Text="⏮" FontSize="10"/>
                                </Button>
                                <Button Width="30" Height="30" Style="{StaticResource RoundActionBtn}" Background="{StaticResource AccentBlue}" Click="MediaPlayPause_Click" ToolTip="Play / Pause" Margin="8,0">
                                    <Grid>
                                        <TextBlock Text="▶" FontSize="11" Foreground="White" Margin="1,0,0,0"
                                                   Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisInverted}}"/>
                                        <TextBlock Text="⏸" FontSize="11" Foreground="White"
                                                   Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>
                                <Button Width="26" Height="26" Style="{StaticResource RoundActionBtn}" Click="MediaNext_Click" ToolTip="Next">
                                    <TextBlock Text="⏭" FontSize="10"/>
                                </Button>

                                <Border Width="1" Height="16" Background="#25FFFFFF" Margin="10,0"/>

                                <Button Width="24" Height="24" Style="{StaticResource RoundActionBtn}" Click="MediaMute_Click" ToolTip="Mute / Unmute">
                                    <TextBlock Text="🔇" FontSize="9.5"/>
                                </Button>
                                <Button Width="24" Height="24" Style="{StaticResource RoundActionBtn}" Click="MediaVolDown_Click" ToolTip="Volume Down" Margin="4,0,0,0">
                                    <TextBlock Text="🔉" FontSize="9.5"/>
                                </Button>
                                <Button Width="24" Height="24" Style="{StaticResource RoundActionBtn}" Click="MediaVolUp_Click" ToolTip="Volume Up" Margin="4,0,0,0">
                                    <TextBlock Text="🔊" FontSize="9.5"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dancing Audio Equalizer Bars -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="18" Margin="0,0,6,0">
                            <Rectangle x:Name="EqBar1" Width="3" Height="8" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="EqBar2" Width="3" Height="14" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="EqBar3" Width="3" Height="10" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="EqBar4" Width="3" Height="15" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="EqBar5" Width="3" Height="7" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                        </StackPanel>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 5: 📅 DEDICATED AGENDA & CALENDAR         -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewAgenda" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Date Panel -->
                        <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Metrics.MonthName}" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Metrics.CurrentDateString}" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding Metrics.TodayScheduleText}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="#202026" Width="1" VerticalAlignment="Stretch" Margin="8,0"/>

                        <!-- Right Timeline Strip -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Jadwal Mingguan" Foreground="{StaticResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Metrics.CurrentWeekDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="40" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="4,6" Margin="0,0,5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayLetter}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DayNumber}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 6: ⏱️ POMODORO FOCUS & STOPWATCH SUITE      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTimer" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Authentic Threads Island Card (@weldraws_) -->
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="1" />
                            <!-- Column 1: Presets & Motivation Stats -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- @weldraws_ Pomodoro & Stand Island Widget -->
                        <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,9" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 1. Top Bar: Date & Battery + Clock -->
                                    <RowDefinition Height="Auto"/> <!-- 2. Title & Stand Badge -->
                                    <RowDefinition Height="Auto"/> <!-- 3. Capsules: Fokus 25m & Berdiri 10m -->
                                    <RowDefinition Height="Auto"/> <!-- 4. Action Controls: ▶ Mulai & 🔄 Reset -->
                                    <RowDefinition Height="Auto"/> <!-- 5. Carousel Dots: ● ○ ○ ○ -->
                                </Grid.RowDefinitions>

                                <!-- 1. Top Bar: Date & Battery + Clock -->
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtPomodoroDate" Text="29 Okt" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="🔋 " FontFamily="Segoe UI Emoji" FontSize="10" Foreground="#34C759" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Metrics.BatteryPercent, StringFormat='{}{0}%', FallbackValue='100%'}" Foreground="#8E8E93" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Metrics.TimeFormatted, FallbackValue='13:00'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 2. Title & Stand Badge -->
                                <Grid Grid.Row="1" Margin="0,0,0,7">
                                    <TextBlock Text="Pomodoro" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,2.5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🚶 " FontFamily="Segoe UI Emoji" FontSize="9.5" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtStandMilestone" Text="1x hari" Foreground="#9CA3AF" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 3. Mode Capsules: Fokus 25m & Berdiri 10m -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Fokus 25m Capsule -->
                                    <Button x:Name="BtnPomoFocusMode" Grid.Column="0" Style="{StaticResource GhostBtn}" Click="BtnPomoFocusMode_Click" Margin="0,0,4,0" Cursor="Hand">
                                        <Border x:Name="BorderPomoFocus" Background="#28FFFFFF" BorderBrush="#45FFFFFF" BorderThickness="1.5" CornerRadius="12" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🎯 " FontFamily="Segoe UI Emoji" FontSize="9.5" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtPomoFocusLabel" Text="Fokus 25m" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <!-- Berdiri 10m Capsule -->
                                    <Button x:Name="BtnPomoStandMode" Grid.Column="1" Style="{StaticResource GhostBtn}" Click="BtnPomoStandMode_Click" Margin="4,0,0,0" Cursor="Hand">
                                        <Border x:Name="BorderPomoStand" Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse x:Name="DotPomoStand" Width="6" Height="6" Fill="#34C759" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtPomoStandLabel" Text="Berdiri 10m" Foreground="#9CA3AF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>

                                <!-- 4. Action Controls: Big White Pill & Circular Reset -->
                                <Grid Grid.Row="3" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Big White Pill: ▶ Mulai / ⏸ Jeda with Live Countdown -->
                                    <Button x:Name="BtnPomoMainAction" Grid.Column="0" Style="{StaticResource GhostBtn}" Click="TimerStartPause_Click" Margin="0,0,8,0" Cursor="Hand">
                                        <Border Background="#FFFFFF" CornerRadius="17" Padding="14,6.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="TimerStartIcon" Text="▶" Foreground="#000000" FontSize="11" FontWeight="Bold" Margin="0,-1,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TimerStartLabel" Text="Mulai" Foreground="#000000" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TimerDisplay" Text=" 25:00" Foreground="#222222" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <!-- Circular Dark Reset Button: 🔄 -->
                                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Click="TimerReset_Click" ToolTip="Reset Timer" Cursor="Hand">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#28FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                            <TextBlock Text="🔄" FontFamily="Segoe UI Emoji" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </Button>
                                </Grid>

                                <!-- 5. Carousel Dots: ● ○ ○ ○ -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                                    <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="2,0"/>
                                    <Ellipse Width="5" Height="5" Fill="#3E4254" Margin="2,0"/>
                                    <Ellipse Width="5" Height="5" Fill="#3E4254" Margin="2,0"/>
                                    <Ellipse Width="5" Height="5" Fill="#3E4254" Margin="2,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="#25FFFFFF" Width="1" Height="120" VerticalAlignment="Center"/>

                        <!-- Column 1: Presets & Focus Analytics -->
                        <Border Grid.Column="2" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🍅 PRESET DURASI" Foreground="#FF9F0A" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="TimerModeLabel" Text="POMODORO FOCUS" Foreground="{StaticResource TextSecondary}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <Button Content="5m" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Click="TimerSet5_Click" Padding="4,3" Margin="1,0" FontSize="8.5"/>
                                    <Button Content="15m" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Click="TimerSet15_Click" Padding="4,3" Margin="1,0" FontSize="8.5"/>
                                    <Button Content="25m" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Click="TimerSet25_Click" Padding="4,3" Margin="1,0" FontSize="8.5"/>
                                    <Button Content="⏱ Stopw" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Click="TimerSetStopwatch_Click" Padding="4,3" Margin="1,0" FontSize="8.5" ToolTip="Stopwatch"/>
                                </UniformGrid>
                                <Border Background="#22FFFFFF" CornerRadius="8" Padding="8,5">
                                    <StackPanel>
                                        <TextBlock Text="🚶 Pengingat Berdiri Harian" Foreground="#34C759" FontSize="8.5" FontWeight="Bold"/>
                                        <TextBlock Text="Regangkan tubuh &amp; berdiri sejenak untuk melancarkan sirkulasi." Foreground="#9CA3AF" FontSize="8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 6A: ❤️ DEDICATED HEALTH & ERGONOMICS (PONI) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewHealth" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" /> <!-- Hydration Card & Sitting Status -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Poni Smart Break Routine -->
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 0: HYDRATION & ERGONOMICS OVERVIEW -->
                        <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Title & Sitting Counter -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="Kesehatan &amp; Ergonomi" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9"/>
                                    <TextBlock Text="{Binding Health.SittingStatusText}" Foreground="#FF9F0A" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Hydration Progress -->
                                <StackPanel Grid.Row="1" Margin="0,2,0,4">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="💧 Asupan Air Harian" Foreground="{StaticResource TextSecondary}" FontSize="8"/>
                                        <TextBlock Text="{Binding Health.WaterProgressText}" Foreground="#5AC8FA" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Height="5" Maximum="100" Value="{Binding Health.WaterProgressPercent, Mode=OneWay}" Background="#25FFFFFF" Foreground="#0A84FF" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Quick Add Water Button -->
                                <Button Grid.Row="2" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#5AC8FA" FontSize="8" Padding="6,2" HorizontalAlignment="Stretch" Margin="0,2,0,4" Click="BtnHealthDrink_Click">
                                    <TextBlock Text="+ 250ml Air (Segelas)" HorizontalAlignment="Center"/>
                                </Button>

                                <!-- Ergonomics Posture Hint & Reset Sitting Button -->
                                <Button Grid.Row="3" Style="{StaticResource GhostBtn}" Padding="2,1" Click="BtnHealthStretch_Click" ToolTip="Reset Timer Duduk (Selesai Peregangan)">
                                    <TextBlock Text="🧘 Regangkan Punggung &amp; Bahu (Reset)" Foreground="#30D158" FontSize="7.5" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="#25FFFFFF" Width="1" Height="86" VerticalAlignment="Center"/>

                        <!-- COLUMN 2: SMART BREAK ROUTINE (PONI HEALTH BREAKS) -->
                        <StackPanel Grid.Column="2" Margin="10,0,2,0" VerticalAlignment="Center">
                            <!-- 1. Hydration Break -->
                            <Border Background="#25FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Health.WaterStatus}" Foreground="#0A84FF" FontSize="8.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Minum Sekarang" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#5AC8FA" FontSize="8" Padding="8,2" Click="BtnHealthDrink_Click"/>
                                </Grid>
                            </Border>

                            <!-- 2. Eye Strain 20-20-20 -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Health.EyeStatus}" Foreground="#30D158" FontSize="8.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Aturan 20-20-20" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#30D158" FontSize="8" Padding="8,2" Click="BtnHealthEye_Click"/>
                                </Grid>
                            </Border>

                            <!-- 3. Breathing Exercise (Box Breathing) -->
                            <Border Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Health.BreathPrompt}" Foreground="#FF9F0A" FontSize="8.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Mulai Napas (Box)" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FF9F0A" FontSize="8" Padding="8,2" Click="BtnHealthBreathe_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>





                    <!-- ============================================== -->
                    <!-- VIEW 6B: 📝 TODO & QUICK NOTES (PONI NOTES)      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTodo" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" /> <!-- Todo Task List -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Scratchpad Notes -->
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 1: TODO LIST -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header & Summary -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="{Binding TodoNotes.ActiveTaskSummary}" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold"/>
                            </Grid>

                            <!-- New Task Input -->
                            <Grid Grid.Row="1" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewTodo" Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" Foreground="#FFFFFF" FontSize="8.5" Padding="6,3.5" KeyDown="TxtNewTodo_KeyDown"/>
                                <Button Grid.Column="1" Content="+ Tambah" Style="{StaticResource NavPillBtn}" Background="#0A84FF" Foreground="#FFFFFF" FontSize="8" Padding="7,2" Margin="4,0,0,0" Click="BtnAddTodo_Click"/>
                            </Grid>

                            <!-- Task List Items -->
                            <ScrollViewer Grid.Row="2" MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TodoNotes.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,2.5" Margin="0,1.5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="0,0,6,0" Click="CheckTodo_Click"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="8.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostBtn}" Foreground="#FF453A" FontSize="8" Padding="3,0" Tag="{Binding}" Click="BtnDeleteTodo_Click" ToolTip="Hapus Tugas"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Rectangle Grid.Column="1" Fill="#25FFFFFF" Width="1" Height="86" VerticalAlignment="Center"/>

                        <!-- COLUMN 2: SCRATCHPAD QUICK NOTES -->
                        <Grid Grid.Column="2" Margin="10,0,2,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📝 CATATAN CEPAT (AUTO-SAVE)" Foreground="#636366" FontSize="8" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox Grid.Row="1" Text="{Binding TodoNotes.QuickNoteText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" Foreground="#E5E5EA"
                                     FontSize="8.5" Padding="7,5" Height="84" CaretBrush="#0A84FF"/>
                        </Grid>
                    </Grid>





                    <!-- ============================================== -->
                    <!-- VIEW 7: 🛠️ ATOLL SYSTEM ACTION TILES             -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTools" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. Lock PC -->
                        <Button Grid.Column="0" Style="{StaticResource ToolCardBtn}" Click="ToolLock_Click" Margin="0,0,3,0" ToolTip="Kunci Windows (Efek Suara Atoll Lock)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔒" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Kunci PC" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Sleep -->
                        <Button Grid.Column="1" Style="{StaticResource ToolCardBtn}" Click="ToolSleep_Click" Margin="2,0,3,0" ToolTip="Mode Tidur (Sleep)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🌙" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sleep" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Mute Master Audio -->
                        <Button Grid.Column="2" Style="{StaticResource ToolCardBtn}" Click="ToolMute_Click" Margin="2,0,3,0" ToolTip="Bisukan / Aktifkan Audio Master">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔇" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Bisukan" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Atoll Color Picker -->
                        <Button Grid.Column="3" Style="{StaticResource ToolCardBtn}" Click="ToolColorPicker_Click" Margin="2,0,3,0" ToolTip="Atoll Screen Eyedropper (Ambil Warna Piksel Layar)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎨" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Warna" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. Snip Tool -->
                        <Button Grid.Column="4" Style="{StaticResource ToolCardBtn}" Click="ToolScreenshot_Click" Margin="2,0,3,0" ToolTip="Snipping Tool / Screenshot">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✂️" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Snip Tool" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. Atoll Clipboard -->
                        <Button Grid.Column="5" Style="{StaticResource ToolCardBtn}" Click="ToolClipboard_Click" Margin="2,0,3,0" ToolTip="Buka Riwayat Clipboard Atoll">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📋" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Clipboard" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 7. Task Manager -->
                        <Button Grid.Column="6" Style="{StaticResource ToolCardBtn}" Click="ToolTaskMgr_Click" Margin="2,0,3,0" ToolTip="Pengelola Tugas (Task Manager)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Task Mgr" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 8. Windows Settings -->
                        <Button Grid.Column="7" Style="{StaticResource ToolCardBtn}" Click="ToolSettings_Click" Margin="2,0,0,0" ToolTip="Pengaturan Windows">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Settings" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 7.2: 📋 ATOLL CLIPBOARD HISTORY MANAGER   -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewClipboard" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar: Search + Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Bar -->
                            <Border Grid.Column="0" Background="#20FFFFFF" CornerRadius="8" BorderBrush="#38FFFFFF" BorderThickness="1" Padding="8,4" Margin="0,0,8,0">
                                <Grid>
                                    <TextBlock Text="🔍 Cari teks di riwayat clipboard..." Foreground="#666675" FontSize="10.5" VerticalAlignment="Center" Margin="2,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Text.IsEmpty, ElementName=TxtClipboardSearch, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox x:Name="TxtClipboardSearch" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="10.5"
                                             VerticalAlignment="Center" TextChanged="TxtClipboardSearch_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Clear All Button -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnClearClipboard" Content="🗑 Bersihkan" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FF453A" FontSize="9.5" Padding="8,4" Click="BtnClearClipboard_Click" ToolTip="Hapus semua riwayat yang tidak di-pin"/>
                            </StackPanel>
                        </Grid>

                        <!-- History List -->
                        <ScrollViewer Grid.Row="1" MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ClipboardItemsControl" ItemsSource="{Binding Clipboard.FilteredItems, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="7" Margin="0,0,0,4" Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Pin button -->
                                                <Button Grid.Column="0" Content="{Binding PinIcon}" Style="{StaticResource GhostBtn}" FontSize="10" Padding="3,1" Margin="0,0,6,0" Click="BtnClipboardPin_Click" ToolTip="Pin ke atas"/>

                                                <!-- Content -->

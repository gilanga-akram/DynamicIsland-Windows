<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DynamicIsland"
        mc:Ignorable="d"
        Title="Dynamic Island Pro"
        Height="350" Width="920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        Loaded="Window_Loaded">

    <Window.Resources>
        <LinearGradientBrush x:Key="MacCardFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF2B2B2F" Offset="0"/>
            <GradientStop Color="#FF202023" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MacCardStroke" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2EFFFFFF" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
            <GradientStop Color="#08FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IcoBlue" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF5AC8FA" Offset="0"/><GradientStop Color="#FF0A84FF" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="IcoGreen" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF67E480" Offset="0"/><GradientStop Color="#FF28B94A" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="IcoOrange" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFB340" Offset="0"/><GradientStop Color="#FFFF8A00" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="IcoRed" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFF6B61" Offset="0"/><GradientStop Color="#FFE8332A" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="IcoPurple" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFB07CF0" Offset="0"/><GradientStop Color="#FF6E4CE0" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="IcoPink" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFF7AA8" Offset="0"/><GradientStop Color="#FFF0386B" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="IcoGray" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFA0A0A8" Offset="0"/><GradientStop Color="#FF6C6C72" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="IcoTeal" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF6EE3E0" Offset="0"/><GradientStop Color="#FF20A5A8" Offset="1"/></LinearGradientBrush>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInverted"/>
        <local:CountToVisibilityConverter x:Key="CountToVis" Invert="False"/>
        <local:CountToVisibilityConverter x:Key="CountToVisInverted" Invert="True"/>
        <local:PercentToScaleConverter x:Key="PercentToScale"/>
        <local:PercentToBatteryBrushConverter x:Key="BatteryBrush"/>
        <local:KaraokeMaskConverter x:Key="KaraokeMask"/>

        <!-- macOS Palette -->
        <SolidColorBrush x:Key="NotchBg" Color="#000000" />
        <SolidColorBrush x:Key="NotchBorder" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="BatteryTrack" Color="#17351F" />
        <SolidColorBrush x:Key="BatteryGreen" Color="#30D158" />
        <SolidColorBrush x:Key="AccentBlue" Color="#0A84FF" />
        <SolidColorBrush x:Key="AccentAppleMusic" Color="#FA2D48" />
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9F0A" />
                <SolidColorBrush x:Key="GlassCardBg" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="GlassCardBorder" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="CardBg" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B3EBEBF5" />
        <SolidColorBrush x:Key="TextMuted" Color="#8E8E93" />

        <!-- Navigation Pill Button Style -->
        <Style x:Key="NavPillBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F0F5FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,2.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Action Button Style -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="Opacity" Value="1.0" />
                                <Setter Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Media Action Button Style -->
        <Style x:Key="RoundActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline Media Action Button Style -->
        <Style x:Key="InlineMediaBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DCDCE0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Tool Card Button Style -->
        <!-- Quick Tool Card Button Style (macOS Crystal Frosted Glass matching Dock) -->
        <Style x:Key="ToolCardBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="toolBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Ultra-sleek macOS Style ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#40FFFFFF" CornerRadius="2" Margin="0" Opacity="0.8"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#40FFFFFF" CornerRadius="2" Margin="0" Opacity="0.8"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Apple-style Clean Responsive Slider -->
        <Style x:Key="AppleSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#0A84FF" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#33FFFFFF" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="14" Height="14">
                                                    <Ellipse Fill="#FFFFFF">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="Black"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Now Playing scrubber: white fill on a translucent track, knob appears on hover -->
        <Style x:Key="NowPlayingSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#E6FFFFFF" CornerRadius="2,0,0,2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#33FFFFFF" CornerRadius="0,2,2,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Knob" Opacity="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- Zero-width thumb so the fill and track meet without a gap -->
                                                <Canvas Width="0" Height="10" Background="Transparent">
                                                    <Ellipse Canvas.Left="-5" Width="10" Height="10" Fill="#FFFFFF">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4" Color="Black"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Canvas>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS text field: translucent fill, rounded corners, soft blue focus ring -->
        <Style x:Key="MacTextField" TargetType="TextBox">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#0A84FF"/>
            <Setter Property="SelectionBrush" Value="#0A84FF"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="#990A84FF"/>
                                <Setter TargetName="Field" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular icon button (macOS transport / toolbar glyphs) -->
        <Style x:Key="MacCircleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="99">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Thin Track iOS/macOS Volume Slider matching Screenshot -->
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="#F2F2F7" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="#33FFFFFF" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="11" Height="11">
                                                    <Ellipse Fill="#FFFFFF">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.35" Color="Black"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Top Header Square/Pill Icon Button -->
        <Style x:Key="HeaderIconBtn" TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F0F5FF" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#24FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting Pill Button Style -->
        <Style x:Key="SettingPillBtn" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="#F0F5FF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2EFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist macOS Menu Separator -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#1FFFFFFF" Margin="10,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist macOS / Dynamic Island ContextMenu Style -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border x:Name="MenuBorder"
                                Background="#F01E1E20"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="0.5"
                                CornerRadius="10"
                                Padding="5,5">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist macOS / Dynamic Island MenuItem Style -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#E2E2EA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <!-- The Item Row Capsule -->
                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="9,4.5" Margin="0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="16"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Integrated Checkmark (No gray square gutter) -->
                                    <Path x:Name="CheckMark" Grid.Column="0" 
                                          Data="M 1,5 L 4.5,8.5 L 11,2" 
                                          Stroke="#FFFFFF" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" 
                                          Visibility="Collapsed" Margin="0,0,6,0"/>

                                    <!-- Header Content (Includes emoji & title text) -->
                                    <ContentPresenter x:Name="HeaderHost" Grid.Column="1" 
                                                      ContentSource="Header" 
                                                      RecognizesAccessKey="True" 
                                                      VerticalAlignment="Center"/>

                                    <!-- Submenu Arrow (Chevron) -->
                                    <TextBlock x:Name="SubMenuArrow" Grid.Column="2" 
                                               Text="›" FontSize="13" FontWeight="Bold" 
                                               Foreground="#8E8E98" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" 
                                               Margin="8,-1,0,0" 
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Submenu Popup Container -->
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Right" 
                                   HorizontalOffset="2" 
                                   VerticalOffset="-4" 
                                   PopupAnimation="Fade">
                                <Border Background="#F01E1E20"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="0.5"
                                        CornerRadius="10"
                                        Padding="5,5">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover / Highlighted State -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0A84FF"/>
                                <Setter TargetName="SubMenuArrow" Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Checkable Checked State -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Has Submenu (SubmenuHeader Role) -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555562"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Screen Anchor (Supports Top, Left, and Right Docking) -->
    <Grid x:Name="IslandRootGrid" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">

        <!-- Dynamic Island Pill (Zero Box Shadow, Pure Capsule Corners, Scroll-Switchable) -->
        <!-- Dynamic Island Hardware Notch (Flared ears seamlessly attached to top/side bezels) -->
        <Border x:Name="IslandBorder"
                Width="240"
                Height="36"
                CornerRadius="0"
                Background="Transparent"
                BorderThickness="0"
                MouseEnter="IslandBorder_MouseEnter"
                MouseLeave="IslandBorder_MouseLeave"
                MouseLeftButtonDown="IslandBorder_MouseLeftButtonDown"
                MouseLeftButtonUp="IslandBorder_MouseLeftButtonUp"
                MouseRightButtonUp="IslandBorder_MouseRightButtonUp"
                MouseMove="IslandBorder_MouseMove"
                PreviewMouseWheel="IslandBorder_PreviewMouseWheel"
                SizeChanged="IslandBorder_SizeChanged"
                Cursor="Arrow"
                AllowDrop="True"
                DragEnter="IslandBorder_DragEnter"
                DragOver="IslandBorder_DragOver"
                DragLeave="IslandBorder_DragLeave"
                Drop="IslandBorder_Drop"
                ToolTip="Klik kiri: Buka Dynamic Island • Klik kanan: Buka Pengaturan Poni Settings">

            <Grid>
                <!-- Attached Notch Shape (Hardware cutout fused to screen top bezel) -->
                <Path x:Name="NotchFillPath" Fill="#000000" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                <Path x:Name="NotchBorderPath" Stroke="#14FFFFFF" StrokeThickness="1" IsHitTestVisible="False" SnapsToDevicePixels="True"/>

                <!-- Content Container (Clipped to Notch Geometry) -->
                <Grid x:Name="NotchContentGrid">
                    <!-- DRAG & DROP OVERLAY TARGET -->
                    <Border x:Name="DropZoneOverlay" Visibility="Collapsed" Opacity="0" Background="#F2000000" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="18" Margin="2" Panel.ZIndex="99" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="LEPASKAN BERKAS DI SINI" Foreground="#0A84FF" FontWeight="SemiBold" FontSize="10.5"/>
                                <TextBlock Text="Simpan ke Shelf &amp; Siap Dibagikan" Foreground="#C7C7CC" FontSize="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- 1. COMPACT NOTCH (Modes: Battery, Music, Perf) -->
                    <!-- ============================================== -->
                    <Grid x:Name="CompactView" Visibility="Visible" Opacity="1">

                        <!-- 1A. HORIZONTAL COMPACT CONTAINER (DOCK TOP) -->
                        <Grid x:Name="CompactHorizontalContainer" Visibility="Visible">

                        <!-- Mode A: Battery — macOS menu-bar battery glyph -->
                        <Grid x:Name="CompactBatteryView" Visibility="Visible" Opacity="1" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: earbuds glyph -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="ToggleDeviceIcon_Click" ToolTip="Klik untuk ganti Headset / Mouse" Visibility="{Binding Settings.ShowAccessoryBattery, Converter={StaticResource BoolToVis}}">
                                <Grid Width="28" Height="20" VerticalAlignment="Center">
                                    <Path Data="M 5,2 C 8,2 9,5 8,9 L 8,16 C 8,17 7,18 6,18 C 5,18 4,17 4,16 L 4,10 C 2.5,9 2,6 3,4 Z" Fill="#F2FFFFFF" Margin="0,0,10,0"/>
                                    <Path Data="M 15,2 C 12,2 11,5 12,9 L 12,16 C 12,17 13,18 14,18 C 15,18 16,17 16,16 L 16,10 C 17.5,9 18,6 17,4 Z" Fill="#F2FFFFFF" Margin="6,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- Center: camera dot -->
                            <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" Background="#1AFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactCenterDot_Click" ToolTip="Klik untuk ganti mode (Baterai / Musik / Performa)">
                                <Ellipse Width="3" Height="3" Fill="#0E1726"/>
                            </Border>

                            <!-- Right: percentage + horizontal battery with fill (green, red at 20% or less) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="ToggleDeviceIcon_Click" ToolTip="Klik untuk ganti Headset / Mouse" Visibility="{Binding Settings.ShowAccessoryBattery, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Battery.ActiveDisplayDevice.BatteryPercent, StringFormat={}{0}%}"
                                           Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>

                                <Grid Width="26" Height="12" VerticalAlignment="Center">
                                    <Border CornerRadius="3.5" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,2.5,0"/>
                                    <Border CornerRadius="2" Margin="2,2,4.5,2" HorizontalAlignment="Stretch" ClipToBounds="True">
                                        <Border CornerRadius="2" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"
                                                Background="{Binding Battery.ActiveDisplayDevice.BatteryPercent, Converter={StaticResource BatteryBrush}}">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Battery.ActiveDisplayDevice.BatteryPercent, Converter={StaticResource PercentToScale}}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <!-- Terminal nub -->
                                    <Border Width="2" Height="4.5" CornerRadius="0,1.5,1.5,0" Background="#66FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Mode B: Music — artwork, title and a waveform tinted by the artwork -->
                        <Grid x:Name="CompactMusicView" Visibility="Collapsed" Opacity="0" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: rounded artwork + title/artist -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactMusicLeft_Click" ToolTip="Klik untuk Buka Pemutar Musik">
                                <Grid Width="22" Height="22">
                                    <Border CornerRadius="6" Background="#2C2C2E">
                                        <Path Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"
                                               Stretch="Uniform" Width="10" Height="10" Fill="#8E8E93"/>
                                    </Border>
                                    <Border CornerRadius="6" BorderBrush="#1AFFFFFF" BorderThickness="0.5"
                                            Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Media.AlbumArt}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Sembunyikan judul lewat Musik Minimalis" Visibility="{Binding Settings.EnableMinimalisticMusic, Converter={StaticResource BoolToVisInverted}}">
                                    <TextBlock Text="{Binding Media.SongTitle}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="92"/>
                                    <TextBlock Text="{Binding Media.ArtistName}" Foreground="#99FFFFFF" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="92" Margin="0,-1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Center: camera dot -->
                            <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" Background="#1AFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactCenterDot_Click" ToolTip="Klik untuk ganti mode (Baterai / Musik / Performa)">
                                <Ellipse Width="3" Height="3" Fill="#0E1726"/>
                            </Border>

                            <!-- Right: waveform bars in the artwork colour (macOS notch style) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="CompactMusicPlayPause_Click" ToolTip="Klik untuk Play / Pause">
                                <Rectangle x:Name="CompactEq1" Width="2.6" Height="6" Margin="1.2,0" RadiusX="1.3" RadiusY="1.3" Fill="{Binding Media.AccentBrush}" VerticalAlignment="Center"/>
                                <Rectangle x:Name="CompactEq2" Width="2.6" Height="12" Margin="1.2,0" RadiusX="1.3" RadiusY="1.3" Fill="{Binding Media.AccentBrush}" VerticalAlignment="Center"/>
                                <Rectangle x:Name="CompactEq3" Width="2.6" Height="8" Margin="1.2,0" RadiusX="1.3" RadiusY="1.3" Fill="{Binding Media.AccentBrush}" VerticalAlignment="Center"/>
                                <Rectangle x:Name="CompactEq4" Width="2.6" Height="14" Margin="1.2,0" RadiusX="1.3" RadiusY="1.3" Fill="{Binding Media.AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mode L: Live lyric line (glowing text) -->
                        <Grid x:Name="CompactLyricsView" Visibility="Collapsed" Opacity="0" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactLyrics_Click" ToolTip="Klik untuk Buka Lirik Penuh">
                                <Grid Width="22" Height="22">
                                    <Border CornerRadius="6" Background="#2C2C2E">
                                        <Path Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"
                                               Stretch="Uniform" Width="10" Height="10" Fill="#8E8E93"/>
                                    </Border>
                                    <Border CornerRadius="6" BorderBrush="#1AFFFFFF" BorderThickness="0.5"
                                            Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Media.AlbumArt}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Cursor="Hand" MouseLeftButtonDown="CompactLyrics_Click" ToolTip="Lirik Lagu Realtime (Klik untuk Buka Tab Lirik)">
                                <TextBlock x:Name="TxtCompactLyric"
                                           Text="{Binding Media.Lyrics.CurrentLyricDisplay}"
                                           Foreground="#FFFFFF"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#7FD8FF" BlurRadius="9" ShadowDepth="0" Opacity="0.95"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>

                            <!-- Equalizer bars replaced by the glowing lyric text; kept collapsed so the code-behind animation still resolves -->
                            <StackPanel Grid.Column="2" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="CompactMusicPlayPause_Click" ToolTip="Klik untuk Play / Pause">
                                <Rectangle x:Name="CompactLyricsEq1" Width="2.6" Height="6" Margin="1.2,0" RadiusX="1.3" RadiusY="1.3" Fill="{Binding Media.AccentBrush}" VerticalAlignment="Center"/>
                                <Rectangle x:Name="CompactLyricsEq2" Width="2.6" Height="12" Margin="1.2,0" RadiusX="1.3" RadiusY="1.3" Fill="{Binding Media.AccentBrush}" VerticalAlignment="Center"/>
                                <Rectangle x:Name="CompactLyricsEq3" Width="2.6" Height="8" Margin="1.2,0" RadiusX="1.3" RadiusY="1.3" Fill="{Binding Media.AccentBrush}" VerticalAlignment="Center"/>
                                <Rectangle x:Name="CompactLyricsEq4" Width="2.6" Height="14" Margin="1.2,0" RadiusX="1.3" RadiusY="1.3" Fill="{Binding Media.AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mode C: System telemetry — thin separators, system-style colours, tabular numbers -->
                        <Grid x:Name="CompactPerfView" Visibility="Collapsed" Opacity="0" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactPerf_Click" ToolTip="Klik untuk buka Performance Task Manager">
                                <TextBlock Text="{Binding Metrics.CpuPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#64D2FF" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextAlignment="Right" MinWidth="28"/>
                                <TextBlock Text="CPU" Foreground="#80FFFFFF" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" Margin="4,1,0,0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="0.5" Height="14" Fill="#26FFFFFF" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactPerf_Click" ToolTip="Klik untuk buka Performance Task Manager">
                                <TextBlock Text="{Binding Metrics.RamPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#BF5AF2" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextAlignment="Right" MinWidth="28"/>
                                <TextBlock Text="RAM" Foreground="#80FFFFFF" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" Margin="4,1,0,0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="3" Width="0.5" Height="14" Fill="#26FFFFFF" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CompactPerf_Click" ToolTip="Klik untuk buka Performance Task Manager">
                                <TextBlock Text="{Binding Metrics.GpuPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#30D158" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextAlignment="Right" MinWidth="28"/>
                                <TextBlock Text="GPU" Foreground="#80FFFFFF" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" Margin="4,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mode D & E: Jam, Siri Orb, Mic Indicator & Kucing Animasi (Matches media_1792501941831_ee2ccb5d.png) -->
                        <Grid x:Name="CompactClockMixerView" Visibility="Collapsed" Opacity="0" Margin="10,0" Cursor="Hand" MouseLeftButtonDown="CompactClock_Click" ToolTip="Audio &amp; Mic Center (Klik untuk buka Mixer)">

                            <!-- 1. Center Walking Track: Animated Dancing Nailong (Panel.ZIndex=10, in front of wave) -->
                            <Canvas x:Name="CatCanvas" Panel.ZIndex="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                                <!-- Floating Emote Bubble (Hidden) -->
                                <Border x:Name="CatEmoteBubble" Canvas.Left="60" Canvas.Top="0" 
                                        Background="#25FFFFFF" BorderBrush="#FF529A" BorderThickness="1" 
                                        CornerRadius="7" Padding="5,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="TxtCatEmote" Text="" FontSize="8.5" Foreground="#FF75A5" FontWeight="Bold"/>
                                </Border>

                                <!-- Animated Dancing Nailong Avatar (Cutout from User Upload) -->
                                <Grid x:Name="CatAvatar" Width="26" Height="28" Canvas.Left="60" Canvas.Top="1.5" 
                                      Cursor="Hand" MouseLeftButtonDown="CatAvatar_MouseDown" 
                                      ToolTip="🦖 Dinosaurus Nailong (Klik untuk ajak main!)" RenderTransformOrigin="0.5,0.9">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CatScaleTransform" ScaleX="1" ScaleY="1" CenterX="13" CenterY="26"/>
                                            <RotateTransform x:Name="CatWaddleRotate" Angle="0" CenterX="13" CenterY="26"/>
                                            <TranslateTransform x:Name="CatJumpTransform" X="0" Y="0"/>
                                            <ScaleTransform x:Name="DinoSquashTransform" ScaleX="1.0" ScaleY="1.0" CenterX="13" CenterY="26"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>

                                    <!-- Cutout Transparent Dancing Nailong Character -->
                                    <Image x:Name="CatAvatarImage" 
                                           Source="pack://application:,,,/DynamicIsland;component/Assets/nailong_dance/nailong_00.png" 
                                           Width="26" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Canvas>

                            <!-- 2. Overlay: Clock on Left, Siri Orb + Orange Mic Dot on Right -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Modern Digital Clock (e.g. 19:46) -->
                                <TextBlock Grid.Column="0" x:Name="TxtClockTime" Text="19:46"
                                           Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>

                                <!-- Right: Siri/AI Glowing Rainbow Orb & Orange Privacy Mic Dot -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Siri / AI Glowing Rainbow Orb -->
                                    <Grid x:Name="SiriOrbContainer" Width="20" Height="20" Cursor="Hand" MouseLeftButtonDown="SiriOrb_Click" ToolTip="Audio &amp; Mic Center (Klik untuk buka Mixer)" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="SiriOrbScale" ScaleX="1.0" ScaleY="1.0"/>
                                                <RotateTransform x:Name="SiriOrbRotate" Angle="0"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>

                                        <!-- Outer soft glow -->
                                        <Ellipse x:Name="SiriOrbGlow" Width="20" Height="20" Opacity="0.45">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#8A2BE2" Offset="0.0"/>
                                                    <GradientStop Color="#00FFFF" Offset="0.7"/>
                                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- Inner gradient orb -->
                                        <Ellipse x:Name="SiriOrbInner" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="SiriInnerRotate" Angle="0"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Fill>
                                                <LinearGradientBrush x:Name="SiriOrbBrush" StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#00D2FF" Offset="0.0"/>
                                                    <GradientStop Color="#BF5AF2" Offset="0.32"/>
                                                    <GradientStop Color="#FF2D55" Offset="0.68"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- Core highlight -->
                                        <Ellipse x:Name="SiriOrbCore" Width="6.5" Height="6.5" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                                    <GradientStop Color="#BF5AF2" Offset="0.6"/>
                                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Orange Microphone Indicator Dot (Matches media_1792501941831_ee2ccb5d.png) -->
                                    <Border x:Name="MicIndicatorDot" Width="7" Height="7" CornerRadius="3.5" Background="#FF9F0A"
                                            VerticalAlignment="Center" Margin="2,0,2,0"
                                            Visibility="{Binding Audio.IsMicInUse, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Audio.ActiveMicAppNames, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.95"/>
                                        </Border.Effect>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Bottom vibrant flowing rainbow wave (Layer 0: subtle glowing border accent at bottom, never touches Nailong) -->
                            <Grid Panel.ZIndex="0" VerticalAlignment="Bottom" Height="4" HorizontalAlignment="Stretch" Margin="6,0,6,0.5" IsHitTestVisible="False">
                                <Path x:Name="RainbowWavePath" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush x:Name="RainbowLineBrush" StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RainbowStop0" Color="#00D2FF" Offset="0.0"/>
                                            <GradientStop x:Name="RainbowStop1" Color="#7B42F6" Offset="0.25"/>
                                            <GradientStop x:Name="RainbowStop2" Color="#FF2D55" Offset="0.50"/>
                                            <GradientStop x:Name="RainbowStop3" Color="#FF9F0A" Offset="0.75"/>
                                            <GradientStop x:Name="RainbowStop4" Color="#00FFC6" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                    <Path.Effect>
                                        <DropShadowEffect x:Name="RainbowDropShadow" Color="#FF2D55" BlurRadius="4" ShadowDepth="0" Opacity="0.45"/>
                                    </Path.Effect>
                                </Path>
                            </Grid>
                        </Grid>
                        <!-- End of 1A. CompactHorizontalContainer -->
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 1B. VERTICAL SIDE COMPACT (DOCK LEFT / RIGHT)  -->
                        <!-- ============================================== -->
                        <Grid x:Name="CompactSideContainer" Visibility="Collapsed">
                            <!-- Side Mode C: Performa Realtime (CPU, RAM, GPU vertically stacked) -->
                            <Grid x:Name="SidePerfView" Visibility="Collapsed" Opacity="0" Margin="0,8" Cursor="Hand" MouseLeftButtonDown="CompactPerf_Click" ToolTip="Klik untuk buka Performance Task Manager">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- CPU Slot -->
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="CPU" Foreground="#00D2FF" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Metrics.CpuPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#00D2FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- RAM Slot -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="RAM" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Metrics.RamPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="#BF5AF2" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- GPU Slot -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="GPU" Foreground="{StaticResource BatteryGreen}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Metrics.GpuPercentage, Mode=OneWay, StringFormat={}{0}%}" Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode A: Battery (Device Icon + Circular Progress + %) -->
                            <Grid x:Name="SideBatteryView" Visibility="Visible" Opacity="1" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="ToggleDeviceIcon_Click" ToolTip="Klik untuk ganti Headset / Mouse">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="20" Height="15" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Path Data="M 5,2 C 8,2 9,5 8,9 L 8,16 C 8,17 7,18 6,18 C 5,18 4,17 4,16 L 4,10 C 2.5,9 2,6 3,4 Z" Fill="#FFFFFF" Margin="0,0,7,0"/>
                                        <Path Data="M 15,2 C 12,2 11,5 12,9 L 12,16 C 12,17 13,18 14,18 C 15,18 16,17 16,16 L 16,10 C 17.5,9 18,6 17,4 Z" Fill="#FFFFFF" Margin="7,0,0,0"/>
                                    </Grid>

                                    <Grid Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Ellipse Width="22" Height="22" Stroke="{StaticResource BatteryTrack}" StrokeThickness="2.5"/>
                                        <local:CircularProgress Width="22" Height="22" 
                                                                Stroke="{StaticResource BatteryGreen}" 
                                                                StrokeThickness="2.5" 
                                                                Percentage="{Binding Battery.ActiveDisplayDevice.BatteryPercent}"
                                                                StrokeStartLineCap="Round"
                                                                StrokeEndLineCap="Round"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Battery.ActiveDisplayDevice.BatteryPercent, StringFormat={}{0}%}" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               FontWeight="Bold" 
                                               FontSize="9.5" 
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode B: Pemutar Musik (Art + Mini Waves + Controls) -->
                            <Grid x:Name="SideMusicView" Visibility="Collapsed" Opacity="0" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="CompactMusicLeft_Click" ToolTip="Klik untuk Buka Pemutar Musik">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="#25FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="0.8" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Grid>
                                            <Border CornerRadius="4.5">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FA2D48" Offset="0"/>
                                                        <GradientStop Color="#1C1022" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="🎵" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill" 
                                                   Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="14" Margin="0,0,0,6">
                                        <Rectangle x:Name="SideEq1" Width="2.2" Height="5" Margin="1,0" RadiusX="1" RadiusY="1">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#FA2D48" Offset="0"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle x:Name="SideEq2" Width="2.2" Height="11" Margin="1,0" RadiusX="1" RadiusY="1">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#FA2D48" Offset="0"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle x:Name="SideEq3" Width="2.2" Height="8" Margin="1,0" RadiusX="1" RadiusY="1">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#FA2D48" Offset="0"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </StackPanel>

                                    <TextBlock Text="▶" Foreground="{StaticResource TextSecondary}" FontSize="8.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode: Lirik Lagu Realtime -->
                            <Grid x:Name="SideLyricsView" Visibility="Collapsed" Opacity="0" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="CompactLyrics_Click" ToolTip="Klik untuk Buka Lirik Penuh">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="#25FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="0.8" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Grid>
                                            <Border CornerRadius="4.5">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#BF5AF2" Offset="0"/>
                                                        <GradientStop Color="#00D2FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="🎤" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill" 
                                                   Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="LIRIK" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode D: Kucing Animasi di Tepi Layar -->
                            <Grid x:Name="SideCatView" Visibility="Collapsed" Opacity="0" ClipToBounds="True">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border x:Name="SideCatEmoteBubble" Background="#25FFFFFF" BorderBrush="#FF529A" BorderThickness="1" 
                                            CornerRadius="6" Padding="4,1" Margin="0,0,0,6" Opacity="0" HorizontalAlignment="Center">
                                        <TextBlock Text="❤️" FontSize="8" Foreground="#FF75A5" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Side Mode Animated Nailong Avatar -->
                                    <Grid x:Name="SideCatAvatar" Width="26" Height="30" Cursor="Hand" MouseLeftButtonDown="CatAvatar_MouseDown" ToolTip="🦖 Dinosaurus Nailong (Klik untuk ajak main!)" RenderTransformOrigin="0.5,0.9">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="SideCatScale" ScaleX="1" ScaleY="1" CenterX="13" CenterY="27"/>
                                                <RotateTransform x:Name="SideCatRotate" Angle="0" CenterX="13" CenterY="27"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Image x:Name="SideCatAvatarImage" 
                                               Source="pack://application:,,,/DynamicIsland;component/Assets/nailong_dance/nailong_00.png" 
                                               Width="26" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Side Mode E: Jam & Indikator Audio/Mic -->
                            <Grid x:Name="SideClockView" Visibility="Collapsed" Opacity="0" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="CompactClock_Click" ToolTip="Audio &amp; Mic Center (Klik untuk buka Mixer)">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtSideClockTime" Text="19:46" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <!-- Siri Orb -->
                                    <Grid Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#00D2FF" Offset="0.0"/>
                                                    <GradientStop Color="#BF5AF2" Offset="0.32"/>
                                                    <GradientStop Color="#FF2D55" Offset="0.68"/>
                                                    <GradientStop Color="#FF9F0A" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFFFFF" Opacity="0.8"/>
                                    </Grid>
                                    <!-- Mic Dot if in use -->
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#FF9F0A" HorizontalAlignment="Center"
                                            Visibility="{Binding Audio.IsMicInUse, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Audio.ActiveMicAppNames, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF9F0A" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                                        </Border.Effect>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>





                <!-- ============================================== -->
                <!-- 1.5 NOTIFICATION BANNER (DISCORD / STEAM / APP) -->
                <!-- ============================================== -->
                <!-- macOS-style banner: squircle app icon, bold sender, two-line body, "sekarang" stamp -->
                <Grid x:Name="NotificationBannerView" Visibility="Collapsed" Opacity="0" Margin="18,0,18,2" Cursor="Hand"
                      RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="NotificationBanner_Click">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NotifScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="NotifTranslate" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon (squircle with soft top highlight) -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" x:Name="NotifIconBadge" Background="#5865F2"
                            VerticalAlignment="Center" Margin="0,0,10,0" BorderBrush="#26FFFFFF" BorderThickness="0.8">
                        <Grid>
                            <Border CornerRadius="9">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="TxtNotifIcon" Text="💬" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- Real app logo (WhatsApp / Discord) replaces the emoji when available -->
                            <Image x:Name="NotifIconImage" Stretch="UniformToFill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <!-- Sender + message -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtNotifTitle" Text="Discord" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtNotifBody" Text="hey bro login CS2 let's play premier!" Foreground="#E5E5EA" FontSize="11"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" LineHeight="14" LineStackingStrategy="BlockLineHeight" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- App name + time, close on the right -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtNotifSubtitle" Text="Discord" Foreground="#8E8E93" FontSize="9.5" FontWeight="Medium" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                        <TextBlock Text="sekarang" Foreground="#6E6E73" FontSize="9" HorizontalAlignment="Right" Margin="0,1,0,3"/>
                        <Border Width="18" Height="18" CornerRadius="9" Background="#26FFFFFF" HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="BtnDismissNotif_Click" ToolTip="Tutup Notifikasi">
                            <TextBlock Text="✕" FontSize="8" Foreground="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============================================== -->
                <!-- PONI HUD: VOLUME & BRIGHTNESS ON-SCREEN BANNER -->
                <!-- ============================================== -->
                <Border x:Name="HudBanner" Visibility="Collapsed" Opacity="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#25FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="14"
                        Padding="14,4" Height="28" Margin="0,0,0,0">
                    <Grid Width="160">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtHudIcon" Grid.Column="0" Text="&#xE995;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FFFFFF" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#25FFFFFF" VerticalAlignment="Center">
                            <ProgressBar x:Name="BarHudLevel" Height="5" BorderThickness="0" Background="Transparent" Value="50" Maximum="100" Foreground="#0A84FF"/>
                        </Border>
                        <TextBlock x:Name="TxtHudPercent" Grid.Column="2" Text="50%" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>


                <!-- ============================================== -->
                <!-- 2. EXPANDED NOTCH WITH ALL PREVIOUS MENUS      -->

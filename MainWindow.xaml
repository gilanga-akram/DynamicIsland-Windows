                                    <Button x:Name="BtnBattery" Visibility="Collapsed" Click="BtnBattery_Click"/>
                                    <Button x:Name="BtnMusic" Visibility="Collapsed" Click="BtnMusic_Click"/>
                                    <Button x:Name="BtnAgenda" Visibility="Collapsed" Click="BtnAgenda_Click"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Right: Clock/Date, Refresh, Battery, Location/Pin (Matches Poni Screenshot) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Digital Clock & Date (Matches Poni '1:33 PM  Mon, Oct 26') -->
                            <TextBlock Text="{Binding Metrics.HeaderTimeFormatted, FallbackValue='1:33 PM'}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Metrics.HeaderDateFormatted, FallbackValue='Mon, Oct 26'}" Foreground="#8E8E93" FontSize="11" Margin="5,0,8,0" VerticalAlignment="Center"/>

                            <!-- Refresh / Sync Button -->
                            <Button Style="{StaticResource GhostBtn}" Padding="3,2" Margin="1,0" Click="BtnQuickSync_Click" ToolTip="Refresh">
                                <Path Stretch="Uniform" Width="11" Height="11" Fill="#FFFFFF" Opacity="0.85" Data="M17.65,6.35C16.2,4.9,14.21,4,12,4c-4.42,0-7.99,3.58-7.99,8s3.57,8,7.99,8c3.73,0,6.84-2.55,7.73-6h-2.08c-.82,2.33-3.04,4-5.65,4-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14.69,4.22,1.78L13,11h7V4l-2.35,2.35z"/>
                            </Button>

                            <!-- Orange Battery Badge -->
                            <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center" ToolTip="Baterai"><Border Width="22" Height="11" CornerRadius="3" BorderBrush="#B3FFFFFF" BorderThickness="1" Padding="1"><Border Background="#FFFFFF" CornerRadius="1.5" Width="18" HorizontalAlignment="Left"><Border.LayoutTransform><ScaleTransform ScaleX="{Binding Metrics.BatteryPercentage, Converter={StaticResource PercentToScale}, FallbackValue=0.8}"/></Border.LayoutTransform></Border></Border><Border Width="1.5" Height="4" Background="#B3FFFFFF" CornerRadius="0,1,1,0" VerticalAlignment="Center"/></StackPanel>

                            <!-- Location / Pin Toggle -->
                            <Button x:Name="PinButton" Style="{StaticResource GhostBtn}" Padding="1" Margin="2,0,0,0" Click="PinButton_Click" ToolTip="Sematkan island agar tetap terbuka">
                                <!-- Pinned state is shown by a blue filled pin on a soft blue chip (see UpdatePinVisual) -->
                                <Border x:Name="PinBadge" CornerRadius="6" Padding="4,3" Background="Transparent">
                                    <TextBlock x:Name="PinIcon" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFF" Opacity="0.6"/>
                                </Border>
                            </Button>

                            <!-- Collapse Button -->
                            <Button Style="{StaticResource GhostBtn}" Padding="3,2" Margin="2,0,0,0" Click="CollapseButton_Click" ToolTip="Tutup ke Notch">
                                <Path Stretch="Uniform" Width="8" Height="8" Fill="#8E8E93" Data="M7.41,15.41L12,10.83l4.59,4.58L18,14l-6-6-6,6z"/>
                            </Button>
                        </StackPanel>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- SCROLLABLE CONTENT BODY (Fits smaller island)  -->
                    <!-- ============================================== -->
                    <ScrollViewer x:Name="ContentScrollViewer" 
                                  Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  PreviewMouseWheel="ContentScrollViewer_PreviewMouseWheel"
                                  Focusable="False">
                        <Grid>
                            <!-- VIEW 0: HOME / MUSIC + CALENDAR + MIRROR (PONI SCREENSHOT 1) -->
                            <Grid x:Name="ViewHome" Visibility="Visible" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="290" /> <!-- Col 0: Music Player Card -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="220" /> <!-- Col 1: Calendar / Agenda Card -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="*" />   <!-- Col 2: Mirror / Camera Quick Launch -->
                                </Grid.ColumnDefinitions>

                                <!-- COL 0: NOW PLAYING CARD (same design as the Lyrics tab: blurred artwork backdrop, big cover, circle transport) -->
                                <Border x:Name="HomeMusicShell" Grid.Column="0" CornerRadius="18" Background="#FF1E1E20" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="0.8" Margin="0,0,6,0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.OpacityMask>
                                            <VisualBrush Stretch="None">
                                                <VisualBrush.Visual>
                                                    <Border Background="Black" CornerRadius="18"
                                                            Width="{Binding ActualWidth, ElementName=HomeMusicShell}"
                                                            Height="{Binding ActualHeight, ElementName=HomeMusicShell}"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Grid.OpacityMask>
                                        <Border CornerRadius="18" Opacity="0.55" Margin="-30" CacheMode="BitmapCache" IsHitTestVisible="False">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Media.AlbumArt}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                            <Border.Effect>
                                                <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border CornerRadius="18" Background="#99000000" IsHitTestVisible="False"/>

                                        <Grid Margin="14,12,14,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="64" Height="64" Margin="0,0,12,0">
                                                    <Border CornerRadius="10" Background="#2C2C2E">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
                                                        </Border.Effect>
                                                        <Path Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"
                                                              Stretch="Uniform" Width="22" Height="22" Fill="#99EBEBF5"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="10" BorderBrush="#1AFFFFFF" BorderThickness="0.5"
                                                            Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Media.AlbumArt}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Media.SongTitle, TargetNullValue='Tidak ada yang diputar', FallbackValue='Tidak ada yang diputar'}"
                                                               Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Media.ArtistName, TargetNullValue='Putar sesuatu...', FallbackValue='Putar sesuatu...'}"
                                                               Foreground="#A6FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Media.SourceApp}" Foreground="#66FFFFFF" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Media.SourceApp}" Value="Now Playing">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                <Slider x:Name="SliderMediaSeek" Style="{StaticResource NowPlayingSlider}" Minimum="0" Maximum="100"
                                                        Value="{Binding Media.TimelineProgress, Mode=OneWay}"
                                                        PreviewMouseDown="SliderMediaSeek_PreviewMouseDown"
                                                        PreviewMouseUp="SliderMediaSeek_PreviewMouseUp"/>
                                                <Grid Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Media.CurrentPosition, FallbackValue='0:00'}" Foreground="#80FFFFFF" FontSize="9" FontWeight="Medium" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding Media.TotalDuration, FallbackValue='-0:00'}" Foreground="#80FFFFFF" FontSize="9" FontWeight="Medium" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>

                                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource MacCircleBtn}" Width="34" Height="34" Click="MediaPrev_Click" ToolTip="Sebelumnya">
                                                        <Path Stretch="Uniform" Width="17" Height="12" Fill="#FFFFFF" Data="M11,18V6l-8.5,6 8.5,6zm.5-6l8.5,6V6l-8.5,6z"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MacCircleBtn}" Width="40" Height="40" Margin="14,0" Click="MediaPlayPause_Click" ToolTip="Putar / Jeda">
                                                        <Grid>
                                                            <Path Stretch="Uniform" Width="16" Height="18" Fill="#FFFFFF" Data="M8,5v14l11-7z" Margin="3,0,0,0"
                                                                  Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisInverted}}"/>
                                                            <Path Stretch="Uniform" Width="15" Height="18" Fill="#FFFFFF" Data="M6,19h4V5H6v14zm8-14v14h4V5h-4z"
                                                                  Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Style="{StaticResource MacCircleBtn}" Width="34" Height="34" Click="MediaNext_Click" ToolTip="Berikutnya">
                                                        <Path Stretch="Uniform" Width="17" Height="12" Fill="#FFFFFF" Data="M4,18l8.5-6L4,6v12zm9-12v12l8.5-6L13,6z"/>
                                                    </Button>
                                                </StackPanel>
                                                <Button Style="{StaticResource MacCircleBtn}" Width="28" Height="28" HorizontalAlignment="Right" Click="BtnLyrics_Click" ToolTip="Lirik Lagu (Synced Lyrics)">
                                                    <Path Stretch="Uniform" Width="12" Height="12" Fill="#0A84FF" Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"/>
                                                </Button>
                                            </Grid>

                                            <Border Grid.Row="3" Background="#1FFFFFFF" CornerRadius="9" Padding="8,4" Margin="0,8,0,0"
                                                    Cursor="Hand" MouseLeftButtonDown="KaraokePreview_Click" ToolTip="Klik untuk buka Tampilan Lirik Penuh">
                                                <Grid>
                                                    <TextBlock Text="{Binding Media.Lyrics.CurrentLyricText, FallbackValue='♪'}"
                                                               Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Media.Lyrics.StatusMessage, FallbackValue='Lirik Lagu'}"
                                                               Foreground="#99EBEBF5" FontSize="10"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVisInverted}}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Rectangle Grid.Column="1" Fill="Transparent" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COL 1: CALENDAR / AGENDA CARD -->
                                <Border Grid.Column="2" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,8" Margin="6,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Month Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Metrics.AgendaMonthTitle}" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold"/>
                                            <Button Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Padding="2" Click="BtnAddEvent_Click" ToolTip="Tambah Agenda">
                                                <TextBlock Text="+" FontSize="11" Foreground="#99EBEBF5"/>
                                            </Button>
                                        </Grid>

                                        <!-- Days of Week Row -->
                                        <ItemsControl Grid.Row="1" Margin="0,2,0,2" ItemsSource="{Binding Metrics.AgendaHeaders}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#99EBEBF5" FontSize="9.5" HorizontalAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                                        <!-- Dates Row -->
                                        <ItemsControl Grid.Row="2" Margin="0,2,0,4" ItemsSource="{Binding Metrics.AgendaWeek}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border x:Name="Bd" CornerRadius="9" Width="18" Height="18" HorizontalAlignment="Center" Background="Transparent"><TextBlock x:Name="Tx" Text="{Binding Number}" Foreground="#CCEBEBF5" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsSunday}" Value="True"><Setter TargetName="Tx" Property="Foreground" Value="#FF453A"/></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF453A"/><Setter TargetName="Tx" Property="Foreground" Value="#FFFFFF"/><Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                                        <!-- Event Subtext & Connect Link -->
                                        <StackPanel Grid.Row="3" Margin="0,2,0,0">
                                            <TextBlock Text="No new event yet" Foreground="#99EBEBF5" FontSize="9" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Connect Google / Outlook calendar" Foreground="#0A84FF" FontSize="9.5" HorizontalAlignment="Center" Cursor="Hand" Margin="0,2,0,0" MouseLeftButtonDown="BtnConnectCalendar_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Rectangle Grid.Column="3" Fill="Transparent" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COL 2: MIRROR QUICK LAUNCH CARD -->
                                <Border Grid.Column="4" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="8" Margin="6,0,0,0">
                                    <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchCamera_Click" ToolTip="Buka Kamera / Mirror" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                                                <Path Stretch="Uniform" Width="18" Height="18" Fill="#FFFFFF" Data="M18,10.48V6c0-1.1-.9-2-2-2H4c-1.1,0-2,.9-2,2v12c0,1.1.9,2,2,2h12c1.1,0,2-.9,2-2v-4.48l4,3.98v-11l-4,3.5z"/>
                                            </Border>
                                            <TextBlock Text="Mirror" Foreground="#CCEBEBF5" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>

                            <!-- VIEW LYRICS: REALTIME SYNCED LYRICS (APPLE MUSIC STYLE) -->
                            <Grid x:Name="ViewLyrics" Visibility="Collapsed" Margin="0,0,0,0">
                                <!-- macOS Apple Music style: one rounded panel over a blurred album-art backdrop -->
                                <Border x:Name="LyricsPanelShell" CornerRadius="14" Background="#14FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0.5" ClipToBounds="True">
                                    <Grid>
                                        <!-- Rounded clip so the blurred artwork never spills past the corners -->
                                        <Grid.OpacityMask>
                                            <VisualBrush Stretch="None">
                                                <VisualBrush.Visual>
                                                    <Border Background="Black" CornerRadius="14"
                                                            Width="{Binding ActualWidth, ElementName=LyricsPanelShell}"
                                                            Height="{Binding ActualHeight, ElementName=LyricsPanelShell}"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Grid.OpacityMask>
                                        <!-- Ambient blurred artwork -->
                                        <Border CornerRadius="14" Opacity="0.55" Margin="-30" CacheMode="BitmapCache" IsHitTestVisible="False">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Media.AlbumArt}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                            <Border.Effect>
                                                <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border CornerRadius="14" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#99000000" Offset="0"/>
                                                    <GradientStop Color="#B3000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Grid Margin="14,12,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="214" /> <!-- Now Playing -->
                                                <ColumnDefinition Width="Auto" /> <!-- Hairline -->
                                                <ColumnDefinition Width="*" />   <!-- Lyrics -->
                                            </Grid.ColumnDefinitions>

                                            <!-- ============ NOW PLAYING ============ -->
                                            <Grid Grid.Column="0" Margin="0,0,14,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Artwork with soft shadow (ImageBrush so the corners stay rounded) -->
                                                    <Grid Width="64" Height="64" Margin="0,0,12,0">
                                                        <Border CornerRadius="10" Background="#2C2C2E">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
                                                            </Border.Effect>
                                                            <Path Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"
                                                                  Stretch="Uniform" Width="22" Height="22" Fill="#99EBEBF5"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border CornerRadius="10" BorderBrush="#1AFFFFFF" BorderThickness="0.5"
                                                                Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Media.AlbumArt}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Media.SongTitle, TargetNullValue='Tidak ada yang diputar', FallbackValue='Tidak ada yang diputar'}"
                                                                   Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Media.ArtistName, TargetNullValue='Putar sesuatu...', FallbackValue='Putar sesuatu...'}"
                                                                   Foreground="#A6FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Media.SourceApp}" Foreground="#66FFFFFF" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Media.SourceApp}" Value="Now Playing">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Scrubber + times underneath (Control Center layout) -->
                                                <StackPanel Grid.Row="2" Margin="0,0,0,2">
                                                    <Slider Style="{StaticResource NowPlayingSlider}" Minimum="0" Maximum="100"
                                                            Value="{Binding Media.TimelineProgress, Mode=OneWay}"
                                                            PreviewMouseDown="SliderMediaSeek_PreviewMouseDown"
                                                            PreviewMouseUp="SliderMediaSeek_PreviewMouseUp"/>
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="{Binding Media.CurrentPosition, FallbackValue='0:00'}" Foreground="#80FFFFFF" FontSize="9" FontWeight="Medium" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding Media.TotalDuration, FallbackValue='-0:00'}" Foreground="#80FFFFFF" FontSize="9" FontWeight="Medium" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Transport -->
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource MacCircleBtn}" Width="34" Height="34" Click="MediaPrev_Click" ToolTip="Sebelumnya">
                                                        <Path Stretch="Uniform" Width="17" Height="12" Fill="#FFFFFF" Data="M11,18V6l-8.5,6 8.5,6zm.5-6l8.5,6V6l-8.5,6z"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MacCircleBtn}" Width="40" Height="40" Margin="14,0" Click="MediaPlayPause_Click" ToolTip="Putar / Jeda">
                                                        <Grid>
                                                            <Path Stretch="Uniform" Width="16" Height="18" Fill="#FFFFFF" Data="M8,5v14l11-7z" Margin="3,0,0,0"
                                                                  Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisInverted}}"/>
                                                            <Path Stretch="Uniform" Width="15" Height="18" Fill="#FFFFFF" Data="M6,19h4V5H6v14zm8-14v14h4V5h-4z"
                                                                  Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Style="{StaticResource MacCircleBtn}" Width="34" Height="34" Click="MediaNext_Click" ToolTip="Berikutnya">
                                                        <Path Stretch="Uniform" Width="17" Height="12" Fill="#FFFFFF" Data="M4,18l8.5-6L4,6v12zm9-12v12l8.5-6L13,6z"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <Rectangle Grid.Column="1" Fill="#1AFFFFFF" Width="0.5" Margin="0,4"/>

                                            <!-- ============ LYRICS ============ -->
                                            <Grid Grid.Column="2" Margin="14,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header: title + source on the left, sync capsule and actions on the right -->
                                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Lirik" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Media.Lyrics.LyricsSource, StringFormat='  ·  {0}'}" Foreground="#73FFFFFF" FontSize="10" VerticalAlignment="Center"
                                                                   Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Sync offset capsule (all five calibration steps kept) -->
                                                        <Border Background="#1FFFFFFF" CornerRadius="10" Padding="2,1" Margin="0,0,6,0"
                                                                Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Style="{StaticResource MacCircleBtn}" Width="20" Height="18" Click="BtnOffsetMinusLarge_Click" ToolTip="Tunda lirik 2 detik (lirik terlalu cepat)">
                                                                    <TextBlock Text="«" FontSize="11" Foreground="#B3FFFFFF" Margin="0,-2,0,0"/>
                                                                </Button>
                                                                <Button Style="{StaticResource MacCircleBtn}" Width="18" Height="18" Click="BtnOffsetMinusSmall_Click" ToolTip="Tunda lirik 0,5 detik">
                                                                    <TextBlock Text="‹" FontSize="12" Foreground="#B3FFFFFF" Margin="0,-2,0,0"/>
                                                                </Button>
                                                                <Button Style="{StaticResource MacCircleBtn}" Width="Auto" Height="18" Padding="0" Click="BtnOffsetReset_Click" ToolTip="Klik untuk reset sinkronisasi ke 0">
                                                                    <TextBlock Text="{Binding Media.Lyrics.OffsetFormatted}" Foreground="#FFFFFF" FontSize="9" FontWeight="Medium" Margin="6,0"/>
                                                                </Button>
                                                                <Button Style="{StaticResource MacCircleBtn}" Width="18" Height="18" Click="BtnOffsetPlusSmall_Click" ToolTip="Percepat lirik 0,5 detik">
                                                                    <TextBlock Text="›" FontSize="12" Foreground="#B3FFFFFF" Margin="0,-2,0,0"/>
                                                                </Button>
                                                                <Button Style="{StaticResource MacCircleBtn}" Width="20" Height="18" Click="BtnOffsetPlusLarge_Click" ToolTip="Percepat lirik 2 detik (lirik terlambat)">
                                                                    <TextBlock Text="»" FontSize="11" Foreground="#B3FFFFFF" Margin="0,-2,0,0"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Translation on/off (persisted); lit while on -->
                                                        <Button Width="22" Height="22" Margin="0,0,2,0" Click="BtnLyricsTranslate_Click" ToolTip="Tampilkan / sembunyikan terjemahan lirik"
                                                                Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MacCircleBtn}">
                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Media.Lyrics.ShowTranslation}" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xF2B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#B3FFFFFF"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Media.Lyrics.ShowTranslation}" Value="True">
                                                                                <Setter Property="Foreground" Value="{Binding Media.AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Media.Lyrics.IsTranslating}" Value="True">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard x:Name="TranslatePulse">
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <StopStoryboard BeginStoryboardName="TranslatePulse"/>
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>

                                                        <Button Style="{StaticResource MacCircleBtn}" Width="22" Height="22" Click="BtnRetryLyrics_Click" ToolTip="Muat ulang lirik">
                                                            <Path Stretch="Uniform" Width="10" Height="10" Fill="#B3FFFFFF" Data="M17.65,6.35C16.2,4.9,14.21,4,12,4c-4.42,0-7.99,3.58-7.99,8s3.57,8,7.99,8c3.73,0,6.84-2.55,7.73-6h-2.08c-.82,2.33-3.04,4-5.65,4-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14.69,4.22,1.78L13,11h7V4l-2.35,2.35z"/>
                                                        </Button>
                                                        <Button Style="{StaticResource MacCircleBtn}" Width="22" Height="22" Margin="2,0,0,0" Click="BtnHome_Click" ToolTip="Tutup lirik">
                                                            <Path Stretch="Uniform" Width="8" Height="8" Fill="#B3FFFFFF" Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <!-- State 1: Synced lyrics (Apple Music style: big lines, active line bright, no timestamps) -->
                                                    <ScrollViewer x:Name="LyricsScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                                  Height="128" PanningMode="VerticalOnly" PreviewMouseWheel="LyricsScrollViewer_PreviewMouseWheel"
                                                                  Visibility="{Binding Media.Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}">
                                                        <ScrollViewer.OpacityMask>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0.0"/>
                                                                <GradientStop Color="#FF000000" Offset="0.18"/>
                                                                <GradientStop Color="#FF000000" Offset="0.75"/>
                                                                <GradientStop Color="#00000000" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </ScrollViewer.OpacityMask>
                                                        <ItemsControl x:Name="LyricsItemsControl" ItemsSource="{Binding Media.Lyrics.Lines}" Margin="0,30,0,70">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource GhostBtn}" Opacity="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                            Padding="8,4" Margin="0,1" Click="LyricLine_Click" Cursor="Hand" ToolTip="Klik untuk lompat ke baris ini">
                                                                        <Grid HorizontalAlignment="Stretch">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <Grid VerticalAlignment="Center">
                                                                                <!-- Base line (dim); the active line keeps a dim copy underneath the karaoke fill -->
                                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Foreground" Value="#59FFFFFF"/>
                                                                                            <Setter Property="FontSize" Value="13"/>
                                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="#40FFFFFF"/>
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="#59FFFFFF"/>
                                                                                                    <Setter Property="FontSize" Value="15"/>
                                                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>

                                                                                <!-- Glowing copy that lights up from left to right while the line is sung (replaces the old progress bar) -->
                                                                                <Border IsHitTestVisible="False">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <Border.Effect>
                                                                                        <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="14" Opacity="0.85"/>
                                                                                    </Border.Effect>
                                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                                                                               OpacityMask="{Binding Progress, Converter={StaticResource KaraokeMask}}"/>
                                                                                </Border>
                                                                            </Grid>

                                                                            <!-- "Sync to this line" appears only while hovering the row -->
                                                                            <Button Grid.Column="1" Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                    Click="BtnSyncThisLine_Click" ToolTip="Selaraskan lirik: baris ini sedang dinyanyikan sekarang">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button" BasedOn="{StaticResource MacCircleBtn}">
                                                                                        <Setter Property="Opacity" Value="0"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                                                <Setter Property="Opacity" Value="1"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                                <Path Stretch="Uniform" Width="9" Height="10" Fill="#CCFFFFFF" Data="M7,2v11h3v9l7-12h-4l4-8z"/>
                                                                            </Button>

                                                                            <!-- Translation of the line -->
                                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Translation}" TextWrapping="Wrap" Margin="0,3,0,2" LineHeight="15" LineStackingStrategy="BlockLineHeight">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="#6B9AD8FF"/>
                                                                                        <Setter Property="FontSize" Value="11"/>
                                                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Translation}" Value="">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#FFB8E4FF"/>
                                                                                                <Setter Property="FontSize" Value="12.5"/>
                                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                                <Setter Property="Effect">
                                                                                                    <Setter.Value>
                                                                                                        <DropShadowEffect Color="#7FD8FF" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                                                                                    </Setter.Value>
                                                                                                </Setter>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>

                                                    <!-- State 2: Loading (macOS spinner) -->
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Visibility="{Binding Media.Lyrics.IsLoading, Converter={StaticResource BoolToVis}}">
                                                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="#B3FFFFFF" StrokeThickness="2.2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                                              Data="M 9,1 A 8,8 0 1 1 1,9" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform/>
                                                            </Path.RenderTransform>
                                                            <Path.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                             From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Path.Triggers>
                                                        </Path>
                                                        <TextBlock Text="{Binding Media.Lyrics.StatusMessage, FallbackValue='Memuat lirik...'}"
                                                                   Foreground="#99FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                    </StackPanel>

                                                    <!-- State 3: No lyrics -->
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Media.Lyrics.HasLyrics}" Value="False"/>
                                                                            <Condition Binding="{Binding Media.Lyrics.IsLoading}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Border Width="34" Height="34" CornerRadius="17" Background="#1FFFFFFF" HorizontalAlignment="Center">
                                                            <Path Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"
                                                                  Stretch="Uniform" Width="14" Height="14" Fill="#99FFFFFF"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Media.Lyrics.StatusMessage, FallbackValue='Lirik tidak ditemukan'}"
                                                                   Foreground="#99FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                                                        <Button Content="Coba Lagi" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF"
                                                                FontSize="10" FontWeight="Medium" Padding="12,3" HorizontalAlignment="Center" Click="BtnRetryLyrics_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- VIEW 1: NOOK 4-COLUMN CONTROL CENTER DASHBOARD (THREADS / ATOLL REFERENCE) -->
                            <Grid x:Name="ViewNook" Visibility="Collapsed" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" /> <!-- Col 0: Weather & Prayer Card -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="156" /> <!-- Col 1: Quick Toggles (Capsules + Buttons) -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="230" /> <!-- Col 2: Apps Grid (2x3 Quick Launch) -->
                                    <ColumnDefinition Width="1" />   <!-- Divider -->
                                    <ColumnDefinition Width="136" /> <!-- Col 3: Day Progress Card -->
                                </Grid.ColumnDefinitions>

                                <!-- COLUMN 0: WEATHER CARD (Screenshot 2: Jakarta 32° Light Drizzle) -->
                                <Border Grid.Column="0" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,8" Margin="0,0,4,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Location Pin + JAKARTA -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Path Stretch="Uniform" Width="7" Height="9" Fill="#99EBEBF5" Margin="0,0,3,0" Data="M16,12V4h1V2H7v2h1v8l-2,2v2h5v6l1,1 1-1v-6h5v-2l-2-2z"/>
                                            <TextBlock Text="{Binding Metrics.WeatherLocation, FallbackValue='JAKARTA'}" Foreground="#99EBEBF5" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Rain Cloud Icon + 32° -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,2">
                                            <Path Stretch="Uniform" Width="20" Height="18" Fill="{Binding Metrics.WeatherIconBrush}" Margin="0,0,6,0" Data="{Binding Metrics.WeatherIcon}"/>
                                            <TextBlock Text="{Binding Metrics.WeatherTemp, FallbackValue='--°'}" Foreground="#FFFFFF" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Weather Condition: Light Drizzle -->
                                        <TextBlock Grid.Row="2" Text="{Binding Metrics.WeatherCondition, FallbackValue='Memuat cuaca...'}" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                        <!-- High / Low -->
                                        <TextBlock Grid.Row="3" Text="{Binding Metrics.WeatherHighLow, FallbackValue=''}" Foreground="#99EBEBF5" FontSize="9" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>

                                <Rectangle Grid.Column="1" Fill="Transparent" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COLUMN 1: QUICK TOGGLES (Screenshot 2: 8 Capsule Pills) -->
                                <Grid Grid.Column="2" Margin="5,0,4,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <TextBlock Grid.Row="0" Text="QUICK TOGGLES" Foreground="#99EBEBF5" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,4"/><TextBlock x:Name="TxtNookWifiSsid" Grid.Row="0" Text="" HorizontalAlignment="Right" Foreground="#99EBEBF5" FontSize="9" Margin="0,0,2,4" MaxWidth="120" TextTrimming="CharacterEllipsis" Visibility="{Binding Settings.ShowWifiSsid, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Row 1: 4 Vertical Capsule Pills -->
                                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,4">
                                        <!-- Wi-Fi Toggle Capsule -->
                                        <Button x:Name="BtnToggleWifi" Style="{StaticResource GhostBtn}" Click="BtnToggleWifi_Click" MouseRightButtonUp="BtnToggleWifi_RightClick" ToolTip="Wi-Fi (klik: nyala/mati, klik kanan: daftar jaringan)" Margin="1.5,0">
                                            <Border x:Name="PillWifi" Width="34" Height="34" CornerRadius="17" Background="#0A84FF" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12,4C7.31,4,3.07,5.9,0,8.98L12,21l12-12.02C20.93,5.9,16.69,4,12,4z"/>
                                            </Border>
                                        </Button>

                                        <!-- Bluetooth Toggle Capsule -->
                                        <Button x:Name="BtnToggleBluetooth" Style="{StaticResource GhostBtn}" Click="BtnToggleBluetooth_Click" MouseRightButtonUp="BtnToggleBluetooth_RightClick" ToolTip="Bluetooth (klik: nyala/mati, klik kanan: pengaturan)" Margin="1.5,0">
                                            <Border x:Name="PillBluetooth" Width="34" Height="34" CornerRadius="17" Background="#0A84FF" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="11" Height="14" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M17.71,7.71L12,2h-1v7.59L6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 11,14.41V22h1l5.71-5.71-4.3-4.29 4.3-4zM13,5.83l1.88,1.88L13,9.59V5.83zm1.88,10.46L13,18.17v-3.76l1.88,1.88z"/>
                                            </Border>
                                        </Button>

                                        <!-- Caffeine (Keep Screen Awake) Capsule -->
                                        <Button x:Name="BtnToggleCaffeine" Style="{StaticResource GhostBtn}" Click="BtnToggleCaffeine_Click" ToolTip="Caffeine (Cegah Layar Tidur)" Margin="1.5,0">
                                            <Border x:Name="PillCaffeine" Width="34" Height="34" CornerRadius="17" Background="#48484A" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M20,3H4v10c0,2.21,1.79,4,4,4h6c2.21,0,4-1.79,4-4v-3h2c1.1,0,2-.9,2-2V5c0-1.1-.9-2-2-2zm0,5h-2V5h2v3zM2,21h18v-2H2v2z"/>
                                            </Border>
                                        </Button>

                                        <!-- Dark Mode Capsule -->
                                        <Button x:Name="BtnToggleDarkMode" Style="{StaticResource GhostBtn}" Click="BtnToggleDarkMode_Click" ToolTip="Mode Gelap / Terang (Dark Mode)" Margin="1.5,0">
                                            <Border x:Name="PillDarkMode" Width="34" Height="34" CornerRadius="17" Background="#48484A" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12.3,2C6.9,2.5,2.7,6.9,2.7,12.3c0,5.5,4.5,10,10,10c5.4,0,9.8-4.2,10.3-9.6c-0.9,0.3-1.8,0.5-2.8,0.5c-4.4,0-8-3.6-8-8C12.2,4.1,12.5,3,12.3,2z"/>
                                            </Border>
                                        </Button>
                                    </UniformGrid>

                                    <!-- Row 2: 4 Vertical Capsule Pills (Mixer, Mute, Crop, Lock) -->
                                    <UniformGrid Grid.Row="2" Columns="4">
                                        <!-- Audio Mixer Button -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnQuickMicMute_Click" ToolTip="Audio Mixer &amp; Volume" Margin="1.5,0">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="#48484A" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M3,17v2h6v-2H3zM3,5v2h10V5H3zm10,16v-2h8v-2h-8v-2h-2v6h2zM7,9v2H3v2h4v2h2V9H7zm14,4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
                                            </Border>
                                        </Button>

                                        <!-- Speaker Mute Button -->
                                        <Button Style="{StaticResource GhostBtn}" Click="ToolMute_Click" ToolTip="Bisukan / Aktifkan Audio" Margin="1.5,0">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="#48484A" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="13" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M3,9v6h4l5,5V4L7,9H3zm13.5,3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73,2.5-2.25,2.5-4.02zM14,3.23v2.06c2.89,0.86,5,3.54,5,6.71s-2.11,5.85-5,6.71v2.06c4.01-0.91,7-4.49,7-8.77s-2.99-7.86-7-8.77z"/>
                                            </Border>
                                        </Button>

                                        <!-- Screenshot Camera Button -->
                                        <Button Style="{StaticResource GhostBtn}" Click="ToolScreenshot_Click" ToolTip="Cuplikan Layar (Screenshot)" Margin="1.5,0">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="#48484A" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="13" Height="11" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12,12m-3.2,0a3.2,3.2,0,1,0,6.4,0a3.2,3.2,0,1,0,-6.4,0 M9,2L7.17,4H4c-1.1,0-2,0.9-2,2v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6c0-1.1-0.9-2-2-2h-3.17L15,2H9zm3,15c-2.76,0-5-2.24-5-5s2.24-5,5-5,5,2.24,5,5-2.24,5-5,5z"/>
                                            </Border>
                                        </Button>

                                        <!-- Lock Screen Button -->
                                        <Button Style="{StaticResource GhostBtn}" Click="ToolLock_Click" ToolTip="Kunci Windows (Lock Screen)" Margin="1.5,0">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="#48484A" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Path Stretch="Uniform" Width="11" Height="13" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,.9-2,2v10c0,1.1.9,2,2,2h12c1.1,0,2-.9,2-2V10c0-1.1-.9-2-2-2zm-6,9c-1.1,0-2-.9-2-2s.9-2,2-2 2,.9,2,2-.9,2-2,2zm3.1-9H8.9V6c0-1.71,1.39-3.1,3.1-3.1 1.71,0,3.1,1.39,3.1,3.1v2z"/>
                                            </Border>
                                        </Button>
                                    </UniformGrid>
                                </Grid>

                                <Rectangle Grid.Column="3" Fill="Transparent" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COLUMN 2: APPS GRID (Screenshot 2: 2x3 Stacked Icons) -->
                                <Grid Grid.Column="4" Margin="5,0,4,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="APPS" Foreground="#99EBEBF5" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,3"/>

                                    <UniformGrid Grid.Row="1" Rows="2" Columns="3">
                                        <!-- 1. File Explorer -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchExplorer_Click" ToolTip="File Explorer" Margin="1.5,1">
                                            <Border Background="Transparent" CornerRadius="8" Padding="2,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoBlue}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <TextBlock Text="File Expl..." Foreground="#E6EBEBF5" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 2. Console -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchTerminal_Click" ToolTip="Console / Terminal" Margin="1.5,1">
                                            <Border Background="Transparent" CornerRadius="8" Padding="2,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoGray}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <TextBlock Text="Console" Foreground="#E6EBEBF5" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 3. Calculator -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchCalc_Click" ToolTip="Calculator" Margin="1.5,1">
                                            <Border Background="Transparent" CornerRadius="8" Padding="2,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoOrange}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <TextBlock Text="Calculator" Foreground="#E6EBEBF5" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 4. Notepad -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchNotepad_Click" ToolTip="Notepad" Margin="1.5,1">
                                            <Border Background="Transparent" CornerRadius="8" Padding="2,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoTeal}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <TextBlock Text="Notepad" Foreground="#E6EBEBF5" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 5. Task Manager -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchTaskmgr_Click" ToolTip="Task Manager" Margin="1.5,1">
                                            <Border Background="Transparent" CornerRadius="8" Padding="2,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoGreen}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <TextBlock Text="Task Ma..." Foreground="#E6EBEBF5" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- 6. Settings -->
                                        <Button Style="{StaticResource GhostBtn}" Click="BtnLaunchSettings_Click" ToolTip="Settings" Margin="1.5,1">
                                            <Border Background="Transparent" CornerRadius="8" Padding="2,2">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoGray}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <TextBlock Text="Settings" Foreground="#E6EBEBF5" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </UniformGrid>
                                </Grid>

                                <Rectangle Grid.Column="5" Fill="Transparent" Width="1" Height="80" VerticalAlignment="Center"/>

                                <!-- COLUMN 3: DAY PROGRESS CARD (Screenshot 2: 40% & 7h 25m until bedtime) -->
                                <Border Grid.Column="6" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,8" Margin="4,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="◷ " FontSize="9.5" Foreground="#99EBEBF5" VerticalAlignment="Center"/>
                                            <TextBlock Text="DAY" Foreground="#99EBEBF5" FontSize="9.5" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Big Bold 40% -->
                                        <TextBlock Grid.Row="1" Text="{Binding Metrics.DayPercentage, StringFormat={}{0}%, FallbackValue='40%'}" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <!-- Blue Progress Bar -->
                                        <ProgressBar Grid.Row="2" Value="{Binding Metrics.DayPercentage, FallbackValue=40}" Minimum="0" Maximum="100" Height="4"
                                                     Background="#26FFFFFF" Foreground="#0A84FF" BorderThickness="0" Margin="0,3,0,4"/>

                                        <!-- Subtext -->
                                        <TextBlock Grid.Row="3" Text="{Binding Metrics.DayPassedText, FallbackValue='7h 25m until bedtime'}" Foreground="#99EBEBF5" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 2: 📊 SYSTEM STATS (ATOLL TELEMETRY PRO)  -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewPerf" Visibility="Collapsed" VerticalAlignment="Stretch" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" /> <!-- Left Hardware Cards Column -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Right Live Wave Graph & Metrics -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT HARDWARE TELEMETRY CARDS (Spacious Apple Cards) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- CPU Card -->
                            <Border x:Name="CardCpu" Background="#1CFFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,0,5" Cursor="Hand" MouseLeftButtonDown="CardCpu_Click" ToolTip="Klik untuk monitor CPU">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#26FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="CPU" Foreground="#64D2FF" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Metrics.CpuGhz, StringFormat={}{0:F2} GHz}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metrics.CpuPercentage, StringFormat={}{0}%}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Metrics.ProcessCount, StringFormat={}{0} Proses}" Foreground="{StaticResource TextMuted}" FontSize="9.5"/>
                                        <TextBlock Text="{Binding Metrics.ThreadCount, StringFormat={}{0} Utas}" Foreground="{StaticResource TextMuted}" FontSize="9.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Memory Card -->
                            <Border x:Name="CardMemory" Background="#26FFFFFF" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,5" Cursor="Hand" MouseLeftButtonDown="CardMemory_Click" ToolTip="Klik untuk monitor Memory (RAM)">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#26FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="RAM" Foreground="{StaticResource AccentBlue}" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Metrics.RamSpeed}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metrics.RamPercentage, StringFormat={}{0}%}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="9.5">
                                            <Run Text="{Binding Metrics.RamUsedGb, StringFormat={}{0:F1}, Mode=OneWay}"/> / <Run Text="{Binding Metrics.RamTotalGb, StringFormat={}{0:F1} GB, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Metrics.RamAvailGb, StringFormat={}Sisa {0:F1} GB}" Foreground="{StaticResource TextMuted}" FontSize="9.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- GPU Card -->
                            <Border x:Name="CardGpu" Background="#1CFFFFFF" CornerRadius="8" Padding="10,6" Cursor="Hand" MouseLeftButtonDown="CardGpu_Click" ToolTip="Klik untuk monitor NVIDIA GPU">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#26FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="NVIDIA" Foreground="{StaticResource BatteryGreen}" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Metrics.GpuTemp, StringFormat={}{0}°C}" Foreground="{StaticResource BatteryGreen}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metrics.GpuPercentage, StringFormat={}{0}%}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="9.5">
                                            VRAM <Run Text="{Binding Metrics.GpuMemUsedGb, Mode=OneWay}"/> / <Run Text="{Binding Metrics.GpuMemTotalGb, Mode=OneWay}"/> GB
                                        </TextBlock>
                                        <TextBlock Text="{Binding Metrics.GpuModel}" Foreground="{StaticResource TextMuted}" FontSize="9.5" HorizontalAlignment="Right" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- DIVIDER -->
                        <Rectangle Grid.Column="1" Fill="#222230" Width="1" VerticalAlignment="Stretch" Margin="0,2"/>

                        <!-- RIGHT LIVE TELEMETRY DASHBOARD (Tall Smooth Real-time Graph) -->
                        <Grid Grid.Column="2" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" /> <!-- Header -->
                                <RowDefinition Height="*" />  <!-- Real-time Graph (Spacious & Tall) -->
                                <RowDefinition Height="14" /> <!-- Axis Markers -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Header & Real-time Live Stats Inline -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Metrics.ActiveHeaderTitle}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Metrics.ActiveHeaderSubtitle}" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                </StackPanel>

                                <!-- Memory Live Details -->
                                <StackPanel x:Name="GridMemoryDetails" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Visible">
                                    <Border Background="#26FFFFFF" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Digunakan " Foreground="{StaticResource TextSecondary}" FontSize="9.5"/>
                                            <TextBlock Text="{Binding Metrics.RamUsedGb, StringFormat={}{0:F1} GB}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                            <TextBlock Text=" • Tersedia " Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.RamAvailGb, StringFormat={}{0:F1} GB}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- CPU Live Details -->
                                <StackPanel x:Name="GridCpuDetails" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Border Background="#26FFFFFF" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Beban " Foreground="{StaticResource TextSecondary}" FontSize="9.5"/>
                                            <TextBlock Text="{Binding Metrics.CpuPercentage, StringFormat={}{0}%}" Foreground="#64D2FF" FontWeight="SemiBold" FontSize="9"/>
                                            <TextBlock Text=" • Speed " Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.CpuGhz, StringFormat={}{0:F2} GHz}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                            <TextBlock Text=" • Uptime " Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.UpTimeString}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- GPU Live Details -->
                                <StackPanel x:Name="GridGpuDetails" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Border Background="#26FFFFFF" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="NVIDIA " Foreground="{StaticResource BatteryGreen}" FontWeight="SemiBold" FontSize="9.5"/>
                                            <TextBlock Text="Load " Foreground="{StaticResource TextSecondary}" FontSize="9.5"/>
                                            <TextBlock Text="{Binding Metrics.GpuPercentage, StringFormat={}{0}%}" Foreground="{StaticResource BatteryGreen}" FontWeight="SemiBold" FontSize="9"/>
                                            <TextBlock Text=" • Suhu " Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.GpuTemp, StringFormat={}{0}°C}" Foreground="{StaticResource BatteryGreen}" FontWeight="SemiBold" FontSize="9"/>
                                            <TextBlock Text=" • Clock " Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Metrics.GpuClockMhz, StringFormat={}{0} MHz}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Real-time 60-Second Scrolling Wave Graph -->
                            <Border Grid.Row="1" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="6" MinHeight="56">
                                <Viewbox Stretch="Fill">
                                    <Grid Width="600" Height="100">
                                        <!-- Horizontal Grid Lines -->
                                        <Rectangle Fill="#1AFFFFFF" Height="1" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                        <Rectangle Fill="#1AFFFFFF" Height="1" VerticalAlignment="Top" Margin="0,50,0,0"/>
                                        <Rectangle Fill="#1AFFFFFF" Height="1" VerticalAlignment="Top" Margin="0,75,0,0"/>

                                        <!-- Vertical Grid Lines (10s intervals) -->
                                        <Rectangle Fill="#1AFFFFFF" Width="1" HorizontalAlignment="Left" Margin="100,0,0,0"/>
                                        <Rectangle Fill="#1AFFFFFF" Width="1" HorizontalAlignment="Left" Margin="200,0,0,0"/>
                                        <Rectangle Fill="#1AFFFFFF" Width="1" HorizontalAlignment="Left" Margin="300,0,0,0"/>
                                        <Rectangle Fill="#1AFFFFFF" Width="1" HorizontalAlignment="Left" Margin="400,0,0,0"/>
                                        <Rectangle Fill="#1AFFFFFF" Width="1" HorizontalAlignment="Left" Margin="500,0,0,0"/>

                                        <!-- Area Gradient Fill -->
                                        <Polygon x:Name="GraphAreaPolygon" Points="{Binding Metrics.ActiveAreaPoints}">
                                            <Polygon.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop x:Name="GraphGradTop" Color="#600A84FF" Offset="0"/>
                                                    <GradientStop x:Name="GraphGradBottom" Color="#050A84FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Polygon.Fill>
                                        </Polygon>

                                        <!-- Dynamic Wave Line -->
                                        <Polyline x:Name="GraphLinePolyline" Points="{Binding Metrics.ActiveLinePoints}" Stroke="{StaticResource AccentBlue}" StrokeThickness="2.2"/>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <!-- Row 2: Sub-Axis Markers -->
                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                <TextBlock Text="60 detik lalu" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                <TextBlock Text="{Binding Metrics.ActiveGraphLabel}" Foreground="{StaticResource TextMuted}" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Text="0 detik (langsung)" Foreground="{StaticResource AccentBlue}" FontSize="9" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                        </Grid>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 2B: 🎮 GAMING HUB & PERFORMANCE OPTIMIZER -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewGameMode" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" /> <!-- Hero Card: Active Game & FPS -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="260" /> <!-- Live Gaming Hardware Stats -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Gaming Optimizer Toggles -->
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 0: HERO CARD (Detected Game & FPS) -->
                        <Border Grid.Column="0" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,8" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Detected Game Title -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GameMode.ActiveGameTitle}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="195"/>
                                </StackPanel>

                                <!-- Big Glowing FPS Display -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                                    <Border Background="#26FFFFFF" BorderBrush="#28683E" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " Foreground="#30D158" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Metrics.FpsDisplayString}" Foreground="#30D158" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Consolas" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Latency" Foreground="{StaticResource TextMuted}" FontSize="9.5"/>
                                        <TextBlock Text="{Binding GameMode.FrameTimeMs, StringFormat={}{0:F1} ms}" Foreground="#5AC8FA" FontSize="9.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Status Subtitle -->
                                <TextBlock Grid.Row="2" Text="{Binding GameMode.BoostStatusText}" Foreground="{StaticResource TextSecondary}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="Transparent" Width="1" Height="86" VerticalAlignment="Center"/>

                        <!-- COLUMN 2: HARDWARE STATS (GPU NVIDIA, CPU, RAM) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,10,0">
                            <!-- GPU Card -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="0.8" CornerRadius="11" Padding="12,6" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="#26FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,5,0">
                                            <TextBlock Text="NVIDIA" Foreground="#30D158" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Metrics.GpuTemp, StringFormat={}{0}°C}" Foreground="#30D158" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" • VRAM " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        <TextBlock Text="{Binding Metrics.GpuMemUsedGb, StringFormat={}{0}G}" Foreground="{StaticResource TextPrimary}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Metrics.GpuPercentage, StringFormat={}{0}% Load}" Foreground="#30D158" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- CPU Card -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="0.8" CornerRadius="11" Padding="12,6" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="#1A2840" CornerRadius="4" Padding="4,1" Margin="0,0,5,0">
                                            <TextBlock Text="CPU" Foreground="#0A84FF" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Metrics.CpuGhz, StringFormat={}{0:F2} GHz}" Foreground="{StaticResource TextPrimary}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Metrics.CpuPercentage, StringFormat={}{0}% Load}" Foreground="#0A84FF" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- RAM Card -->
                            <Border Background="#1CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="#26FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,5,0">
                                            <TextBlock Text="RAM" Foreground="#BF5AF2" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Metrics.RamUsedGb, StringFormat={}{0:F1} GB}" Foreground="{StaticResource TextPrimary}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" / " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Metrics.RamTotalGb, StringFormat={}{0:F0} GB}" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Metrics.RamPercentage, StringFormat={}{0}%}" Foreground="#BF5AF2" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Fill="Transparent" Width="1" Height="86" VerticalAlignment="Center"/>

                        <!-- COLUMN 4: GAMING OPTIMIZER ACTION BUTTONS -->
                        <Grid Grid.Column="4" Margin="10,0,2,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Game Boost Toggle -->
                            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,3,3" Style="{StaticResource ToolCardBtn}" Click="BtnGameBoost_Click" ToolTip="Prioritas Game Tinggi &amp; Optimasi I/O">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoBlue}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{Binding GameMode.BoostButtonText}" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. WinLock -->
                            <Button Grid.Row="0" Grid.Column="1" Margin="3,0,0,3" Style="{StaticResource ToolCardBtn}" Click="BtnWinLock_Click" ToolTip="Kunci Tombol Windows (Cegah Start Menu Pop-up)">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoOrange}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{Binding GameMode.WinLockButtonText}" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Clean RAM -->
                            <Button Grid.Row="1" Grid.Column="0" Margin="0,3,3,0" Style="{StaticResource ToolCardBtn}" Click="BtnCleanRam_Click" ToolTip="Bersihkan Cache Memori &amp; Standby List">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoGreen}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{Binding GameMode.CleanRamStatus}" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. DND Gaming -->
                            <Button Grid.Row="1" Grid.Column="1" Margin="3,3,0,0" Style="{StaticResource ToolCardBtn}" Click="BtnGameDnd_Click" ToolTip="Mode Senyap / Jangan Ganggu Saat Gaming">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource IcoPurple}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{Binding GameMode.DndButtonText}" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 3: 🔋 BATTERIES (HEADSET & MOUSE)         -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewBattery" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Headset Card -->
                        <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Stroke="{StaticResource BatteryTrack}" StrokeThickness="3.5"/>
                                    <local:CircularProgress Width="42" Height="42" 
                                                            Stroke="{StaticResource BatteryGreen}" 
                                                            StrokeThickness="3.5" 
                                                            Percentage="{Binding Battery.Headset.BatteryPercent}"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round"/>
                                    <TextBlock Text="{Binding Battery.Headset.BatteryPercent, StringFormat={}{0}%}" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎧" FontSize="12" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                        <TextBlock Text="{Binding Battery.Headset.Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>
                                    <TextBlock Text="Razer Barracuda X (2.4G)" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,1,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource BatteryGreen}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Terkoneksi (Aktif)" Foreground="{StaticResource BatteryGreen}" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mouse Card -->
                        <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Stroke="{StaticResource BatteryTrack}" StrokeThickness="3.5"/>
                                    <local:CircularProgress Width="42" Height="42" 
                                                            Stroke="{StaticResource BatteryGreen}" 
                                                            StrokeThickness="3.5" 
                                                            Percentage="{Binding Battery.Mouse.BatteryPercent}"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round"/>
                                    <TextBlock Text="{Binding Battery.Mouse.BatteryPercent, StringFormat={}{0}%}" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖱️" FontSize="12" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                        <TextBlock Text="{Binding Battery.Mouse.Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>
                                    <TextBlock Text="Wireless 2.4G Mouse" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,1,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource BatteryGreen}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Terkoneksi (Aktif)" Foreground="{StaticResource BatteryGreen}" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 4: 🎵 FULL MUSIC PLAYER CONTROLLER        -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewMusic" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Album Art Cover -->
                        <Grid Grid.Column="0" Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border CornerRadius="10" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3D1222" Offset="0"/>
                                                <GradientStop Color="#121018" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="🎵" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F2FFFFFF" />
                                    </Border>
                                    <Image Source="{Binding Media.AlbumArt}" Stretch="UniformToFill"
                                           Visibility="{Binding Media.HasAlbumArt, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                            <Border Width="15" Height="15" CornerRadius="3" Background="{StaticResource AccentAppleMusic}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                    Cursor="Hand" MouseLeftButtonDown="BtnAppleBadge_Click" ToolTip="Buka Apple Music">
                                <TextBlock Text="" Foreground="White" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </Grid>

                        <!-- Track Info & Controls -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Media.SongTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Media.ArtistName}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,0.5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Control Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Button Width="26" Height="26" Style="{StaticResource RoundActionBtn}" Click="MediaPrev_Click" ToolTip="Previous">
                                    <TextBlock Text="⏮" FontSize="10" Foreground="#F2FFFFFF" />
                                </Button>
                                <Button Width="30" Height="30" Style="{StaticResource RoundActionBtn}" Background="{StaticResource AccentBlue}" Click="MediaPlayPause_Click" ToolTip="Play / Pause" Margin="8,0">
                                    <Grid>
                                        <TextBlock Text="▶" FontSize="11" Foreground="White" Margin="1,0,0,0"
                                                   Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisInverted}}"/>
                                        <TextBlock Text="⏸" FontSize="11" Foreground="White"
                                                   Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>
                                <Button Width="26" Height="26" Style="{StaticResource RoundActionBtn}" Click="MediaNext_Click" ToolTip="Next">
                                    <TextBlock Text="⏭" FontSize="10" Foreground="#F2FFFFFF" />
                                </Button>

                                <Border Width="1" Height="16" Background="#26FFFFFF" Margin="10,0"/>

                                <Button Width="24" Height="24" Style="{StaticResource RoundActionBtn}" Click="MediaMute_Click" ToolTip="Mute / Unmute">
                                    <TextBlock Text="🔇" FontSize="9.5" Foreground="#F2FFFFFF" />
                                </Button>
                                <Button Width="24" Height="24" Style="{StaticResource RoundActionBtn}" Click="MediaVolDown_Click" ToolTip="Volume Down" Margin="4,0,0,0">
                                    <TextBlock Text="🔉" FontSize="9.5" Foreground="#F2FFFFFF" />
                                </Button>
                                <Button Width="24" Height="24" Style="{StaticResource RoundActionBtn}" Click="MediaVolUp_Click" ToolTip="Volume Up" Margin="4,0,0,0">
                                    <TextBlock Text="🔊" FontSize="9.5" Foreground="#F2FFFFFF" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dancing Audio Equalizer Bars -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="18" Margin="0,0,6,0">
                            <Rectangle x:Name="EqBar1" Width="3" Height="8" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="EqBar2" Width="3" Height="14" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="EqBar3" Width="3" Height="10" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="EqBar4" Width="3" Height="15" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="EqBar5" Width="3" Height="7" Fill="{StaticResource BatteryGreen}" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"/>
                        </StackPanel>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 5: 📅 DEDICATED AGENDA & CALENDAR         -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewAgenda" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Date Panel -->
                        <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Metrics.MonthName}" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Metrics.CurrentDateString}" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding Metrics.TodayScheduleText}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="#202026" Width="1" VerticalAlignment="Stretch" Margin="8,0"/>

                        <!-- Right Timeline Strip -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Jadwal Mingguan" Foreground="{StaticResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Metrics.CurrentWeekDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="40" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="4,6" Margin="0,0,5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayLetter}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DayNumber}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 6: ⏱️ POMODORO FOCUS & STOPWATCH SUITE      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTimer" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Authentic Threads Island Card (@weldraws_) -->
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="1" />
                            <!-- Column 1: Presets & Motivation Stats -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- @weldraws_ Pomodoro & Stand Island Widget -->
                        <Border Grid.Column="0" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="14,9" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 1. Top Bar: Date & Battery + Clock -->
                                    <RowDefinition Height="Auto"/> <!-- 2. Title & Stand Badge -->
                                    <RowDefinition Height="Auto"/> <!-- 3. Capsules: Fokus 25m & Berdiri 10m -->
                                    <RowDefinition Height="Auto"/> <!-- 4. Action Controls: ▶ Mulai & 🔄 Reset -->
                                    <RowDefinition Height="Auto"/> <!-- 5. Carousel Dots: ● ○ ○ ○ -->
                                </Grid.RowDefinitions>

                                <!-- 1. Top Bar: Date & Battery + Clock -->
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtPomodoroDate" Text="" Foreground="#99EBEBF5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Metrics.HasBattery, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE83F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#30D158" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Metrics.BatteryPercentage, StringFormat='{}{0}%'}" Foreground="#99EBEBF5" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metrics.CurrentTimeString}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 2. Title & Stand Badge -->
                                <Grid Grid.Row="1" Margin="0,0,0,7">
                                    <TextBlock Text="Pomodoro" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,2.5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🚶 " FontFamily="Segoe UI Emoji" FontSize="9.5" VerticalAlignment="Center" Foreground="#F2FFFFFF" />
                                            <TextBlock x:Name="TxtStandMilestone" Text="1x hari" Foreground="#99EBEBF5" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 3. Mode Capsules: Fokus 25m & Berdiri 10m -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Fokus 25m Capsule -->
                                    <Button x:Name="BtnPomoFocusMode" Grid.Column="0" Style="{StaticResource GhostBtn}" Click="BtnPomoFocusMode_Click" Margin="0,0,4,0" Cursor="Hand">
                                        <Border x:Name="BorderPomoFocus" Background="#26FFFFFF" BorderBrush="#45FFFFFF" BorderThickness="1.5" CornerRadius="12" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🎯 " FontFamily="Segoe UI Emoji" FontSize="9.5" VerticalAlignment="Center" Foreground="#F2FFFFFF" />
                                                <TextBlock x:Name="TxtPomoFocusLabel" Text="Fokus 25m" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <!-- Berdiri 10m Capsule -->
                                    <Button x:Name="BtnPomoStandMode" Grid.Column="1" Style="{StaticResource GhostBtn}" Click="BtnPomoStandMode_Click" Margin="4,0,0,0" Cursor="Hand">
                                        <Border x:Name="BorderPomoStand" Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse x:Name="DotPomoStand" Width="6" Height="6" Fill="#30D158" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtPomoStandLabel" Text="Berdiri 10m" Foreground="#99EBEBF5" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>

                                <!-- 4. Action Controls: Big White Pill & Circular Reset -->
                                <Grid Grid.Row="3" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Big White Pill: ▶ Mulai / ⏸ Jeda with Live Countdown -->
                                    <Button x:Name="BtnPomoMainAction" Grid.Column="0" Style="{StaticResource GhostBtn}" Click="TimerStartPause_Click" Margin="0,0,8,0" Cursor="Hand">
                                        <Border Background="#FFFFFF" CornerRadius="17" Padding="14,6.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="TimerStartIcon" Text="▶" Foreground="#000000" FontSize="11" FontWeight="SemiBold" Margin="0,-1,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TimerStartLabel" Text="Mulai" Foreground="#000000" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TimerDisplay" Text=" 25:00" Foreground="#222222" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <!-- Circular Dark Reset Button: 🔄 -->
                                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Click="TimerReset_Click" ToolTip="Reset Timer" Cursor="Hand">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                            <TextBlock Text="🔄" FontFamily="Segoe UI Emoji" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </Button>
                                </Grid>

                                <!-- 5. Carousel Dots: ● ○ ○ ○ -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                                    <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="2,0"/>
                                    <Ellipse Width="5" Height="5" Fill="#26FFFFFF" Margin="2,0"/>
                                    <Ellipse Width="5" Height="5" Fill="#26FFFFFF" Margin="2,0"/>
                                    <Ellipse Width="5" Height="5" Fill="#26FFFFFF" Margin="2,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="Transparent" Width="1" Height="120" VerticalAlignment="Center"/>

                        <!-- Column 1: Presets & Focus Analytics -->
                        <Border Grid.Column="2" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🍅 PRESET DURASI" Foreground="#FF9F0A" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TimerModeLabel" Text="POMODORO FOCUS" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <Button Content="Rehat" ToolTip="Durasi istirahat dari Pengaturan &gt; Pomodoro" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Click="TimerSet5_Click" Padding="4,3" Margin="1,0" FontSize="9.5"/>
                                    <Button Content="15m" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Click="TimerSet15_Click" Padding="4,3" Margin="1,0" FontSize="9.5"/>
                                    <Button Content="Fokus" ToolTip="Durasi fokus dari Pengaturan &gt; Pomodoro" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Click="TimerSet25_Click" Padding="4,3" Margin="1,0" FontSize="9.5"/>
                                    <Button Content="⏱ Stopw" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Click="TimerSetStopwatch_Click" Padding="4,3" Margin="1,0" FontSize="9.5" ToolTip="Stopwatch"/>
                                </UniformGrid>
                                <Border Background="#22FFFFFF" CornerRadius="8" Padding="8,5">
                                    <StackPanel>
                                        <TextBlock Text="🚶 Pengingat Berdiri Harian" Foreground="#30D158" FontSize="9.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Regangkan tubuh &amp; berdiri sejenak untuk melancarkan sirkulasi." Foreground="#99EBEBF5" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 6A: ❤️ DEDICATED HEALTH & ERGONOMICS (PONI) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewHealth" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" /> <!-- Hydration Card & Sitting Status -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Poni Smart Break Routine -->
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 0: HYDRATION & ERGONOMICS OVERVIEW -->
                        <Border Grid.Column="0" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,8" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Title & Sitting Counter -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="Kesehatan &amp; Ergonomi" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="9"/>
                                    <TextBlock Text="{Binding Health.SittingStatusText}" Foreground="#FF9F0A" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Hydration Progress -->
                                <StackPanel Grid.Row="1" Margin="0,2,0,4">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Asupan Air Harian" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                        <TextBlock Text="{Binding Health.WaterProgressText}" Foreground="#5AC8FA" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Height="5" Maximum="100" Value="{Binding Health.WaterProgressPercent, Mode=OneWay}" Background="#26FFFFFF" Foreground="#0A84FF" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Quick Add Water Button -->
                                <Button Grid.Row="2" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#5AC8FA" FontSize="9" Padding="6,2" HorizontalAlignment="Stretch" Margin="0,2,0,4" Click="BtnHealthDrink_Click">
                                    <TextBlock Text="+ 250ml Air (Segelas)" HorizontalAlignment="Center" Foreground="#F2FFFFFF" />
                                </Button>

                                <!-- Ergonomics Posture Hint & Reset Sitting Button -->
                                <Button Grid.Row="3" Style="{StaticResource GhostBtn}" Padding="2,1" Click="BtnHealthStretch_Click" ToolTip="Reset Timer Duduk (Selesai Peregangan)">
                                    <TextBlock Text="Regangkan Punggung &amp; Bahu (Reset)" Foreground="#30D158" FontSize="9.5" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="Transparent" Width="1" Height="86" VerticalAlignment="Center"/>

                        <!-- COLUMN 2: SMART BREAK ROUTINE (PONI HEALTH BREAKS) -->
                        <StackPanel Grid.Column="2" Margin="10,0,2,0" VerticalAlignment="Center">
                            <!-- 1. Hydration Break -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="0.8" CornerRadius="11" Padding="12,6" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Health.WaterStatus}" Foreground="#F2FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Minum Sekarang" Style="{StaticResource NavPillBtn}" Background="#0A84FF" Foreground="#FFFFFF" FontSize="9.5" Padding="10,3" Click="BtnHealthDrink_Click"/>
                                </Grid>
                            </Border>

                            <!-- 2. Eye Strain 20-20-20 -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="0.8" CornerRadius="11" Padding="12,6" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Health.EyeStatus}" Foreground="#F2FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Aturan 20-20-20" Style="{StaticResource NavPillBtn}" Background="#30D158" Foreground="#FFFFFF" FontSize="9.5" Padding="10,3" Click="BtnHealthEye_Click"/>
                                </Grid>
                            </Border>

                            <!-- 3. Breathing Exercise (Box Breathing) -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="0.8" CornerRadius="11" Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Health.BreathPrompt}" Foreground="#F2FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Mulai Napas (Box)" Style="{StaticResource NavPillBtn}" Background="#FF9F0A" Foreground="#FFFFFF" FontSize="9.5" Padding="10,3" Click="BtnHealthBreathe_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>





                    <!-- ============================================== -->
                    <!-- VIEW 6B: 📝 TODO & QUICK NOTES (PONI NOTES)      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTodo" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" /> <!-- Todo Task List -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Scratchpad Notes -->
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 1: TODO LIST -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header & Summary -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="{Binding TodoNotes.ActiveTaskSummary}" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- New Task Input -->
                            <Grid Grid.Row="1" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewTodo" Grid.Column="0" Style="{StaticResource MacTextField}" FontSize="10" Padding="8,3.5" KeyDown="TxtNewTodo_KeyDown"/>
                                <Button Grid.Column="1" Content="+ Tambah" Style="{StaticResource NavPillBtn}" Background="#0A84FF" Foreground="#FFFFFF" FontSize="9" Padding="7,2" Margin="4,0,0,0" Click="BtnAddTodo_Click"/>
                            </Grid>

                            <!-- Task List Items -->
                            <ScrollViewer Grid.Row="2" MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TodoNotes.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,2.5" Margin="0,1.5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="0,0,6,0" Click="CheckTodo_Click"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="9.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostBtn}" Foreground="#FF453A" FontSize="9" Padding="3,0" Tag="{Binding}" Click="BtnDeleteTodo_Click" ToolTip="Hapus Tugas"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Rectangle Grid.Column="1" Fill="Transparent" Width="1" Height="86" VerticalAlignment="Center"/>

                        <!-- COLUMN 2: SCRATCHPAD QUICK NOTES -->
                        <Grid Grid.Column="2" Margin="10,0,2,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📝 CATATAN CEPAT (AUTO-SAVE)" Foreground="#66EBEBF5" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox Grid.Row="1" Text="{Binding TodoNotes.QuickNoteText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource MacTextField}" Foreground="#E5E5EA"
                                     FontSize="10" Padding="8,6" Height="84"/>
                        </Grid>
                    </Grid>





                    <!-- ============================================== -->
                    <!-- VIEW 7: 🛠️ ATOLL SYSTEM ACTION TILES             -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTools" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. Lock PC -->
                        <Button Grid.Column="0" Style="{StaticResource ToolCardBtn}" Click="ToolLock_Click" Margin="0,0,3,0" ToolTip="Kunci Windows (Efek Suara Atoll Lock)">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource IcoGray}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" /></Border>
                                <TextBlock Text="Kunci PC" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Sleep -->
                        <Button Grid.Column="1" Style="{StaticResource ToolCardBtn}" Click="ToolSleep_Click" Margin="2,0,3,0" ToolTip="Mode Tidur (Sleep)">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource IcoPurple}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" /></Border>
                                <TextBlock Text="Sleep" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Mute Master Audio -->
                        <Button Grid.Column="2" Style="{StaticResource ToolCardBtn}" Click="ToolMute_Click" Margin="2,0,3,0" ToolTip="Bisukan / Aktifkan Audio Master">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource IcoRed}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE74F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" /></Border>
                                <TextBlock Text="Bisukan" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Atoll Color Picker -->
                        <Button Grid.Column="3" Style="{StaticResource ToolCardBtn}" Click="ToolColorPicker_Click" Margin="2,0,3,0" ToolTip="Atoll Screen Eyedropper (Ambil Warna Piksel Layar)">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource IcoPink}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" /></Border>
                                <TextBlock Text="Warna" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. Snip Tool -->
                        <Button Grid.Column="4" Style="{StaticResource ToolCardBtn}" Click="ToolScreenshot_Click" Margin="2,0,3,0" ToolTip="Snipping Tool / Screenshot">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource IcoBlue}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE8C6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" /></Border>
                                <TextBlock Text="Snip Tool" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. Atoll Clipboard -->
                        <Button Grid.Column="5" Style="{StaticResource ToolCardBtn}" Click="ToolClipboard_Click" Margin="2,0,3,0" ToolTip="Buka Riwayat Clipboard Atoll">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource IcoOrange}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" /></Border>
                                <TextBlock Text="Clipboard" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 7. Task Manager -->
                        <Button Grid.Column="6" Style="{StaticResource ToolCardBtn}" Click="ToolTaskMgr_Click" Margin="2,0,3,0" ToolTip="Pengelola Tugas (Task Manager)">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource IcoGreen}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" /></Border>
                                <TextBlock Text="Task Mgr" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 8. Windows Settings -->
                        <Button Grid.Column="7" Style="{StaticResource ToolCardBtn}" Click="ToolSettings_Click" Margin="2,0,0,0" ToolTip="Pengaturan Windows">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource IcoTeal}" BorderBrush="#22FFFFFF" BorderThickness="0.5" HorizontalAlignment="Center"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" /></Border>
                                <TextBlock Text="Settings" FontSize="9.5" Foreground="#E6EBEBF5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 7.2: 📋 ATOLL CLIPBOARD HISTORY MANAGER   -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewClipboard" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar: Search + Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Bar -->
                            <Border Grid.Column="0" Background="#1CFFFFFF" CornerRadius="8" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="8,4" Margin="0,0,8,0">
                                <Grid>
                                    <TextBlock Text="🔍 Cari teks di riwayat clipboard..." Foreground="#666675" FontSize="10.5" VerticalAlignment="Center" Margin="2,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Text.IsEmpty, ElementName=TxtClipboardSearch, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox x:Name="TxtClipboardSearch" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="10.5"
                                             VerticalAlignment="Center" TextChanged="TxtClipboardSearch_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Clear All Button -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnClearClipboard" Content="🗑 Bersihkan" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FF453A" FontSize="9.5" Padding="8,4" Click="BtnClearClipboard_Click" ToolTip="Hapus semua riwayat yang tidak di-pin"/>
                            </StackPanel>
                        </Grid>

                        <!-- History List -->
                        <ScrollViewer Grid.Row="1" MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ClipboardItemsControl" ItemsSource="{Binding Clipboard.FilteredItems, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="7" Margin="0,0,0,4" Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Pin button -->
                                                <Button Grid.Column="0" Content="{Binding PinIcon}" Style="{StaticResource GhostBtn}" FontSize="10" Padding="3,1" Margin="0,0,6,0" Click="BtnClipboardPin_Click" ToolTip="Pin ke atas"/>

                                                <!-- Content -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Preview}" Foreground="#E4E4E8" FontSize="10" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <TextBlock Text="{Binding TimeAgo}" Foreground="#66EBEBF5" FontSize="9.5"/>
                                                        <TextBlock Text=" • " Foreground="#404050" FontSize="9.5"/>
                                                        <TextBlock Text="{Binding CharCountText}" Foreground="#66EBEBF5" FontSize="9.5"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Copy button -->
                                                <Button Grid.Column="2" Content="Salin" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#0A84FF" FontSize="9" Padding="7,2.5" Margin="4,0,3,0" Click="BtnClipboardCopy_Click" ToolTip="Salin kembali ke Clipboard (Atoll Sound Feedback)"/>

                                                <!-- Delete button -->
                                                <Button Grid.Column="3" Content="✕" Style="{StaticResource GhostBtn}" Foreground="#FF453A" FontSize="9" Padding="4,2" Click="BtnClipboardDelete_Click" ToolTip="Hapus dari riwayat"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 7.5: 📥 SHELF & AIRDROP HUB (PONI SCREENSHOT 3) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewShelf" Visibility="Collapsed" VerticalAlignment="Stretch" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />     <!-- Left: Shelf File Rack / Drop Area -->
                            <ColumnDefinition Width="1" />     <!-- Divider -->
                            <ColumnDefinition Width="110" />   <!-- Right: Share & Controls (Screenshot 3) -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: DROP FILES HERE / FILE RACK -->
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <!-- Empty State Dashed Drop Zone (Screenshot 3) -->
                            <Border Background="#1CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1.5" CornerRadius="12" Padding="14,10"
                                    Visibility="{Binding Shelf.ItemCount, Converter={StaticResource CountToVisInverted}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="34" Height="30" CornerRadius="8" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <Path Stretch="Uniform" Width="16" Height="14" Fill="#99EBEBF5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M19,3H5c-1.1,0-2,0.9-2,2v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5c0-1.1-0.9-2-2-2zm0,16H5v-3h3.56c0.69,1.19,1.97,2,3.44,2s2.75-0.81,3.44-2H19v3zm0-5h-4.18c-0.41,0.58-1.07,1-1.82,1s-1.41-0.42-1.82-1H5V5h14v9z"/>
                                    </Border>
                                    <TextBlock Text="Drop files here" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Keep files handy, then drag them out anywhere" Foreground="#99EBEBF5" FontSize="9.5" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Populated Horizontal File Rack -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                                          Visibility="{Binding Shelf.ItemCount, Converter={StaticResource CountToVis}}">
                                <ItemsControl ItemsSource="{Binding Shelf.Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="138" Height="74" Margin="0,0,8,0" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="8,6"
                                                    Cursor="Hand" ToolTip="Tarik keluar untuk kirim ke aplikasi lain • Klik kanan untuk opsi"
                                                    PreviewMouseLeftButtonDown="ShelfItem_PreviewMouseLeftButtonDown"
                                                    MouseMove="ShelfItem_MouseMove">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Top Row: Icon + Extension Badge + Delete Button -->
                                                    <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GlyphIcon}" FontSize="12" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                                            <Border Background="#26FFFFFF" CornerRadius="3" Padding="3,0.5">
                                                                <TextBlock Text="{Binding Extension}" Foreground="{Binding CategoryColor}" FontSize="9" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Padding="3,1" Click="ShelfItemRemove_Click" ToolTip="Hapus dari Shelf">
                                                            <TextBlock Text="✕" FontSize="9.5" Foreground="#99EBEBF5"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Center: Thumbnail or File Name -->
                                                    <Grid Grid.Row="1" Margin="0,3">
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="26"
                                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding FileName}" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisInverted}}"/>
                                                    </Grid>

                                                    <!-- Bottom Row: File Size + 2 Clean Action Buttons -->
                                                    <Grid Grid.Row="2">
                                                        <TextBlock Text="{Binding FileSizeText}" Foreground="#99EBEBF5" FontSize="9" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Buka" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#0A84FF" FontSize="9" Padding="6,2" Click="ShelfItemOpen_Click" ToolTip="Buka Berkas"/>
                                                            <Button Content="Salin" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#CCEBEBF5" FontSize="9" Padding="6,2" Margin="3,0,0,0" Click="ShelfItemCopy_Click" ToolTip="Salin Berkas"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- DIVIDER -->
                        <Rectangle Grid.Column="1" Fill="#242436" Width="1" Margin="0,2"/>

                        <!-- RIGHT: SHARE CARD & ACTIONS (Screenshot 3) -->
                        <Grid Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Big Blue Share Card -->
                                <Border Width="78" Height="58" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#0A84FF" BorderThickness="1.5" Cursor="Hand" MouseLeftButtonDown="BtnShelfShare_Click" ToolTip="Bagikan berkas via AirDrop / Windows Share">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Width="16" Height="16" Fill="#0A84FF" HorizontalAlignment="Center"
                                              Data="M18,16.08c-.76,0-1.44.3-1.96.77L8.91,12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5,1.25.81,2.04.81 1.66,0,3-1.34,3-3s-1.34-3-3-3-3,1.34-3,3c0,.24.04.47.09.7L8.04,9.81C7.5,9.31,6.79,9,6,9c-1.66,0-3,1.34-3,3s1.34,3,3,3c.79,0,1.5-.31,2.04-.81l7.12,4.16c-.05.21-.08.43-.08.65 0,1.61,1.31,2.92,2.92,2.92 1.61,0,2.92-1.31,2.92-2.92s-1.31-2.92-2.92-2.92z"/>
                                        <TextBlock Text="Share" Foreground="#0A84FF" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Underneath: Plus & Trash buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                    <Button Width="36" Height="22" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Click="BtnAddShelfFile_Click" ToolTip="Tambah Berkas">
                                        <TextBlock Text="+" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F2FFFFFF" />
                                    </Button>
                                    <Button Width="36" Height="22" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Margin="6,0,0,0" Click="BtnClearShelf_Click" ToolTip="Kosongkan Shelf">
                                        <Path Stretch="Uniform" Width="9" Height="10" Fill="#99EBEBF5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M6,19c0,1.1.9,2,2,2h8c1.1,0,2-.9,2-2V7H6v12zM19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- VIEW 7.8: ⛅ FULL WEATHER DASHBOARD (PONI SCREENSHOT 4) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewWeather" Visibility="Collapsed" Margin="0,0,0,0">
                        <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Temp + Condition + 6 Chips -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Big 32° + Light Drizzle + Location -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Width="26" Height="22" Fill="{Binding Metrics.WeatherIconBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Data="{Binding Metrics.WeatherIcon}"/>
                                        <TextBlock Text="{Binding Metrics.WeatherTemp, FallbackValue='--&#176;'}" Foreground="#FFFFFF" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Metrics.WeatherCondition, FallbackValue='Memuat cuaca...'}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <Path Stretch="Uniform" Width="6" Height="8" Fill="#99EBEBF5" Margin="0,0,3,0" VerticalAlignment="Center" Data="M16,12V4h1V2H7v2h1v8l-2,2v2h5v6l1,1 1-1v-6h5v-2l-2-2z"/>
                                                <TextBlock Text="{Binding Metrics.WeatherSubtitle, FallbackValue='Jakarta, Indonesia'}" Foreground="#99EBEBF5" FontSize="9.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Foreground="#99EBEBF5" FontSize="9" Margin="0,1,0,0"><Run Text="{Binding Metrics.WeatherHighLow, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Metrics.WeatherFeelsLike, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right: 6 Rounded Chips in 2x3 Grid -->
                                    <UniformGrid Grid.Column="1" Rows="2" Columns="3" VerticalAlignment="Center">
                                        <Border Background="#26FFFFFF" CornerRadius="8" Padding="6,3" Margin="2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="7" Height="9" Fill="#5AC8FA" Margin="0,0,4,0" Data="M12,2.69l5.66,5.66a8,8,0,1,1-11.31,0z"/>
                                                <TextBlock Text="{Binding Metrics.WeatherHumidity}" ToolTip="Kelembapan" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#26FFFFFF" CornerRadius="8" Padding="6,3" Margin="2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="9" Height="8" Fill="#FFFFFF" Margin="0,0,4,0" Data="M14.5,17a2.5,2.5,0,0,0,2.5-2.5A2.5,2.5,0,0,0,14.5,12H2v2h12.5a0.5,0.5,0,0,1,0.5,0.5A0.5,0.5,0,0,1,14.5,15H2v2h12.5z"/>
                                                <TextBlock Text="{Binding Metrics.WeatherWind}" ToolTip="Angin" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#26FFFFFF" CornerRadius="8" Padding="6,3" Margin="2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="8" Height="8" Fill="#FF9F0A" Margin="0,0,4,0" Data="M12,7c-2.76,0-5,2.24-5,5s2.24,5,5,5 5-2.24,5-5-2.24-5-5-5zM2,13h2v-2H2v2zm18,0h2v-2h-2v2zM11,2v2h2V2h-2zm0,18v2h2v-2h-2z"/>
                                                <TextBlock Text="{Binding Metrics.WeatherUv}" ToolTip="Indeks UV" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#26FFFFFF" CornerRadius="8" Padding="6,3" Margin="2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,4,0" Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10 10-4.48,10-10S17.52,2,12,2zm0,18c-4.41,0-8-3.59-8-8s3.59-8,8-8 8,3.59,8,8-3.59,8-8,8z"/>
                                                <TextBlock Text="{Binding Metrics.WeatherPressure}" ToolTip="Tekanan udara" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#26FFFFFF" CornerRadius="8" Padding="6,3" Margin="2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="8" Height="8" Fill="#FF9F0A" Margin="0,0,4,0" Data="M12,8l-4,4h2.5v4h3v-4H16L12,8z M5,19h14v2H5z"/>
                                                <TextBlock Text="{Binding Metrics.WeatherSunrise}" ToolTip="Matahari terbit" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#26FFFFFF" CornerRadius="8" Padding="6,3" Margin="2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="8" Height="8" Fill="#FF453A" Margin="0,0,4,0" Data="M12,16l4-4h-2.5V8h-3v4H8L12,16z M5,19h14v2H5z"/>
                                                <TextBlock Text="{Binding Metrics.WeatherSunset}" ToolTip="Matahari terbenam" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>

                                <!-- Bottom Row: Hourly & 7-Day Forecast Cards -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Hourly Card -->
                                    <Border Grid.Column="0" Background="#26FFFFFF" CornerRadius="10" Padding="8,5" Margin="0,0,4,0">
                                        <ItemsControl ItemsSource="{Binding Metrics.WeatherHourly}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding Label}" Foreground="#99EBEBF5" FontSize="9.5" HorizontalAlignment="Center"/><Path Stretch="Uniform" Width="11" Height="11" Fill="{Binding IconBrush}" Data="{Binding Icon}" Margin="0,2" HorizontalAlignment="Center"/><TextBlock Text="{Binding Temp}" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Sub}" Foreground="{Binding SubBrush}" FontSize="9.5" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </Border>

                                    <!-- 7-Day Card -->
                                    <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="10" Padding="8,5" Margin="4,0,0,0">
                                        <ItemsControl ItemsSource="{Binding Metrics.WeatherDaily}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding Label}" Foreground="#99EBEBF5" FontSize="9.5" HorizontalAlignment="Center"/><Path Stretch="Uniform" Width="11" Height="11" Fill="{Binding IconBrush}" Data="{Binding Icon}" Margin="0,2" HorizontalAlignment="Center"/><TextBlock Text="{Binding Temp}" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Sub}" Foreground="{Binding SubBrush}" FontSize="9.5" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- VIEW 8.5: ⏳ SCREEN TIME & APP USAGE (PONI SCREENSHOT 5) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewScreenTime" Visibility="Collapsed" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" /> <!-- Donut & Activity -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Most Used Apps List -->
                        </Grid.ColumnDefinitions>

                        <!-- Left: Donut Chart & Activity -->
                        <Border Grid.Column="0" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,8" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Donut + Legend -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Donut Ring -->
                                    <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,8,0" Background="Transparent" Cursor="Hand" ToolTip="Klik untuk beralih Hari ini / 7 hari" MouseLeftButtonUp="ScreenTimeDonut_Click">
                                        <Ellipse Width="46" Height="46" Stroke="#26FFFFFF" StrokeThickness="7"/>
                                        <Ellipse Width="46" Height="46" Stroke="#0A84FF" StrokeThickness="7" StrokeDashArray="6 4"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScreenTime.TotalTimeFormatted, FallbackValue='0m'}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ScreenTime.PeriodLabel, FallbackValue='Hari ini'}" Foreground="#99EBEBF5" FontSize="6.5" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Legend -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Ellipse Width="5" Height="5" Fill="#0A84FF" Margin="0,0,4,0"/>
                                            <TextBlock Text="Aplikasi" Foreground="#CCEBEBF5" FontSize="9"/>
                                            <TextBlock Text="{Binding ScreenTime.OtherTimeFormatted, FallbackValue='0m'}" Foreground="#99EBEBF5" FontSize="9" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="0,0,4,0"/>
                                            <TextBlock Text="Sistem" Foreground="#CCEBEBF5" FontSize="9"/>
                                            <TextBlock Text="{Binding ScreenTime.SystemTimeFormatted, FallbackValue='0m'}" Foreground="#99EBEBF5" FontSize="9" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Middle: Mini Bar Chart Indicator -->
                                <Grid Grid.Row="1" Margin="0,6,0,4" VerticalAlignment="Center">
                                    <Rectangle Height="1" Fill="#26FFFFFF" VerticalAlignment="Bottom"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Rectangle Width="3" Height="{Binding ScreenTime.Bar0, FallbackValue=3}" Fill="#4D0A84FF" RadiusX="1.5" RadiusY="1.5" Margin="2,0" ToolTip="4 jam lalu"/>
                                        <Rectangle Width="3" Height="{Binding ScreenTime.Bar1, FallbackValue=3}" Fill="#4D0A84FF" RadiusX="1.5" RadiusY="1.5" Margin="2,0" ToolTip="3 jam lalu"/>
                                        <Rectangle Width="3" Height="{Binding ScreenTime.Bar2, FallbackValue=3}" Fill="#800A84FF" RadiusX="1.5" RadiusY="1.5" Margin="2,0" ToolTip="2 jam lalu"/>
                                        <Rectangle Width="3" Height="{Binding ScreenTime.Bar3, FallbackValue=3}" Fill="#B30A84FF" RadiusX="1.5" RadiusY="1.5" Margin="2,0" ToolTip="1 jam lalu"/>
                                        <Rectangle Width="3" Height="{Binding ScreenTime.Bar4, FallbackValue=3}" Fill="#0A84FF" RadiusX="1.5" RadiusY="1.5" Margin="2,0" ToolTip="Jam ini"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Footer: App Switches Count -->
                                <TextBlock Grid.Row="2" Text="{Binding ScreenTime.SwitchesSummaryText, FallbackValue='Belum ada aktivitas'}" 
                                           Foreground="#66EBEBF5" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="Transparent" Width="1" Height="80" VerticalAlignment="Center"/>

                        <!-- Right: Most Used Apps List -->
                        <Border Grid.Column="2" Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,8" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header + Pill Filter -->
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Width="9" Height="9" Fill="#99EBEBF5" Margin="0,0,4,0" VerticalAlignment="Center" Data="M5,9.2h3V19H5V9.2zM10.6,5h2.8v14h-2.8V5zM16.2,13H19v6h-2.8V13z"/>
                                        <TextBlock Text="MOST USED" Foreground="#99EBEBF5" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#26FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#26FFFFFF" CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="Today" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Padding="5,1" Margin="2,0,0,0">
                                                <TextBlock Text="7 days" Foreground="#99EBEBF5" FontSize="9.5"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Apps List -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ScreenTime.MostUsedApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1.5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Icon -->
                                                <Image Grid.Column="0" Source="{Binding AppIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <!-- App Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding AppName}" Foreground="#FFFFFF" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="3,0,4,0"/>
                                                <!-- Blue Progress Bar -->
                                                <ProgressBar Grid.Column="2" Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" 
                                                             Background="#26FFFFFF" Foreground="#0A84FF" BorderThickness="0" VerticalAlignment="Center"/>
                                                <!-- Duration -->
                                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#99EBEBF5" FontSize="9.5" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>





                    <!-- ============================================== -->
                    <!-- VIEW 9: 🎛️ REALTIME AUDIO MIXER & MIC MONITOR (Matches Screenshot) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewMixer" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,1,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /> <!-- LEFT: OUTPUT CARD -->
                            <ColumnDefinition Width="*" /> <!-- RIGHT: MIKROFON CARD -->
                        </Grid.ColumnDefinitions>

                        <!-- ========================================== -->
                        <!-- LEFT CARD: OUTPUT                          -->
                        <!-- ========================================== -->
                        <Border Grid.Column="0" Background="#1CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0.8" CornerRadius="14" Padding="10,8" Margin="0,0,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Master Volume Header -->
                                    <RowDefinition Height="*" />    <!-- Per-App Sliders List -->
                                </Grid.RowDefinitions>

                                <!-- Header: OUTPUT + 🔊 + Slider + 65 -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Label OUTPUT -->
                                    <TextBlock Grid.Column="0" Text="OUTPUT" Foreground="#66EBEBF5" FontWeight="SemiBold" FontSize="9.5" VerticalAlignment="Center"/>

                                    <!-- Speaker Icon -->
                                    <TextBlock Grid.Column="1" Text="🔊" FontSize="9.5" Foreground="#99EBEBF5" VerticalAlignment="Center" Margin="8,0,6,0"/>

                                    <!-- Master Volume Slider -->
                                    <Slider Grid.Column="2" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" 
                                            Value="{Binding Audio.MasterOutputVolume, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>

                                    <!-- Raw Master Value (no %) -->
                                    <TextBlock Grid.Column="3" Text="{Binding Audio.MasterOutputVolume, RelativeSource={RelativeSource AncestorType=Window}}" 
                                               Foreground="#99EBEBF5" FontWeight="SemiBold" FontSize="9.5" Width="20" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- Per-App Audio Sessions List (Discord, FiveM, Suara sistem, Steam) -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Audio.OutputSessions, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="22" Margin="0,1,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" /> <!-- App Badge Icon -->
                                                    <ColumnDefinition Width="86" /> <!-- App Name -->
                                                    <ColumnDefinition Width="12" /> <!-- Green Active Dot -->
                                                    <ColumnDefinition Width="*" />  <!-- Volume Slider -->
                                                    <ColumnDefinition Width="18" /> <!-- Mute / Speaker Icon -->
                                                </Grid.ColumnDefinitions>

                                                <!-- App Icon Badge -->
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4" Background="{Binding IconColor}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                </Border>

                                                <!-- App Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="9" FontWeight="Normal" 
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,2,0"/>

                                                <!-- Green Active Audio Dot (visible if currently playing audio) -->
                                                <Ellipse Grid.Column="2" Width="5" Height="5" Fill="#30D158" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Visibility="{Binding IsPlayingAudio, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Volume Slider -->
                                                <Slider Grid.Column="3" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="1" 
                                                        Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>

                                                <!-- Mute / Speaker Button -->
                                                <Button Grid.Column="4" Style="{StaticResource GhostBtn}" Padding="0" Click="SessionMute_Click" Tag="{Binding}" ToolTip="Mute / Suara" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding MuteGlyph}" FontSize="9.5" Foreground="#99EBEBF5"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- ========================================== -->
                        <!-- RIGHT CARD: MIKROFON                       -->
                        <!-- ========================================== -->
                        <Border Grid.Column="1" Background="#1CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0.8" CornerRadius="14" Padding="10,8" Margin="4,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Master Mic Header -->
                                    <RowDefinition Height="Auto" /> <!-- "Dipakai oleh" Sub-Header -->
                                    <RowDefinition Height="*" />    <!-- Active Mic Apps List -->
                                </Grid.RowDefinitions>

                                <!-- Header: MIKROFON + 🎤 + Slider + 100 -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Label MIKROFON -->
                                    <TextBlock Grid.Column="0" Text="MIKROFON" Foreground="#66EBEBF5" FontWeight="SemiBold" FontSize="9.5" VerticalAlignment="Center"/>

                                    <!-- Mic Icon -->
                                    <TextBlock Grid.Column="1" Text="🎤" FontSize="9.5" Foreground="#99EBEBF5" VerticalAlignment="Center" Margin="8,0,6,0"/>

                                    <!-- Master Mic Slider -->
                                    <Slider Grid.Column="2" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" 
                                            Value="{Binding Audio.MasterMicVolume, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>

                                    <!-- Raw Master Value (no %) -->
                                    <TextBlock Grid.Column="3" Text="{Binding Audio.MasterMicVolume, RelativeSource={RelativeSource AncestorType=Window}}" 
                                               Foreground="#99EBEBF5" FontWeight="SemiBold" FontSize="9.5" Width="20" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- Sub-Header: Dipakai oleh -->
                                <TextBlock Grid.Row="1" Text="Dipakai oleh" Foreground="#66EBEBF5" FontSize="9.5" Margin="0,0,0,4"/>

                                <!-- Active Mic Apps List (FiveM, Discord, Wispr Flow) -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Audio.MicApps, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="22" Margin="0,1,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" /> <!-- App Badge Icon -->
                                                    <ColumnDefinition Width="*" />  <!-- App Name -->
                                                    <ColumnDefinition Width="Auto" /><!-- Orange Dot + aktif · soundtech -->
                                                </Grid.ColumnDefinitions>

                                                <!-- App Icon Badge -->
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4" Background="{Binding IconColor}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                </Border>

                                                <!-- App Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding AppName}" Foreground="#FFFFFF" FontSize="9" 
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,6,0"/>

                                                <!-- Amber Dot + aktif · soundtech (Matches Image 2) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" 
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse Width="5" Height="5" Fill="#FF9F0A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#FF9F0A" FontSize="9.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 8: ⚙️ COMPREHENSIVE SETTINGS & CUSTOMIZATION -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewSettings" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,2,0,8">
                        <StackPanel Orientation="Vertical">

                            <!-- APP BRANDING HEADER -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="pack://application:,,,/DynamicIsland;component/Assets/logo.png" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Dynamic Island Pro" Foreground="#FFD60A" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="Edisi Eksklusif Windows 11 • Realtime macOS Notch" Foreground="{StaticResource TextSecondary}" FontSize="9.5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION 1: 📏 UKURAN NOTCH (SIZING & PRESETS) -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📏" FontSize="11" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                            <TextBlock Text="Ukuran Dynamic Island" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10.5"/>
                                        </StackPanel>
                                        <!-- Quick Presets -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Kecil (Compact)" Style="{StaticResource SettingPillBtn}" Click="PresetCompact_Click" Margin="0,0,4,0"/>
                                            <Button Content="Standar" Style="{StaticResource SettingPillBtn}" Click="PresetDefault_Click" Margin="0,0,4,0"/>
                                            <Button Content="Besar (Large)" Style="{StaticResource SettingPillBtn}" Click="PresetLarge_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Sliders Grid (2 Columns: Compact size vs Expanded size) -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Compact Size Controls -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Saat Tertutup (Idle Notch)" Foreground="{StaticResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <!-- Compact Width -->
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Lebar Idle" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderCompactW, StringFormat={}{0:0} px}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderCompactW" Style="{StaticResource AppleSlider}" Minimum="180" Maximum="320" Value="{Binding Settings.CompactWidth, Mode=TwoWay}" ValueChanged="SliderDimensions_ValueChanged"/>

                                            <!-- Compact Height -->
                                            <Grid Margin="0,4,0,2">
                                                <TextBlock Text="Tinggi Idle" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderCompactH, StringFormat={}{0:0} px}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderCompactH" Style="{StaticResource AppleSlider}" Minimum="28" Maximum="46" Value="{Binding Settings.CompactHeight, Mode=TwoWay}" ValueChanged="SliderDimensions_ValueChanged"/>
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Rectangle Grid.Column="1" Fill="#1AFFFFFF" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                        <!-- Right: Expanded Size Controls -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Saat Terbuka (Expanded Island)" Foreground="{StaticResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <!-- Expanded Width -->
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Lebar Terbuka" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderExpandedW, StringFormat={}{0:0} px}" Foreground="{StaticResource BatteryGreen}" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderExpandedW" Style="{StaticResource AppleSlider}" Minimum="480" Maximum="780" Value="{Binding Settings.ExpandedWidth, Mode=TwoWay}" ValueChanged="SliderDimensions_ValueChanged"/>

                                            <!-- Expanded Height -->
                                            <Grid Margin="0,4,0,2">
                                                <TextBlock Text="Tinggi Terbuka" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderExpandedH, StringFormat={}{0:0} px}" Foreground="{StaticResource BatteryGreen}" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderExpandedH" Style="{StaticResource AppleSlider}" Minimum="75" Maximum="140" Value="{Binding Settings.ExpandedHeight, Mode=TwoWay}" ValueChanged="SliderDimensions_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mode Idle Saat Tertutup Selection -->
                                    <Border Background="#1CFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎭" FontSize="10" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                                    <TextBlock Text="Tampilan Default Saat Idle (Tertutup):" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                                </StackPanel>
                                                <TextBlock Text="Pilih mode tampilan utama" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="🔋 Baterai" Style="{StaticResource SettingPillBtn}" Margin="0,0,2,0" Click="BtnSetIdleBattery_Click"/>
                                                <Button Grid.Column="1" Content="🎵 Musik" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnSetIdleMusic_Click"/>
                                                <Button Grid.Column="2" Content="🎤 Lirik" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnSetIdleLyrics_Click"/>
                                                <Button Grid.Column="3" Content="⚡ Performa" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnSetIdlePerf_Click"/>
                                                <Button x:Name="BtnSetIdleCat" Grid.Column="4" Content="🦖 Nailong" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnSetIdleCat_Click"/>
                                                <Button Grid.Column="5" Content="🕒 Jam" Style="{StaticResource SettingPillBtn}" Margin="2,0,0,0" Click="BtnSetIdleClock_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pilihan Karakter Animasi (Nailong vs Spongebob) -->
                                    <Border Background="#1CFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,6,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎬" FontSize="10" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                                    <TextBlock Text="Pilihan Karakter Animasi:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                                </StackPanel>
                                                <TextBlock Text="Pilih animasi menari di island" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnCharNailong" Grid.Column="0" Content="🦖 Nailong" Style="{StaticResource SettingPillBtn}" Margin="0,0,2,0" Click="BtnCharNailong_Click"/>
                                                <Button x:Name="BtnCharSpongebob" Grid.Column="1" Content="🧽 Spongebob" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnCharSpongebob_Click"/>
                                                <Button x:Name="BtnCharMinion" Grid.Column="2" Content="🍌 Minion" Style="{StaticResource SettingPillBtn}" Margin="2,0,0,0" Click="BtnCharMinion_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>


                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: 🎯 POSISI, OPASITAS & LAYAR -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Position Offset -->
                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🧭" FontSize="10" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                                <TextBlock Text="Posisi Horizontal (X Offset)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                            </StackPanel>
                                            <Button Content="Tengah" Style="{StaticResource SettingPillBtn}" Click="BtnResetX_Click" HorizontalAlignment="Right" Padding="6,1"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Geser Kiri / Kanan" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                            <TextBlock Text="{Binding Value, ElementName=SliderPosX, StringFormat={}{0:0} px}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" FontSize="9" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderPosX" Style="{StaticResource AppleSlider}" Minimum="-350" Maximum="350" Value="{Binding Settings.PositionOffsetX, Mode=TwoWay}" ValueChanged="SliderPosX_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Rectangle Grid.Column="1" Fill="#1AFFFFFF" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                    <!-- Right: Opacity & Always on Top -->
                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="👁️" FontSize="10" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                                <TextBlock Text="Kepekatan &amp; Visibilitas" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Opasitas Notch" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                            <TextBlock Text="{Binding Value, ElementName=SliderOpacity, StringFormat={}{0:0}%}" Foreground="{StaticResource BatteryGreen}" FontWeight="SemiBold" FontSize="9" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderOpacity" Style="{StaticResource AppleSlider}" Minimum="60" Maximum="100" Value="{Binding Settings.NotchOpacity, Mode=TwoWay}" ValueChanged="SliderOpacity_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION 3: ⚡ INTERAKSI & OTOMATISASI -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: Toggles -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <CheckBox x:Name="ChkAutoExpand" Content="Buka otomatis saat kursor mendekat (Hover)" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,2,0,4"
                                                  IsChecked="{Binding Settings.AutoExpandOnHover, Mode=TwoWay}" Click="ChkAutoExpand_Click"/>

                                        <CheckBox x:Name="ChkAutoMusicSetting" Content="Otomatis tampilkan musik saat berputar" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,4,0,4"
                                                  IsChecked="{Binding Settings.AutoSwitchMusic, Mode=TwoWay}" Click="ChkAutoMusic_Click"/>

                                        <CheckBox x:Name="ChkAlwaysOnTop" Content="Selalu di atas jendela lain (Always on Top)" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,4,0,0"
                                                  IsChecked="{Binding Settings.AlwaysOnTop, Mode=TwoWay}" Click="ChkAlwaysOnTop_Click"/>
                                    </StackPanel>

                                    <!-- Column 1: System & Reset -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <CheckBox x:Name="ChkStartWithWindows" Content="Mulai otomatis saat Windows dinyalakan" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,2,0,4"
                                                  IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}"/>

                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="Animasi" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="⚡ Cepat" Style="{StaticResource SettingPillBtn}" Click="SpeedFast_Click" Margin="0,0,3,0"/>
                                                <Button Content="🍏 Apple" Style="{StaticResource SettingPillBtn}" Click="SpeedNormal_Click" Margin="0,0,3,0"/>
                                                <Button Content="🧘 Halus" Style="{StaticResource SettingPillBtn}" Click="SpeedSlow_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="🔄 Kembalikan ke Default Pabrik" Style="{StaticResource SettingPillBtn}" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" Foreground="#FF453A" Margin="0,8,0,0" Click="BtnResetAllSettings_Click" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION 4: 🎮 MODE GAME & ANTI-GANGGUAN (ANTI-DISRUPTION) -->
                            <Border Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎮" FontSize="11" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                            <TextBlock Text="Mode Game &amp; Anti-Gangguan Layar Penuh" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10.5"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleGameManual" Content="🎮 Mode Game: OFF" Style="{StaticResource SettingPillBtn}" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" Foreground="#FF375F" Click="BtnToggleGameManual_Click" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Auto Game Detection & Dwell Delay -->
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkAutoGameMode" Content="Deteksi Game / Layar Penuh Otomatis" 
                                                      Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,1,0,4"
                                                      IsChecked="{Binding Settings.AutoGameMode, Mode=TwoWay}" Click="ChkAutoGameMode_Click"/>

                                            <Grid Margin="0,4,0,2">
                                                <TextBlock Text="Tunda Buka Hover (Dwell Delay)" Foreground="{StaticResource TextSecondary}" FontSize="9.5"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderHoverDelay, StringFormat={}{0:0} ms}" Foreground="{StaticResource AccentOrange}" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderHoverDelay" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="400" Value="{Binding Settings.HoverDwellDelayMs, Mode=TwoWay}" ToolTip="Cegah notch terbuka saat kursor hanya melintas cepat"/>
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Rectangle Grid.Column="1" Fill="#1AFFFFFF" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                        <!-- Right Column: Action when gaming -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Saat Game / Layar Penuh Aktif:" Foreground="{StaticResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Button x:Name="BtnGameActionIgnore" Content="🛡️ Abaikan Hover" Style="{StaticResource SettingPillBtn}" Background="#26FFFFFF" BorderBrush="#0A84FF" Foreground="#FFFFFF" Click="BtnGameActionIgnore_Click" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnGameActionHide" Content="👻 Sembunyikan" Style="{StaticResource SettingPillBtn}" Click="BtnGameActionHide_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Notch tidak akan terbuka saat kursor melintas ke atas." Foreground="#66EBEBF5" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 5: 🔔 NOTIFIKASI DISCORD & STEAM -->
                            <Border Background="#1CFFFFFF" BorderBrush="#20223A" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="🔔 NOTIFIKASI DISCORD &amp; STEAM" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" FontSize="9.5"/>
                                        <TextBlock Text="Pop-up pill Dynamic Island" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Toggles -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Notifikasi Aktif"
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9.5"
                                                  IsChecked="{Binding Settings.EnableNotifications, Mode=TwoWay}"/>
                                        <CheckBox Grid.Column="1" Content="Discord Pop-up" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9.5"
                                                  IsChecked="{Binding Settings.EnableDiscordNotif, Mode=TwoWay}"/>
                                        <CheckBox Grid.Column="2" Content="WhatsApp Pop-up"
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9.5"
                                                  IsChecked="{Binding Settings.EnableWhatsAppNotif, Mode=TwoWay}"/>
                                        <CheckBox Grid.Column="3" Content="Steam Pop-up"
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9.5"
                                                  IsChecked="{Binding Settings.EnableSteamNotif, Mode=TwoWay}"/>
                                    </Grid>

                                    <!-- Quick Simulator Buttons -->
                                    <Grid Margin="0,2,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="💬 Tes Discord" Style="{StaticResource SettingPillBtn}" Background="#26FFFFFF" BorderBrush="#5865F2" Foreground="#FFFFFF" Click="MenuTestDiscord_Click" ToolTip="Simulasi notifikasi pesan Discord"/>
                                        <Button Grid.Column="2" Content="🟢 Tes WhatsApp" Style="{StaticResource SettingPillBtn}" Background="#26FFFFFF" BorderBrush="#25D366" Foreground="#FFFFFF" Click="MenuTestWhatsApp_Click" ToolTip="Simulasi notifikasi pesan WhatsApp"/>
                                        <Button Grid.Column="4" Content="🎮 Tes Steam" Style="{StaticResource SettingPillBtn}" Background="#26FFFFFF" BorderBrush="#1A9FFF" Foreground="#FFFFFF" Click="MenuTestSteam_Click" ToolTip="Simulasi notifikasi undangan Steam"/>
                                        <Button Grid.Column="6" Content="⚙️ Izin Windows" Style="{StaticResource SettingPillBtn}" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" Foreground="#FFFFFF" Click="MenuOpenNotifSettings_Click" ToolTip="Buka Pengaturan Notifikasi Windows"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Notifikasi Discord, WhatsApp &amp; Steam akan otomatis muncul sebagai pill animasi. Klik banner untuk langsung membawa aplikasi ke layar depan." Foreground="#66EBEBF5" FontSize="9.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 6: 🏝️ ATOLL SUITE (AUDIO FEEDBACK & CLIPBOARD) -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏝️" FontSize="11" Margin="0,0,4,0" Foreground="#F2FFFFFF" />
                                            <TextBlock Text="FITUR ATOLL SUITE" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" FontSize="9.5"/>
                                        </StackPanel>
                                        <TextBlock Text="Audio Feedback, Clipboard &amp; System Tiles" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Toggles -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Efek Suara Atoll" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9.5"
                                                  IsChecked="{Binding Settings.EnableSoundEffects, Mode=TwoWay}"
                                                  ToolTip="Efek audio feedback asli Atoll (Expand, Lock, Timer, Baterai)"/>
                                        <CheckBox Grid.Column="1" Content="Clipboard Manager" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9.5"
                                                  IsChecked="{Binding Settings.EnableClipboardManager, Mode=TwoWay}"
                                                  ToolTip="Panel riwayat copy teks terintegrasi di navbar pulau"/>
                                        <CheckBox Grid.Column="2" Content="Musik Minimalis" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9.5"
                                                  IsChecked="{Binding Settings.EnableMinimalisticMusic, Mode=TwoWay}"
                                                  ToolTip="Tampilan musik minimalis Atoll"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Atoll Suite menambahkan efek suara feedback interaktif, pelacak clipboard otomatis, pemilih warna piksel layar (Color Picker), dan ubin sistem Apple-style." Foreground="#66EBEBF5" FontSize="9.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- VIEW 9: 🗂 STARTBAR & ACTIVE WINDOW MANAGER -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTaskbar" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,2,0,8">
                        <StackPanel Orientation="Vertical">
                            <!-- SEARCH BAR -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#99EBEBF5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TaskbarSearchBox" Grid.Column="1" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="10.5" VerticalAlignment="Center" TextChanged="TaskbarSearchBox_TextChanged" CaretBrush="#0A84FF"/>
                                    <TextBlock x:Name="TaskbarSearchPlaceholder" Grid.Column="1" Text="Cari aplikasi atau jendela yang aktif..." Foreground="#66EBEBF5" FontSize="10" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <Button x:Name="BtnRefreshTaskbar" Grid.Column="2" Content="🔄 Refresh" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#0A84FF" FontSize="9" Padding="8,3" Click="BtnRefreshTaskbar_Click" ToolTip="Pindai ulang jendela aktif"/>
                                </Grid>
                            </Border>

                            <!-- QUICK DOCK & LAUNCHER (START APPS) -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="PINNED &amp; QUICK LAUNCH" Foreground="#99EBEBF5" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="📁 Explorer" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchExplorer_Click" ToolTip="Buka File Explorer"/>
                                        <Button Content="💻 Terminal" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchTerminal_Click" ToolTip="Buka PowerShell / Terminal"/>
                                        <Button Content="🌐 Browser" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchBrowser_Click" ToolTip="Buka Web Browser"/>
                                        <Button Content="📝 Notepad" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchNotepad_Click" ToolTip="Buka Notepad"/>
                                        <Button Content="⚡ Taskmgr" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchTaskmgr_Click" ToolTip="Buka Windows Task Manager"/>
                                        <Button Content="⚙️ Settings" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchSettings_Click" ToolTip="Buka Windows Settings"/>
                                        <Button Content="🔒 Lock PC" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#FF453A" Margin="0,0,5,3" Click="BtnLockPC_Click" ToolTip="Kunci Windows Workstation"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ACTIVE WINDOWS LIST (TASKBAR) -->
                            <Border Background="{StaticResource MacCardFill}" BorderBrush="{StaticResource MacCardStroke}" BorderThickness="1" CornerRadius="18" Padding="10,7" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="JENDELA AKTIF (ACTIVE WINDOWS)" Foreground="#99EBEBF5" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtActiveWindowsCount" Text="0 Jendela" Foreground="#30D158" FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl x:Name="ActiveWindowsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Window Icon -->
                                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                        <!-- Window Title & Process -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ProcessName}" Foreground="#66EBEBF5" FontSize="9"/>
                                                        </StackPanel>

                                                        <!-- Minimize Button -->
                                                        <Button Grid.Column="2" Content="🗕" Style="{StaticResource GhostBtn}" Foreground="#99EBEBF5" FontSize="9" Padding="5,2" Tag="{Binding Hwnd}" Click="BtnWindowMinimize_Click" ToolTip="Kecilkan jendela"/>

                                                        <!-- Focus Button -->
                                                        <Button Grid.Column="3" Content="Fokus" Style="{StaticResource NavPillBtn}" Background="#26FFFFFF" Foreground="#0A84FF" FontSize="9.5" Padding="6,2" Margin="3,0,3,0" Tag="{Binding Hwnd}" Click="BtnWindowFocus_Click" ToolTip="Aktifkan jendela ini"/>

                                                        <!-- Close Button -->
                                                        <Button Grid.Column="4" Content="✕" Style="{StaticResource GhostBtn}" Foreground="#FF453A" FontSize="9.5" Padding="5,2" Tag="{Binding Hwnd}" Click="BtnWindowClose_Click" ToolTip="Tutup jendela"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

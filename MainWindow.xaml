                    <!-- ============================================== -->
                    <!-- VIEW 8.5: ⏳ SCREEN TIME & APP USAGE (PONI SCREENSHOT 5) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewScreenTime" Visibility="Collapsed" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" /> <!-- Donut & Activity -->
                            <ColumnDefinition Width="1" />   <!-- Divider -->
                            <ColumnDefinition Width="*" />   <!-- Most Used Apps List -->
                        </Grid.ColumnDefinitions>

                        <!-- Left: Donut Chart & Activity -->
                        <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Donut + Legend -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Donut Ring -->
                                    <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,8,0">
                                        <Ellipse Width="46" Height="46" Stroke="#2A2A38" StrokeThickness="7"/>
                                        <Ellipse Width="46" Height="46" Stroke="#0A84FF" StrokeThickness="7" StrokeDashArray="6 4"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScreenTime.TotalTimeFormatted, FallbackValue='6m'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Today" Foreground="#8E8E93" FontSize="6.5" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Legend -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Ellipse Width="5" Height="5" Fill="#0A84FF" Margin="0,0,4,0"/>
                                            <TextBlock Text="Other" Foreground="#C7C7CC" FontSize="8"/>
                                            <TextBlock Text="{Binding ScreenTime.OtherTimeFormatted, FallbackValue='4m'}" Foreground="#8E8E93" FontSize="8" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="0,0,4,0"/>
                                            <TextBlock Text="System" Foreground="#C7C7CC" FontSize="8"/>
                                            <TextBlock Text="{Binding ScreenTime.SystemTimeFormatted, FallbackValue='2m'}" Foreground="#8E8E93" FontSize="8" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Middle: Mini Bar Chart Indicator -->
                                <Grid Grid.Row="1" Margin="0,6,0,4" VerticalAlignment="Center">
                                    <Rectangle Height="1" Fill="#2A2A38" VerticalAlignment="Bottom"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Rectangle Width="3" Height="6" Fill="#2A2A38" Margin="2,0"/>
                                        <Rectangle Width="3" Height="10" Fill="#2A2A38" Margin="2,0"/>
                                        <Rectangle Width="3" Height="22" Fill="#0A84FF" Margin="2,0"/>
                                        <Rectangle Width="3" Height="8" Fill="#2A2A38" Margin="2,0"/>
                                        <Rectangle Width="3" Height="4" Fill="#2A2A38" Margin="2,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Footer: App Switches Count -->
                                <TextBlock Grid.Row="2" Text="{Binding ScreenTime.SwitchesSummaryText, FallbackValue='62 app switches · more: Antigravity'}" 
                                           Foreground="#636366" FontSize="7" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="#25FFFFFF" Width="1" Height="80" VerticalAlignment="Center"/>

                        <!-- Right: Most Used Apps List -->
                        <Border Grid.Column="2" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header + Pill Filter -->
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Width="9" Height="9" Fill="#8E8E93" Margin="0,0,4,0" VerticalAlignment="Center" Data="M5,9.2h3V19H5V9.2zM10.6,5h2.8v14h-2.8V5zM16.2,13H19v6h-2.8V13z"/>
                                        <TextBlock Text="MOST USED" Foreground="#8E8E93" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#25FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#25FFFFFF" CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="Today" Foreground="#FFFFFF" FontSize="7.5" FontWeight="Bold"/>
                                            </Border>
                                            <Border Padding="5,1" Margin="2,0,0,0">
                                                <TextBlock Text="7 days" Foreground="#8E8E93" FontSize="7.5"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Apps List -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ScreenTime.MostUsedApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1.5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Icon -->
                                                <Image Grid.Column="0" Source="{Binding AppIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <!-- App Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding AppName}" Foreground="#FFFFFF" FontSize="8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="3,0,4,0"/>
                                                <!-- Blue Progress Bar -->
                                                <ProgressBar Grid.Column="2" Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" 
                                                             Background="#25FFFFFF" Foreground="#0A84FF" BorderThickness="0" VerticalAlignment="Center"/>
                                                <!-- Duration -->
                                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#8E8E93" FontSize="7.5" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>





                    <!-- ============================================== -->
                    <!-- VIEW 9: 🎛️ REALTIME AUDIO MIXER & MIC MONITOR (Matches Screenshot) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewMixer" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,1,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /> <!-- LEFT: OUTPUT CARD -->
                            <ColumnDefinition Width="*" /> <!-- RIGHT: MIKROFON CARD -->
                        </Grid.ColumnDefinitions>

                        <!-- ========================================== -->
                        <!-- LEFT CARD: OUTPUT                          -->
                        <!-- ========================================== -->
                        <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="0.8" CornerRadius="14" Padding="10,8" Margin="0,0,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Master Volume Header -->
                                    <RowDefinition Height="*" />    <!-- Per-App Sliders List -->
                                </Grid.RowDefinitions>

                                <!-- Header: OUTPUT + 🔊 + Slider + 65 -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Label OUTPUT -->
                                    <TextBlock Grid.Column="0" Text="OUTPUT" Foreground="#6E6E78" FontWeight="Bold" FontSize="9.5" VerticalAlignment="Center"/>

                                    <!-- Speaker Icon -->
                                    <TextBlock Grid.Column="1" Text="🔊" FontSize="9.5" Foreground="#8E8E93" VerticalAlignment="Center" Margin="8,0,6,0"/>

                                    <!-- Master Volume Slider -->
                                    <Slider Grid.Column="2" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" 
                                            Value="{Binding Audio.MasterOutputVolume, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>

                                    <!-- Raw Master Value (no %) -->
                                    <TextBlock Grid.Column="3" Text="{Binding Audio.MasterOutputVolume, RelativeSource={RelativeSource AncestorType=Window}}" 
                                               Foreground="#8E8E93" FontWeight="Bold" FontSize="9.5" Width="20" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- Per-App Audio Sessions List (Discord, FiveM, Suara sistem, Steam) -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Audio.OutputSessions, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="22" Margin="0,1,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" /> <!-- App Badge Icon -->
                                                    <ColumnDefinition Width="86" /> <!-- App Name -->
                                                    <ColumnDefinition Width="12" /> <!-- Green Active Dot -->
                                                    <ColumnDefinition Width="*" />  <!-- Volume Slider -->
                                                    <ColumnDefinition Width="18" /> <!-- Mute / Speaker Icon -->
                                                </Grid.ColumnDefinitions>

                                                <!-- App Icon Badge -->
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4" Background="{Binding IconColor}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                </Border>

                                                <!-- App Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="9" FontWeight="Normal" 
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,2,0"/>

                                                <!-- Green Active Audio Dot (visible if currently playing audio) -->
                                                <Ellipse Grid.Column="2" Width="5" Height="5" Fill="#30D158" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Visibility="{Binding IsPlayingAudio, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Volume Slider -->
                                                <Slider Grid.Column="3" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="1" 
                                                        Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>

                                                <!-- Mute / Speaker Button -->
                                                <Button Grid.Column="4" Style="{StaticResource GhostBtn}" Padding="0" Click="SessionMute_Click" Tag="{Binding}" ToolTip="Mute / Suara" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding MuteGlyph}" FontSize="9.5" Foreground="#8E8E93"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- ========================================== -->
                        <!-- RIGHT CARD: MIKROFON                       -->
                        <!-- ========================================== -->
                        <Border Grid.Column="1" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="0.8" CornerRadius="14" Padding="10,8" Margin="4,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Master Mic Header -->
                                    <RowDefinition Height="Auto" /> <!-- "Dipakai oleh" Sub-Header -->
                                    <RowDefinition Height="*" />    <!-- Active Mic Apps List -->
                                </Grid.RowDefinitions>

                                <!-- Header: MIKROFON + 🎤 + Slider + 100 -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Label MIKROFON -->
                                    <TextBlock Grid.Column="0" Text="MIKROFON" Foreground="#6E6E78" FontWeight="Bold" FontSize="9.5" VerticalAlignment="Center"/>

                                    <!-- Mic Icon -->
                                    <TextBlock Grid.Column="1" Text="🎤" FontSize="9.5" Foreground="#8E8E93" VerticalAlignment="Center" Margin="8,0,6,0"/>

                                    <!-- Master Mic Slider -->
                                    <Slider Grid.Column="2" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" 
                                            Value="{Binding Audio.MasterMicVolume, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>

                                    <!-- Raw Master Value (no %) -->
                                    <TextBlock Grid.Column="3" Text="{Binding Audio.MasterMicVolume, RelativeSource={RelativeSource AncestorType=Window}}" 
                                               Foreground="#8E8E93" FontWeight="Bold" FontSize="9.5" Width="20" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- Sub-Header: Dipakai oleh -->
                                <TextBlock Grid.Row="1" Text="Dipakai oleh" Foreground="#50505A" FontSize="8.5" Margin="0,0,0,4"/>

                                <!-- Active Mic Apps List (FiveM, Discord, Wispr Flow) -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Audio.MicApps, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="22" Margin="0,1,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" /> <!-- App Badge Icon -->
                                                    <ColumnDefinition Width="*" />  <!-- App Name -->
                                                    <ColumnDefinition Width="Auto" /><!-- Orange Dot + aktif · soundtech -->
                                                </Grid.ColumnDefinitions>

                                                <!-- App Icon Badge -->
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4" Background="{Binding IconColor}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                </Border>

                                                <!-- App Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding AppName}" Foreground="#FFFFFF" FontSize="9" 
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,6,0"/>

                                                <!-- Amber Dot + aktif · soundtech (Matches Image 2) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" 
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse Width="5" Height="5" Fill="#FF9F0A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#FF9F0A" FontSize="8.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>


                    <!-- ============================================== -->
                    <!-- VIEW 8: ⚙️ COMPREHENSIVE SETTINGS & CUSTOMIZATION -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewSettings" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,2,0,8">
                        <StackPanel Orientation="Vertical">

                            <!-- APP BRANDING HEADER -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="pack://application:,,,/DynamicIsland;component/Assets/logo.png" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Dynamic Island Pro" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="Edisi Eksklusif Windows 11 • Realtime macOS Notch" Foreground="{StaticResource TextSecondary}" FontSize="8.5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION 1: 📏 UKURAN NOTCH (SIZING & PRESETS) -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📏" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Ukuran Dynamic Island" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="10.5"/>
                                        </StackPanel>
                                        <!-- Quick Presets -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Kecil (Compact)" Style="{StaticResource SettingPillBtn}" Click="PresetCompact_Click" Margin="0,0,4,0"/>
                                            <Button Content="Standar" Style="{StaticResource SettingPillBtn}" Click="PresetDefault_Click" Margin="0,0,4,0"/>
                                            <Button Content="Besar (Large)" Style="{StaticResource SettingPillBtn}" Click="PresetLarge_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Sliders Grid (2 Columns: Compact size vs Expanded size) -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Compact Size Controls -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Saat Tertutup (Idle Notch)" Foreground="{StaticResource TextSecondary}" FontSize="8.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <!-- Compact Width -->
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Lebar Idle" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderCompactW, StringFormat={}{0:0} px}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderCompactW" Style="{StaticResource AppleSlider}" Minimum="180" Maximum="320" Value="{Binding Settings.CompactWidth, Mode=TwoWay}" ValueChanged="SliderDimensions_ValueChanged"/>

                                            <!-- Compact Height -->
                                            <Grid Margin="0,4,0,2">
                                                <TextBlock Text="Tinggi Idle" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderCompactH, StringFormat={}{0:0} px}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderCompactH" Style="{StaticResource AppleSlider}" Minimum="28" Maximum="46" Value="{Binding Settings.CompactHeight, Mode=TwoWay}" ValueChanged="SliderDimensions_ValueChanged"/>
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Rectangle Grid.Column="1" Fill="#1E1E26" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                        <!-- Right: Expanded Size Controls -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Saat Terbuka (Expanded Island)" Foreground="{StaticResource TextSecondary}" FontSize="8.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <!-- Expanded Width -->
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Lebar Terbuka" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderExpandedW, StringFormat={}{0:0} px}" Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderExpandedW" Style="{StaticResource AppleSlider}" Minimum="480" Maximum="780" Value="{Binding Settings.ExpandedWidth, Mode=TwoWay}" ValueChanged="SliderDimensions_ValueChanged"/>

                                            <!-- Expanded Height -->
                                            <Grid Margin="0,4,0,2">
                                                <TextBlock Text="Tinggi Terbuka" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderExpandedH, StringFormat={}{0:0} px}" Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderExpandedH" Style="{StaticResource AppleSlider}" Minimum="75" Maximum="140" Value="{Binding Settings.ExpandedHeight, Mode=TwoWay}" ValueChanged="SliderDimensions_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mode Idle Saat Tertutup Selection -->
                                    <Border Background="#20FFFFFF" BorderBrush="#252534" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎭" FontSize="10" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Tampilan Default Saat Idle (Tertutup):" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                                </StackPanel>
                                                <TextBlock Text="Pilih mode tampilan utama" Foreground="{StaticResource TextSecondary}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="🔋 Baterai" Style="{StaticResource SettingPillBtn}" Margin="0,0,2,0" Click="BtnSetIdleBattery_Click"/>
                                                <Button Grid.Column="1" Content="🎵 Musik" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnSetIdleMusic_Click"/>
                                                <Button Grid.Column="2" Content="🎤 Lirik" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnSetIdleLyrics_Click"/>
                                                <Button Grid.Column="3" Content="⚡ Performa" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnSetIdlePerf_Click"/>
                                                <Button x:Name="BtnSetIdleCat" Grid.Column="4" Content="🦖 Nailong" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnSetIdleCat_Click"/>
                                                <Button Grid.Column="5" Content="🕒 Jam" Style="{StaticResource SettingPillBtn}" Margin="2,0,0,0" Click="BtnSetIdleClock_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pilihan Karakter Animasi (Nailong vs Spongebob) -->
                                    <Border Background="#20FFFFFF" BorderBrush="#252534" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,6,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎬" FontSize="10" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Pilihan Karakter Animasi:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="9"/>
                                                </StackPanel>
                                                <TextBlock Text="Pilih animasi menari di island" Foreground="{StaticResource TextSecondary}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnCharNailong" Grid.Column="0" Content="🦖 Nailong" Style="{StaticResource SettingPillBtn}" Margin="0,0,2,0" Click="BtnCharNailong_Click"/>
                                                <Button x:Name="BtnCharSpongebob" Grid.Column="1" Content="🧽 Spongebob" Style="{StaticResource SettingPillBtn}" Margin="2,0,2,0" Click="BtnCharSpongebob_Click"/>
                                                <Button x:Name="BtnCharMinion" Grid.Column="2" Content="🍌 Minion" Style="{StaticResource SettingPillBtn}" Margin="2,0,0,0" Click="BtnCharMinion_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>


                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: 🎯 POSISI, OPASITAS & LAYAR -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Position Offset -->
                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🧭" FontSize="10" Margin="0,0,4,0"/>
                                                <TextBlock Text="Posisi Horizontal (X Offset)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="9"/>
                                            </StackPanel>
                                            <Button Content="Tengah" Style="{StaticResource SettingPillBtn}" Click="BtnResetX_Click" HorizontalAlignment="Right" Padding="6,1"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Geser Kiri / Kanan" Foreground="{StaticResource TextSecondary}" FontSize="8"/>
                                            <TextBlock Text="{Binding Value, ElementName=SliderPosX, StringFormat={}{0:0} px}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="8" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderPosX" Style="{StaticResource AppleSlider}" Minimum="-350" Maximum="350" Value="{Binding Settings.PositionOffsetX, Mode=TwoWay}" ValueChanged="SliderPosX_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Rectangle Grid.Column="1" Fill="#1E1E26" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                    <!-- Right: Opacity & Always on Top -->
                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="👁️" FontSize="10" Margin="0,0,4,0"/>
                                                <TextBlock Text="Kepekatan &amp; Visibilitas" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="9"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Opasitas Notch" Foreground="{StaticResource TextSecondary}" FontSize="8"/>
                                            <TextBlock Text="{Binding Value, ElementName=SliderOpacity, StringFormat={}{0:0}%}" Foreground="{StaticResource BatteryGreen}" FontWeight="Bold" FontSize="8" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderOpacity" Style="{StaticResource AppleSlider}" Minimum="60" Maximum="100" Value="{Binding Settings.NotchOpacity, Mode=TwoWay}" ValueChanged="SliderOpacity_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION 3: ⚡ INTERAKSI & OTOMATISASI -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: Toggles -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <CheckBox x:Name="ChkAutoExpand" Content="Buka otomatis saat kursor mendekat (Hover)" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,2,0,4"
                                                  IsChecked="{Binding Settings.AutoExpandOnHover, Mode=TwoWay}" Click="ChkAutoExpand_Click"/>

                                        <CheckBox x:Name="ChkAutoMusicSetting" Content="Otomatis tampilkan musik saat berputar" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,4,0,4"
                                                  IsChecked="{Binding Settings.AutoSwitchMusic, Mode=TwoWay}" Click="ChkAutoMusic_Click"/>

                                        <CheckBox x:Name="ChkAlwaysOnTop" Content="Selalu di atas jendela lain (Always on Top)" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,4,0,0"
                                                  IsChecked="{Binding Settings.AlwaysOnTop, Mode=TwoWay}" Click="ChkAlwaysOnTop_Click"/>
                                    </StackPanel>

                                    <!-- Column 1: System & Reset -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <CheckBox x:Name="ChkStartWithWindows" Content="Mulai otomatis saat Windows dinyalakan" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,2,0,4"
                                                  IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}"/>

                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="Animasi" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="⚡ Cepat" Style="{StaticResource SettingPillBtn}" Click="SpeedFast_Click" Margin="0,0,3,0"/>
                                                <Button Content="🍏 Apple" Style="{StaticResource SettingPillBtn}" Click="SpeedNormal_Click" Margin="0,0,3,0"/>
                                                <Button Content="🧘 Halus" Style="{StaticResource SettingPillBtn}" Click="SpeedSlow_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="🔄 Kembalikan ke Default Pabrik" Style="{StaticResource SettingPillBtn}" Background="#25FFFFFF" BorderBrush="#40FFFFFF" Foreground="#FF453A" Margin="0,8,0,0" Click="BtnResetAllSettings_Click" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION 4: 🎮 MODE GAME & ANTI-GANGGUAN (ANTI-DISRUPTION) -->
                            <Border Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎮" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Mode Game &amp; Anti-Gangguan Layar Penuh" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="10.5"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleGameManual" Content="🎮 Mode Game: OFF" Style="{StaticResource SettingPillBtn}" Background="#25FFFFFF" BorderBrush="#40FFFFFF" Foreground="#FF375F" Click="BtnToggleGameManual_Click" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Auto Game Detection & Dwell Delay -->
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkAutoGameMode" Content="Deteksi Game / Layar Penuh Otomatis" 
                                                      Foreground="{StaticResource TextPrimary}" FontSize="9" Margin="0,1,0,4"
                                                      IsChecked="{Binding Settings.AutoGameMode, Mode=TwoWay}" Click="ChkAutoGameMode_Click"/>

                                            <Grid Margin="0,4,0,2">
                                                <TextBlock Text="Tunda Buka Hover (Dwell Delay)" Foreground="{StaticResource TextSecondary}" FontSize="8.5"/>
                                                <TextBlock Text="{Binding Value, ElementName=SliderHoverDelay, StringFormat={}{0:0} ms}" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderHoverDelay" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="400" Value="{Binding Settings.HoverDwellDelayMs, Mode=TwoWay}" ToolTip="Cegah notch terbuka saat kursor hanya melintas cepat"/>
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Rectangle Grid.Column="1" Fill="#241C26" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                        <!-- Right Column: Action when gaming -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Saat Game / Layar Penuh Aktif:" Foreground="{StaticResource TextSecondary}" FontSize="8.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Button x:Name="BtnGameActionIgnore" Content="🛡️ Abaikan Hover" Style="{StaticResource SettingPillBtn}" Background="#25FFFFFF" BorderBrush="#0A84FF" Foreground="#FFFFFF" Click="BtnGameActionIgnore_Click" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnGameActionHide" Content="👻 Sembunyikan" Style="{StaticResource SettingPillBtn}" Click="BtnGameActionHide_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Notch tidak akan terbuka saat kursor melintas ke atas." Foreground="#6E6E78" FontSize="7.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 5: 🔔 NOTIFIKASI DISCORD & STEAM -->
                            <Border Background="#20FFFFFF" BorderBrush="#20223A" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="🔔 NOTIFIKASI DISCORD &amp; STEAM" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="9.5"/>
                                        <TextBlock Text="Pop-up pill Dynamic Island" Foreground="{StaticResource TextSecondary}" FontSize="8" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Toggles -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Notifikasi Aktif" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="8.5"
                                                  IsChecked="{Binding Settings.EnableNotifications, Mode=TwoWay}"/>
                                        <CheckBox Grid.Column="1" Content="Discord Pop-up" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="8.5"
                                                  IsChecked="{Binding Settings.EnableDiscordNotif, Mode=TwoWay}"/>
                                        <CheckBox Grid.Column="2" Content="Steam Pop-up" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="8.5"
                                                  IsChecked="{Binding Settings.EnableSteamNotif, Mode=TwoWay}"/>
                                    </Grid>

                                    <!-- Quick Simulator Buttons -->
                                    <Grid Margin="0,2,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="💬 Tes Discord" Style="{StaticResource SettingPillBtn}" Background="#25FFFFFF" BorderBrush="#5865F2" Foreground="#FFFFFF" Click="MenuTestDiscord_Click" ToolTip="Simulasi notifikasi pesan Discord"/>
                                        <Button Grid.Column="2" Content="🎮 Tes Steam" Style="{StaticResource SettingPillBtn}" Background="#25FFFFFF" BorderBrush="#1A9FFF" Foreground="#FFFFFF" Click="MenuTestSteam_Click" ToolTip="Simulasi notifikasi undangan Steam"/>
                                        <Button Grid.Column="4" Content="⚙️ Izin Windows" Style="{StaticResource SettingPillBtn}" Background="#25FFFFFF" BorderBrush="#40FFFFFF" Foreground="#FFFFFF" Click="MenuOpenNotifSettings_Click" ToolTip="Buka Pengaturan Notifikasi Windows"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Notifikasi Discord &amp; Steam akan otomatis muncul sebagai pill animasi. Klik banner untuk langsung membawa aplikasi ke layar depan." Foreground="#6E6E78" FontSize="7.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 6: 🏝️ ATOLL SUITE (AUDIO FEEDBACK & CLIPBOARD) -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏝️" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="FITUR ATOLL SUITE" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="9.5"/>
                                        </StackPanel>
                                        <TextBlock Text="Audio Feedback, Clipboard &amp; System Tiles" Foreground="{StaticResource TextSecondary}" FontSize="8" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Toggles -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Efek Suara Atoll" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="8.5"
                                                  IsChecked="{Binding Settings.EnableSoundEffects, Mode=TwoWay}"
                                                  ToolTip="Efek audio feedback asli Atoll (Expand, Lock, Timer, Baterai)"/>
                                        <CheckBox Grid.Column="1" Content="Clipboard Manager" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="8.5"
                                                  IsChecked="{Binding Settings.EnableClipboardManager, Mode=TwoWay}"
                                                  ToolTip="Panel riwayat copy teks terintegrasi di navbar pulau"/>
                                        <CheckBox Grid.Column="2" Content="Musik Minimalis" 
                                                  Foreground="{StaticResource TextPrimary}" FontSize="8.5"
                                                  IsChecked="{Binding Settings.EnableMinimalisticMusic, Mode=TwoWay}"
                                                  ToolTip="Tampilan musik minimalis Atoll"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Atoll Suite menambahkan efek suara feedback interaktif, pelacak clipboard otomatis, pemilih warna piksel layar (Color Picker), dan ubin sistem Apple-style." Foreground="#6E6E78" FontSize="7.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- VIEW 9: 🗂 STARTBAR & ACTIVE WINDOW MANAGER -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTaskbar" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,2,0,8">
                        <StackPanel Orientation="Vertical">
                            <!-- SEARCH BAR -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TaskbarSearchBox" Grid.Column="1" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="10.5" VerticalAlignment="Center" TextChanged="TaskbarSearchBox_TextChanged" CaretBrush="#0A84FF"/>
                                    <TextBlock x:Name="TaskbarSearchPlaceholder" Grid.Column="1" Text="Cari aplikasi atau jendela yang aktif..." Foreground="#585860" FontSize="10" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <Button x:Name="BtnRefreshTaskbar" Grid.Column="2" Content="🔄 Refresh" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#0A84FF" FontSize="9" Padding="8,3" Click="BtnRefreshTaskbar_Click" ToolTip="Pindai ulang jendela aktif"/>
                                </Grid>
                            </Border>

                            <!-- QUICK DOCK & LAUNCHER (START APPS) -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="PINNED &amp; QUICK LAUNCH" Foreground="#8E8E93" FontSize="8.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="📁 Explorer" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchExplorer_Click" ToolTip="Buka File Explorer"/>
                                        <Button Content="💻 Terminal" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchTerminal_Click" ToolTip="Buka PowerShell / Terminal"/>
                                        <Button Content="🌐 Browser" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchBrowser_Click" ToolTip="Buka Web Browser"/>
                                        <Button Content="📝 Notepad" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchNotepad_Click" ToolTip="Buka Notepad"/>
                                        <Button Content="⚡ Taskmgr" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchTaskmgr_Click" ToolTip="Buka Windows Task Manager"/>
                                        <Button Content="⚙️ Settings" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FFFFFF" Margin="0,0,5,3" Click="BtnLaunchSettings_Click" ToolTip="Buka Windows Settings"/>
                                        <Button Content="🔒 Lock PC" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#FF453A" Margin="0,0,5,3" Click="BtnLockPC_Click" ToolTip="Kunci Windows Workstation"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ACTIVE WINDOWS LIST (TASKBAR) -->
                            <Border Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="JENDELA AKTIF (ACTIVE WINDOWS)" Foreground="#8E8E93" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtActiveWindowsCount" Text="0 Jendela" Foreground="#30D158" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl x:Name="ActiveWindowsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Window Icon -->
                                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                        <!-- Window Title & Process -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ProcessName}" Foreground="#72727E" FontSize="8"/>
                                                        </StackPanel>

                                                        <!-- Minimize Button -->
                                                        <Button Grid.Column="2" Content="🗕" Style="{StaticResource GhostBtn}" Foreground="#8E8E93" FontSize="9" Padding="5,2" Tag="{Binding Hwnd}" Click="BtnWindowMinimize_Click" ToolTip="Kecilkan jendela"/>

                                                        <!-- Focus Button -->
                                                        <Button Grid.Column="3" Content="Fokus" Style="{StaticResource NavPillBtn}" Background="#25FFFFFF" Foreground="#0A84FF" FontSize="8.5" Padding="6,2" Margin="3,0,3,0" Tag="{Binding Hwnd}" Click="BtnWindowFocus_Click" ToolTip="Aktifkan jendela ini"/>

                                                        <!-- Close Button -->
                                                        <Button Grid.Column="4" Content="✕" Style="{StaticResource GhostBtn}" Foreground="#FF453A" FontSize="9.5" Padding="5,2" Tag="{Binding Hwnd}" Click="BtnWindowClose_Click" ToolTip="Tutup jendela"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

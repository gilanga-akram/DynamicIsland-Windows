<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVM>false</RetainVM>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\lake_dock_wallpaper.jpg" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\saweria_qr.png" />
    <Resource Include="Assets\paypal_qr.png" />
    <Resource Include="Assets\nailong.png" />
    <Resource Include="Assets\nailong_dancing.png" />
    <Resource Include="Assets\nailong_dance\*.png" />
    <Resource Include="Assets\spongebob_dance\*.png" />
    <Resource Include="Assets\minion_dance\*.png" />
    <Resource Include="Assets\icon_*.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Sounds\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>

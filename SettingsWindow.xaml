<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Settings"
        Height="700" Width="1000"
        MinWidth="850" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#0F1013"
        Foreground="#FFFFFF"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ModernToggleSwitch" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="46" Height="26" VerticalAlignment="Center">
                            <Border x:Name="Track" Background="#32333A" CornerRadius="13" Width="46" Height="26"/>
                            <Border x:Name="Thumb" Background="#FFFFFF" CornerRadius="10" Width="20" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#22C55E"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1C22"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2D4A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Slider Style -->
        <Style x:Key="PositionSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#3B82F6" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#374151" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#3B82F6" Stroke="#FFFFFF" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Align Icon Button Style -->
        <Style x:Key="AlignBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#25272F"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for Dark ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Border x:Name="templateRoot" Background="#242630" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9CA3AF"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="#2D303E"/>
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#4B5563"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="#1C1E26"/>
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#242630"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="12,0,28,0"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        Background="#181A22"
                                        BorderBrush="#2E323D"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, ElementName=toggleButton}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="dropDownScrollViewer" SnapsToDevicePixels="True" Margin="4">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="RoundedBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#25272F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar (Width 230) -->
            <ColumnDefinition Width="230"/>
            <!-- Right Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- LEFT SIDEBAR                                    -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="#0F1013" BorderBrush="#1F2026" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header with App Logo & Title -->
                    <RowDefinition Height="Auto"/>
                    <!-- Scrollable Navigation Items -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Controls (Exit button) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="18,18,18,12" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Gold Crown G Logo -->
                    <Image Source="pack://application:,,,/DynamicIsland;component/Assets/logo.png" 
                           Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dynamic" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="v1.4.0" Foreground="#71717A" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12">
                    <StackPanel Orientation="Vertical">
                        <!-- SECTION: DYNAMIC -->
                        <TextBlock x:Name="TxtSectionDynamic" Text="DYNAMIC" Foreground="#52525B" FontWeight="Bold" FontSize="10.5" Margin="8,10,8,6"/>

                        <!-- Welcome -->
                        <Button x:Name="NavWelcome" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#2A1B0E" Margin="0,0,10,0">
                                    <TextBlock Text="🏠" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavWelcome" Text="Welcome" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- General (Active by default) -->
                        <Button x:Name="NavGeneral" Style="{StaticResource NavButtonStyle}" Tag="Active" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#1E293B" Margin="0,0,10,0">
                                    <TextBlock Text="⚙️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavGeneral" Text="General" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Modules -->
                        <Button x:Name="NavModules" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#261633" Margin="0,0,10,0">
                                    <TextBlock Text="🧩" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavModules" Text="Modules" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Live Activities -->
                        <Button x:Name="NavLiveActivities" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#311528" Margin="0,0,10,0">
                                    <TextBlock Text="🔔" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavLiveActivities" Text="Live Activities" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cat Buddy -->
                        <Button x:Name="NavCatBuddy" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#312211" Margin="0,0,10,0">
                                    <TextBlock Text="🐾" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavCatBuddy" Text="Cat Buddy" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cursor -->
                        <Button x:Name="NavCursor" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#302B12" Margin="0,0,10,0">
                                    <TextBlock Text="👆" FontSize="12" Foreground="#FACC15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavCursor" Text="Cursor" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- SECTION: MODULES -->
                        <TextBlock x:Name="TxtSectionModules" Text="MODULES" Foreground="#52525B" FontWeight="Bold" FontSize="10.5" Margin="8,16,8,6"/>

                        <!-- Ukuran Dynamic Island -->
                        <Button x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#112240" Margin="0,0,10,0">
                                    <TextBlock Text="📐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavDashboard" Text="Ukuran Dynamic" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Media -->
                        <Button x:Name="NavMedia" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#311422" Margin="0,0,10,0">
                                    <TextBlock Text="🎵" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavMedia" Text="Media" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Calendar -->
                        <Button x:Name="NavCalendar" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#331414" Margin="0,0,10,0">
                                    <TextBlock Text="📅" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavCalendar" Text="Calendar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Weather -->
                        <Button x:Name="NavWeather" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#0F2833" Margin="0,0,10,0">
                                    <TextBlock Text="⛅" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavWeather" Text="Weather" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Prayer Times -->
                        <Button x:Name="NavPrayerTimes" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#112F21" Margin="0,0,10,0">
                                    <TextBlock Text="🕌" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavPrayerTimes" Text="Prayer Times" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Pomodoro -->
                        <Button x:Name="NavPomodoro" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#331E12" Margin="0,0,10,0">
                                    <TextBlock Text="🍅" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavPomodoro" Text="Pomodoro" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Health -->
                        <Button x:Name="NavHealth" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#13301B" Margin="0,0,10,0">
                                    <TextBlock Text="💧" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavHealth" Text="Health" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Screen Time -->
                        <Button x:Name="NavScreenTime" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#241438" Margin="0,0,10,0">
                                    <TextBlock Text="⏱" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavScreenTime" Text="Screen Time" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Day Progress -->
                        <Button x:Name="NavDayProgress" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#11233F" Margin="0,0,10,0">
                                    <TextBlock Text="📊" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavDayProgress" Text="Day Progress" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Bluetooth & Wi-Fi -->
                        <Button x:Name="NavBluetoothWifi" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#102B38" Margin="0,0,10,0">
                                    <TextBlock Text="📶" FontSize="12" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavBluetoothWifi" Text="Bluetooth &amp; Wi-Fi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Aplikasi Dock -->
                        <Button x:Name="NavDockApps" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#152836" Margin="0,0,10,0">
                                    <TextBlock Text="⛵" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavDockApps" Text="Aplikasi Dock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Support Creator -->
                        <Button x:Name="NavSupportCreator" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#381324" Margin="0,0,10,0">
                                    <TextBlock Text="💖" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNavSupportCreator" Text="Support Creator" Foreground="#F472B6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer (Close & Exit) -->
                <Border Grid.Row="2" Padding="14,10" BorderBrush="#1F2026" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Vertical">
                        <Button x:Name="BtnQuickSupport" Content="💖 Support Creator" Style="{StaticResource RoundedBtnStyle}" Background="#2A1B28" Foreground="#F472B6" 
                                BorderBrush="#5E2347" BorderThickness="1" Padding="10,6" Margin="0,0,0,8"
                                FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnQuickSupport_Click"/>
                        <Button x:Name="BtnExitApp" Content="Keluar / Tutup Aplikasi" Style="{StaticResource RoundedBtnStyle}" Background="#221517" Foreground="#F87171" 
                                BorderBrush="#451A1A" BorderThickness="1" Padding="10,6" 
                                FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnExitApp_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- RIGHT MAIN CONTENT AREA                         -->
        <!-- ============================================== -->
        <Border Grid.Column="1" Background="#14151B" Padding="32,24,32,24">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Bar (Category Title) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Dynamic Page Scroll Area -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SECTION HEADER -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                    <Border x:Name="HeaderIconBox" Width="40" Height="40" Background="#23252C" CornerRadius="9" Margin="0,0,14,0">
                        <TextBlock x:Name="HeaderIconText" Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="HeaderTitleText" Text="General" Foreground="#FFFFFF" FontWeight="Bold" FontSize="26" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- PAGES CONTAINER -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- ========================================== -->
                        <!-- 1. PAGE: GENERAL                           -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageGeneral" Visibility="Visible">
                            <!-- BRANDING HEADER BANNER -->
                            <Border Background="#121218" BorderBrush="#252530" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="pack://application:,,,/DynamicIsland;component/Assets/logo.png" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Dynamic Island Pro" Foreground="#FFD700" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock x:Name="TxtBrandingSub" Text="Edisi Eksklusif Windows 11 • Realtime macOS Notch" Foreground="#9CA3AF" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,10">
                                <StackPanel Orientation="Vertical">

                                    <!-- Launch at login -->
                                    <Grid Margin="0,10">
                                        <TextBlock x:Name="TxtLaunchAtLoginTitle" Text="Launch at login" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ToggleLaunchAtLogin" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleLaunchAtLogin_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Show Dynamic on -->
                                    <Grid Margin="0,10">
                                        <TextBlock x:Name="TxtShowDynamicOn" Text="Show Dynamic on" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbDisplay" Style="{StaticResource DarkComboBoxStyle}" Width="180" HorizontalAlignment="Right" SelectionChanged="CmbDisplay_SelectionChanged">
                                            <ComboBoxItem Content="Primary display" IsSelected="True"/>
                                            <ComboBoxItem Content="Monitor 1"/>
                                            <ComboBoxItem Content="Monitor 2"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Language / Bahasa Aplikasi -->
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtGeneralLanguageTitle" Text="Bahasa Aplikasi (Language)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtGeneralLanguageDesc" Text="Pilih bahasa tampilan untuk Dynamic Island &amp; Menu Pengaturan" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="CmbLanguage" Style="{StaticResource DarkComboBoxStyle}" Width="220" SelectionChanged="CmbLanguage_SelectionChanged">
                                            <ComboBoxItem Tag="id" Content="🇮🇩 Bahasa Indonesia"/>
                                            <ComboBoxItem Tag="en-US" Content="🇺🇸 English (US)"/>
                                            <ComboBoxItem Tag="en-GB" Content="🇬🇧 English (UK)"/>
                                            <ComboBoxItem Tag="zh" Content="🇨🇳 简体中文 (Mandarin)"/>
                                            <ComboBoxItem Tag="ru" Content="🇷🇺 Русский (Russian)"/>
                                            <ComboBoxItem Tag="de" Content="🇩🇪 Deutsch (German)"/>
                                            <ComboBoxItem Tag="pl" Content="🇵🇱 Polski (Polish)"/>
                                            <ComboBoxItem Tag="ja" Content="🇯🇵 日本語 (Japanese)"/>
                                            <ComboBoxItem Tag="ko" Content="🇰🇷 한국어 (Korean)"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Position along the top -->
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtPositionTitle" Text="Position along the top" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtPositionDesc" Text="Or just drag Dynamic left/right (when it's open: drag its top bar). It snaps to the centre." 
                                                       Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Button Style="{StaticResource AlignBtnStyle}" Content="◀" ToolTip="Rata Kiri" Click="BtnAlignLeft_Click"/>
                                            <Button Style="{StaticResource AlignBtnStyle}" Content="||" ToolTip="Tengah (Default 50%)" Click="BtnAlignCenter_Click"/>
                                            <Button Style="{StaticResource AlignBtnStyle}" Content="▶" ToolTip="Rata Kanan" Click="BtnAlignRight_Click"/>
                                            <Slider x:Name="SliderPosition" Style="{StaticResource PositionSliderStyle}" Width="160" Minimum="0" Maximum="100" Value="50" 
                                                    ValueChanged="SliderPosition_ValueChanged" Margin="8,0,8,0"/>
                                            <TextBlock x:Name="TxtPositionPercent" Text="50%" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Lock position -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtLockPositionTitle" Text="Lock position" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtLockPositionDesc" Text="Stop Dynamic from being dragged by accident" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleLockPosition" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleLockPosition_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Hide when an app is fullscreen -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtHideFullscreenTitle" Text="Hide when an app is fullscreen" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtHideFullscreenDesc" Text="Games, videos and presentations" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleHideFullscreen" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleHideFullscreen_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Auto-hide -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtAutoHideTitle" Text="Auto-hide" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtAutoHideDesc" Text="Dynamic waits above the top edge of the screen and comes down when you move the mouse there, so maximized windows get the whole screen. Alerts, reminders and the volume HUD still show." 
                                                       Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleAutoHide" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleAutoHide_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Hide button -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtHideButtonTitle" Text="Hide button" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtHideButtonDesc" Text="An eye button at the top of the open Dynamic that tucks it away to a thin handle at the top edge, out of the way of tabs and title bars. Click or tap the handle to bring it back. Right-clicking Dynamic twice does the same." 
                                                       Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleHideButton" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleHideButton_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Touchscreen support -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtTouchscreenTitle" Text="Touchscreen support" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtTouchscreenDesc" Text="A tap on Dynamic reaches Dynamic. Without it, Dynamic only takes clicks once the mouse points at it, so a finger's tap goes to the window below. Taps beside Dynamic still go there." 
                                                       Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleTouchscreen" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleTouchscreen_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Keep windows below Dynamic -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtKeepWindowsBelowTitle" Text="Keep windows below Dynamic" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtKeepWindowsBelowDesc" Text="Maximized windows start under Dynamic, so it never covers tabs or title bars. Uses a thin strip at the top of the screen. Not used while Auto-hide is on." 
                                                       Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleKeepWindowsBelow" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleKeepWindowsBelow_Click"/>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 2. PAGE: MODULES (HABISIN SEMUA MODUL)     -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageModules" Visibility="Collapsed">
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TxtModulesHeaderTitle" Text="Aktifkan &amp; Sesuaikan Tampilan Modul Tab Ribbon" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                    <!-- Dynamic Island (Poni Atas) Switch -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock x:Name="TxtDynamicIslandModuleTitle" Text="Dynamic Island (Poni Atas)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtDynamicIslandModuleDesc" Text="Tampilkan Dynamic Island di bagian atas layar. Matikan switch ini jika Anda hanya ingin menggunakan Dock saja tanpa Dynamic Island." Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleEnableDynamicIsland" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleEnableDynamicIsland_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Sound Effects -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSoundEffectsTitle" Text="Sound Effects (Audio Feedback)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtSoundEffectsDesc" Text="Efek suara haptic audio saat klik dan buka tab Dynamic Island" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleSoundEffects" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleSoundEffects_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Clipboard Manager & Shelf -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtClipboardTitle" Text="Shelf &amp; Clipboard Drop Hub" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtClipboardDesc" Text="Aktifkan rak penyimpanan file sementara dan riwayat copy teks" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleClipboard" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleClipboard_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Quick Tools Palette -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtQuickToolsTitle" Text="Quick Tools &amp; Utilities" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtQuickToolsDesc" Text="Akses cepat Snipping Tool, Eyedropper, Task Manager, dan Kalkulator" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleQuickTools" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleQuickTools_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Taskbar Window Switcher -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTaskbarTitle" Text="Taskbar Window Switcher" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtTaskbarDesc" Text="Tampilkan preview thumbnail aplikasi Windows yang sedang aktif" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleTaskbarModule" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleTaskbarModule_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <!-- Pomodoro & Stand Widget (@weldraws_) -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtPomodoroModuleTitle" Text="Pomodoro &amp; Stand Widget (@weldraws_)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtPomodoroModuleDesc" Text="Tampilkan widget Pomodoro fokus &amp; kebiasaan berdiri di Dynamic Island" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="TogglePomodoroModule" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="TogglePomodoroModule_Click"/>
                                    </Grid>
                                     <Border Height="1" Background="#24252D"/>

                                     <!-- Floating Dock & Launchpad Style (@weldraws_) -->
                                     <Grid Margin="0,10">
                                         <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                             <TextBlock x:Name="TxtFloatingDockTitle" Text="Dock Melayang &amp; Launchpad (@weldraws_)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                             <TextBlock x:Name="TxtFloatingDockDesc" Text="Ganti taskbar default Windows dengan Floating Dock melayang dan menu aplikasi bergaya macOS/iPadOS. Matikan switch ini kapan saja untuk kembali ke taskbar default Windows." Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                             <Button x:Name="BtnRestoreTaskbarDirect" Content="Kembalikan Taskbar Default Windows Sekarang" Style="{StaticResource RoundedBtnStyle}" Background="#2A3040" Foreground="#5AC8FA" BorderThickness="0" Padding="10,5" Margin="0,8,0,0" HorizontalAlignment="Left" Cursor="Hand" Click="BtnRestoreTaskbarDirect_Click"/>
                                              <Button x:Name="BtnManageDockApps" Content="⚙️ Atur Aplikasi di Dock..." Style="{StaticResource RoundedBtnStyle}" Background="#1E2A38" Foreground="#60A5FA" BorderBrush="#2D4057" BorderThickness="1" Padding="10,5" Margin="0,8,0,0" HorizontalAlignment="Left" Cursor="Hand" Click="BtnManageDockApps_Click"/>
                                         </StackPanel>
                                         <CheckBox x:Name="ToggleFloatingDock" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Click="ToggleFloatingDock_Click"/>
                                     </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 3. PAGE: LIVE ACTIVITIES                   -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageLiveActivities" Visibility="Collapsed">
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TxtLiveActivitiesHeaderTitle" Text="Pengaturan Pop-up Dynamic Live Activities" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtMediaHUDTitle" Text="Media HUD (Spotify &amp; Apple Music)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtMediaHUDDesc" Text="Tampilkan banner melayang saat lagu berganti" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleMediaHUD" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleMediaHUD_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBatteryHUDTitle" Text="Battery Alert &amp; Charging HUD" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtBatteryHUDDesc" Text="Animasi saat charger dicolok atau baterai laptop melemah" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleBatteryHUD" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleBatteryHUD_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBluetoothHUDTitle" Text="Bluetooth Connection HUD" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtBluetoothHUDDesc" Text="Pemberitahuan saat headset atau mouse nirkabel terhubung" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleBluetoothHUD" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleBluetoothHUD_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtVolumeHUDTitle" Text="Volume &amp; Brightness HUD" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtVolumeHUDDesc" Text="Menggantikan OSD volume bawaan Windows dengan kapsul modern" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleVolumeHUD" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleVolumeHUD_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 4. PAGE: CAT BUDDY & CHARACTERS            -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageCatBuddy" Visibility="Collapsed">
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TxtCatBuddyHeaderTitle" Text="Karakter Animasi di Dynamic Island (Idle Mode)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                                    <UniformGrid Columns="3" Margin="0,0,0,16">
                                        <!-- Nailong -->
                                        <Button x:Name="BtnCharNailong" Style="{StaticResource RoundedBtnStyle}" Background="#24262E" BorderBrush="#3B82F6" BorderThickness="2" Padding="12,14" Margin="0,0,8,0" Cursor="Hand" Click="BtnSelectChar_Click" Tag="Nailong">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🦖" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Nailong" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtNailongDesc" Text="Dinosaurus Kuning Lucu" Foreground="#9CA3AF" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Spongebob -->
                                        <Button x:Name="BtnCharSpongebob" Style="{StaticResource RoundedBtnStyle}" Background="#24262E" BorderBrush="Transparent" BorderThickness="2" Padding="12,14" Margin="4,0,4,0" Cursor="Hand" Click="BtnSelectChar_Click" Tag="Spongebob">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🧽" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Spongebob" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtSpongebobDesc" Text="Tarian Ikonik Kartun" Foreground="#9CA3AF" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Minion -->
                                        <Button x:Name="BtnCharMinion" Style="{StaticResource RoundedBtnStyle}" Background="#24262E" BorderBrush="Transparent" BorderThickness="2" Padding="12,14" Margin="8,0,0,0" Cursor="Hand" Click="BtnSelectChar_Click" Tag="Minion">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🍌" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Minion" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtMinionDesc" Text="Banana Dance Bob" Foreground="#9CA3AF" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <Border Height="1" Background="#24252D" Margin="0,8,0,12"/>

                                    <TextBlock x:Name="TxtIdleAltTitle" Text="Mode Tampilan Idle Alternatif" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button x:Name="BtnIdleCat" Style="{StaticResource RoundedBtnStyle}" Background="#25272F" Foreground="#FFFFFF" BorderThickness="0" Padding="12,7" Margin="0,0,8,6" Cursor="Hand" Click="BtnIdleMode_Click" Tag="Cat" FontFamily="Segoe UI Emoji, Segoe UI">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#FF9F0A" Margin="0,0,6,0" VerticalAlignment="Center" Data="M12,14c-1.66,0-3,1.34-3,3s1.34,3,3,3 3,-1.34,3,-3-1.34,-3-3,-3zm-6.5,-4c-1.38,0-2.5,1.12-2.5,2.5S4.12,15 5.5,15 8,13.88 8,12.5 6.88,10 5.5,10zm13,0c-1.38,0-2.5,1.12-2.5,2.5s1.12,2.5 2.5,2.5 2.5,-1.12 2.5,-2.5-1.12,-2.5,-2.5,-2.5zM8.5,4C7.12,4 6,5.12 6,6.5S7.12,9 8.5,9 11,7.88 11,6.5 9.88,4 8.5,4zm7,0c-1.38,0-2.5,1.12-2.5,2.5S14.12,9 15.5,9 18,7.88 18,6.5 16.88,4 15.5,4z"/>
                                                <TextBlock x:Name="TxtIdleCatLabel" Text="Karakter Animasi" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnIdleBattery" Style="{StaticResource RoundedBtnStyle}" Background="#25272F" Foreground="#FFFFFF" BorderThickness="0" Padding="12,7" Margin="0,0,8,6" Cursor="Hand" Click="BtnIdleMode_Click" Tag="Battery" FontFamily="Segoe UI Emoji, Segoe UI">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#34C759" Margin="0,0,6,0" VerticalAlignment="Center" Data="M15.67,4H14V2h-4v2H8.33C7.6,4 7,4.6 7,5.33v15.33C7,21.4 7.6,22 8.33,22h7.33c0.74,0 1.34,-0.6 1.34,-1.33V5.33C17,4.6 16.4,4 15.67,4z"/>
                                                <TextBlock x:Name="TxtIdleBatteryLabel" Text="Status Baterai" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnIdleMusic" Style="{StaticResource RoundedBtnStyle}" Background="#25272F" Foreground="#FFFFFF" BorderThickness="0" Padding="12,7" Margin="0,0,8,6" Cursor="Hand" Click="BtnIdleMode_Click" Tag="Music" FontFamily="Segoe UI Emoji, Segoe UI">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#FA2D48" Margin="0,0,6,0" VerticalAlignment="Center" Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"/>
                                                <TextBlock x:Name="TxtIdleMusicLabel" Text="Pemutar Musik" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnIdleLyrics" Style="{StaticResource RoundedBtnStyle}" Background="#25272F" Foreground="#FFFFFF" BorderThickness="0" Padding="12,7" Margin="0,0,8,6" Cursor="Hand" Click="BtnIdleMode_Click" Tag="Lyrics" FontFamily="Segoe UI Emoji, Segoe UI">

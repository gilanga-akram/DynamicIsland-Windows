                                        <Button x:Name="BtnIdleCat" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,0,8,6" Click="BtnIdleMode_Click" Tag="Cat">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#FF9F0A" Margin="0,0,6,0" VerticalAlignment="Center" Data="M12,14c-1.66,0-3,1.34-3,3s1.34,3,3,3 3,-1.34,3,-3-1.34,-3-3,-3zm-6.5,-4c-1.38,0-2.5,1.12-2.5,2.5S4.12,15 5.5,15 8,13.88 8,12.5 6.88,10 5.5,10zm13,0c-1.38,0-2.5,1.12-2.5,2.5s1.12,2.5 2.5,2.5 2.5,-1.12 2.5,-2.5-1.12,-2.5,-2.5,-2.5zM8.5,4C7.12,4 6,5.12 6,6.5S7.12,9 8.5,9 11,7.88 11,6.5 9.88,4 8.5,4zm7,0c-1.38,0-2.5,1.12-2.5,2.5S14.12,9 15.5,9 18,7.88 18,6.5 16.88,4 15.5,4z"/>
                                                <TextBlock x:Name="TxtIdleCatLabel" Text="Karakter Animasi" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnIdleBattery" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,0,8,6" Click="BtnIdleMode_Click" Tag="Battery">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#34C759" Margin="0,0,6,0" VerticalAlignment="Center" Data="M15.67,4H14V2h-4v2H8.33C7.6,4 7,4.6 7,5.33v15.33C7,21.4 7.6,22 8.33,22h7.33c0.74,0 1.34,-0.6 1.34,-1.33V5.33C17,4.6 16.4,4 15.67,4z"/>
                                                <TextBlock x:Name="TxtIdleBatteryLabel" Text="Status Baterai" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnIdleMusic" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,0,8,6" Click="BtnIdleMode_Click" Tag="Music">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#FA2D48" Margin="0,0,6,0" VerticalAlignment="Center" Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"/>
                                                <TextBlock x:Name="TxtIdleMusicLabel" Text="Pemutar Musik" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnIdleLyrics" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,0,8,6" Click="BtnIdleMode_Click" Tag="Lyrics">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="13" Height="13" Fill="#AF52DE" Margin="0,0,6,0" VerticalAlignment="Center" Data="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3zm-1,-9c0,-.55 .45,-1 1,-1s1,.45 1,1v6c0,.55 -.45,1 -1,1s-1,-.45 -1,-1V5zm6,6c0,2.76 -2.24,5 -5,5s-5,-2.24 -5,-5H5c0,3.53 2.61,6.43 6,6.92V21h2v-3.08c3.39,-.49 6,-3.39 6,-6.92h-2z"/>
                                                <TextBlock x:Name="TxtIdleLyricsLabel" Text="Lirik Lagu Realtime" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnIdlePerf" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,0,8,6" Click="BtnIdleMode_Click" Tag="Performance">

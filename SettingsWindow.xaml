                                             <Button x:Name="BtnRestoreTaskbarDirect" Content="Kembalikan Taskbar Default Windows Sekarang" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left" Click="BtnRestoreTaskbarDirect_Click"/>
                                              <Button x:Name="BtnManageDockApps" Content="Atur Aplikasi di Dock..." Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left" Click="BtnManageDockApps_Click"/>

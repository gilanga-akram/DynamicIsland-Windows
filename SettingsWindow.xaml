                                            <TextBlock x:Name="TxtBluetoothHUDDesc" Text="Pemberitahuan saat headset atau mouse nirkabel terhubung" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleBluetoothHUD" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleBluetoothHUD_Click"/>

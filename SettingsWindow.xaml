                                        <CheckBox x:Name="TogglePostureReminder" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="TogglePostureReminder_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">

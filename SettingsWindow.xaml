                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Izin Notifikasi Windows" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock Text="Agar nama pengirim dan isi pesan terbaca lengkap, izinkan akses notifikasi di Windows" Foreground="#98989F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"/>

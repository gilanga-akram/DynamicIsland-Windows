                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtWifiSSIDTitle" Text="Nama Jaringan Wi-Fi Aktif" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtWifiSSIDDesc" Text="Tampilkan SSID Wi-Fi di Command Center Nook" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 13. PAGE: SCREEN TIME                      -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageScreenTime" Visibility="Collapsed">
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TxtScreenTimeHeaderTitle" Text="Statistik Layar &amp; Pembatasan Fokus" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTrackScreenTimeTitle" Text="Lacak Waktu Penggunaan Aplikasi" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtTrackScreenTimeDesc" Text="Mencatat durasi jendela aplikasi yang sedang aktif" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleTrackScreenTime" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleTrackScreenTime_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtScreenLimitTitle" Text="Batas Maksimal Waktu Layar Harian" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtScreenLimitDesc" Text="Peringatan saat penggunaan layar melampaui batas" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderScreenLimit" Style="{StaticResource PositionSliderStyle}" Width="150" Minimum="2" Maximum="12" Value="6" ValueChanged="SliderScreenLimit_ValueChanged"/>
                                            <TextBlock x:Name="TxtScreenLimit" Text="6 Jam" Foreground="#FFFFFF" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 14. PAGE: DAY PROGRESS                     -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageDayProgress" Visibility="Collapsed">
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TxtDayProgressHeaderTitle" Text="Progres Hari &amp; Jam Kerja" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                                    <Grid Margin="0,10">
                                        <TextBlock Text="Jam Masuk Kerja (Mulai Hari)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbWorkStart" Style="{StaticResource DarkComboBoxStyle}" Width="160" HorizontalAlignment="Right" SelectionChanged="CmbWorkHours_SelectionChanged">
                                            <ComboBoxItem Content="08:00 Pagi"/>
                                            <ComboBoxItem Content="09:00 Pagi" IsSelected="True"/>
                                            <ComboBoxItem Content="10:00 Pagi"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <Grid Margin="0,10">
                                        <TextBlock Text="Jam Pulang Kerja (Selesai Hari)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbWorkEnd" Style="{StaticResource DarkComboBoxStyle}" Width="160" HorizontalAlignment="Right" SelectionChanged="CmbWorkHours_SelectionChanged">
                                            <ComboBoxItem Content="17:00 Sore"/>
                                            <ComboBoxItem Content="18:00 Sore" IsSelected="True"/>
                                            <ComboBoxItem Content="19:00 Malam"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 15. PAGE: BLUETOOTH & WI-FI                -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageBluetoothWifi" Visibility="Collapsed">
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TxtBluetoothWifiHeaderTitle" Text="Konektivitas Nirkabel &amp; Perangkat" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBluetoothDeviceTitle" Text="Tampilkan Status Baterai Aksesoris" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtBluetoothDeviceDesc" Text="Menampilkan indikator daya headset &amp; mouse di compact notch" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleAccBattery" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="#24252D"/>

                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtWifiSSIDTitle" Text="Nama Jaringan Wi-Fi Aktif" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtWifiSSIDDesc" Text="Tampilkan SSID Wi-Fi di Command Center Nook" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleWifiSSID" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 16. PAGE: WELCOME                          -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageWelcome" Visibility="Collapsed">
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="24,20">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TxtWelcomeTitle" Text="Selamat Datang di Dynamic Island Pro" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtWelcomeDesc" Text="Dynamic Island Windows 11 dengan notch hardware interaktif, animasi fluida, pemutar media, Shelf AirDrop, dan monitoring hardware lengkap." 
                                               Foreground="#9CA3AF" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <Border Background="#131418" BorderBrush="#262730" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtShortcutHeader" Text="💡 Pintasan Cepat:" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TxtShortcut1" Text="• Klik Kiri Notch: Membuka dan menutup panel menu lengkap." Foreground="#D1D5DB" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="TxtShortcut2" Text="• Klik Kanan Notch: Membuka jendela Dynamic Settings ini langsung!" Foreground="#D1D5DB" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="TxtShortcut3" Text="• Tarik File ke Notch: Otomatis masuk ke Shelf untuk disimpan / dibagikan." Foreground="#D1D5DB" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="TxtShortcut4" Text="• Klik Karakter Dino / Bob: Karakter melompat &amp; mengeluarkan suara." Foreground="#D1D5DB" FontSize="12" Margin="0,2"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 17. PAGE: SUPPORT CREATOR                  -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageSupportCreator" Visibility="Collapsed">
                            <!-- BRANDING HEADER BANNER -->
                            <Border Background="#1C1420" BorderBrush="#3B2238" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" Background="#381328" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="💖" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSupportHeaderTitle" Text="Dukung Pengembang (Support Creator)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock x:Name="TxtSupportHeaderDesc" Text="Bantu kami terus mengembangkan fitur &amp; update terbaru Dynamic Island Pro! Dukungan lokal melalui Saweria (QRIS) dan internasional melalui PayPal." Foreground="#D1D5DB" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DUAL QR PAYMENT METHODS (SAWERIA & PAYPAL SIDE BY SIDE) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <!-- Saweria (Left) -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- PayPal (Right) -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CARD 1: SAWERIA (QRIS INDONESIA) -->
                                <Border Grid.Column="0" Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,8,0">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="🇮🇩 " FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtSaweriaTitle" Text="Saweria (QRIS)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSaweriaDesc" Text="GoPay, OVO, DANA, BCA, Mandiri &amp; M-Banking" 
                                                   Foreground="#9CA3AF" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <!-- White Container for Saweria QR -->
                                        <Border Background="#FFFFFF" CornerRadius="14" Padding="10" Width="210" Height="210" HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <Image Source="pack://application:,,,/DynamicIsland;component/Assets/saweria_qr.png" 
                                                   Stretch="Uniform" Width="190" Height="190" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="210">
                                            <Button x:Name="BtnOpenSaweriaUrl" Content="🌐 Buka Saweria di Browser" Style="{StaticResource RoundedBtnStyle}" 
                                                    Background="#EC4899" Foreground="#FFFFFF" BorderThickness="0" Padding="12,7" Margin="0,0,0,8" 
                                                    FontSize="11" FontWeight="Bold" Cursor="Hand" Click="BtnOpenSaweriaUrl_Click"/>
                                            <Button x:Name="BtnCopySaweriaUrl" Content="📋 Salin Link Saweria" Style="{StaticResource RoundedBtnStyle}" 
                                                    Background="#2D303E" Foreground="#FFFFFF" BorderBrush="#3B4252" BorderThickness="1" Padding="12,6" 
                                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnCopySaweriaUrl_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2: PAYPAL (GLOBAL / INTERNATIONAL) -->
                                <Border Grid.Column="1" Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="8,0,0,0">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="🌐 " FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtPaypalTitle" Text="PayPal (Global)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtPaypalDesc" Text="Scan via PayPal App, Credit Card &amp; International" 
                                                   Foreground="#9CA3AF" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <!-- White Container for PayPal QR -->
                                        <Border Background="#FFFFFF" CornerRadius="14" Padding="10" Width="210" Height="210" HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <Image Source="pack://application:,,,/DynamicIsland;component/Assets/paypal_qr.png" 
                                                   Stretch="Uniform" Width="190" Height="190" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="210">
                                            <Button x:Name="BtnOpenPaypalUrl" Content="🌐 Buka PayPal di Browser" Style="{StaticResource RoundedBtnStyle}" 
                                                    Background="#0070BA" Foreground="#FFFFFF" BorderThickness="0" Padding="12,7" Margin="0,0,0,8" 
                                                    FontSize="11" FontWeight="Bold" Cursor="Hand" Click="BtnOpenPaypalUrl_Click"/>
                                            <Button x:Name="BtnCopyPaypalUrl" Content="📋 Salin Link PayPal" Style="{StaticResource RoundedBtnStyle}" 
                                                    Background="#2D303E" Foreground="#FFFFFF" BorderBrush="#3B4252" BorderThickness="1" Padding="12,6" 
                                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnCopyPaypalUrl_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- THANK YOU FOOTER CARD -->
                            <Border Background="#17181D" BorderBrush="#262730" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="☕ " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSupportFooter" Text="Setiap dukungan &amp; traktiran kopi sangat berarti untuk pengembangan Dynamic Island Pro!" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- PAGE: APLIKASI DOCK (DOCK MANAGEMENT)     -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageDockApps" Visibility="Collapsed">
                            <!-- Banner Card -->
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Kustomisasi Aplikasi di Dock" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="Atur daftar aplikasi, urutan, atau tambahkan aplikasi favorit Anda ke Floating Dock bawah layar." Foreground="#9CA3AF" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnResetDockSettings" Content="🔄 Reset Default" Style="{StaticResource RoundedBtnStyle}"
                                                Background="#262832" Foreground="#9CA3AF" Padding="12,7" Margin="0,0,8,0"
                                                FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnResetDockSettings_Click"/>
                                        <Button x:Name="BtnAddAppToDockSettings" Content="➕ Tambah Aplikasi ke Dock" Style="{StaticResource RoundedBtnStyle}"
                                                Background="#2563EB" Foreground="#FFFFFF" Padding="14,7"
                                                FontSize="11.5" FontWeight="Bold" Cursor="Hand" Click="BtnAddAppToDockSettings_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Items List Card -->
                            <Border Background="#1C1D22" BorderBrush="#282932" BorderThickness="1" CornerRadius="12" Padding="20,16">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Daftar Aplikasi yang Ditampilkan di Dock" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5"/>
                                        <TextBlock x:Name="TxtDockAppsCount" Text="Total: 12 Aplikasi" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="#282A34" Margin="0,0,0,10"/>

                                    <!-- Dynamic list container -->
                                    <StackPanel x:Name="PanelDockSettingsList" Orientation="Vertical"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>


                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🦖" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Nailong" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtNailongDesc" Text="Dinosaurus Kuning Lucu" Foreground="#98989F" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Spongebob -->
                                        <Button x:Name="BtnCharSpongebob" Style="{StaticResource RoundedBtnStyle}" Background="#323234" BorderBrush="Transparent" BorderThickness="2" Padding="12,14" Margin="4,0,4,0" Click="BtnSelectChar_Click" Tag="Spongebob">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🧽" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Spongebob" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtSpongebobDesc" Text="Tarian Ikonik Kartun" Foreground="#98989F" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Minion -->
                                        <Button x:Name="BtnCharMinion" Style="{StaticResource RoundedBtnStyle}" Background="#323234" BorderBrush="Transparent" BorderThickness="2" Padding="12,14" Margin="8,0,0,0" Click="BtnSelectChar_Click" Tag="Minion">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🍌" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Minion" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtMinionDesc" Text="Banana Dance Bob" Foreground="#98989F" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <Border Height="1" Background="{StaticResource SepBrush}" Margin="0,8,0,12"/>

                                    <TextBlock x:Name="TxtIdleAltTitle" Text="Mode Tampilan Idle Alternatif" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

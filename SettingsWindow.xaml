                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Coba Notifikasi" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock Text="Kirim contoh banner untuk melihat tampilannya" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="WhatsApp" Style="{StaticResource RoundedBtnStyle}" Padding="10,4" Margin="0,0,6,0" Click="BtnTestNotifWhatsApp_Click"/>
                                            <Button Content="Discord" Style="{StaticResource RoundedBtnStyle}" Padding="10,4" Margin="0,0,6,0" Click="BtnTestNotifDiscord_Click"/>
                                            <Button Content="Steam" Style="{StaticResource RoundedBtnStyle}" Padding="10,4" Click="BtnTestNotifSteam_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 4. PAGE: CAT BUDDY & CHARACTERS            -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageCatBuddy" Visibility="Collapsed">
                            <TextBlock x:Name="TxtCatBuddyHeaderTitle" Text="Karakter Animasi di Dynamic Island (Idle Mode)" Style="{StaticResource GroupHeader}"/>

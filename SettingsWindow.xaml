<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Settings"
        Height="720" Width="1000"
        MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- macOS style unified title bar: no Windows caption, traffic lights drawn by the app -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ================= Palette (macOS dark appearance) ================= -->
        <SolidColorBrush x:Key="GroupBg" Color="#282828"/>
        <SolidColorBrush x:Key="GroupLine" Color="#343436"/>
        <SolidColorBrush x:Key="SepBrush" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="Secondary" Color="#98989D"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Grouped box (System Settings "inset grouped" list) -->
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GroupBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GroupLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,2"/>
        </Style>

        <!-- Heading above a group box -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Sidebar icon tile + glyph -->
        <Style x:Key="NavIcon" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Glyphs}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- macOS switch: grey track, blue when on, white knob that slides -->
        <Style x:Key="ModernToggleSwitch" TargetType="{x:Type CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="34" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" Background="#3E3E41" BorderBrush="#1AFFFFFF" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#F2F2F2" HorizontalAlignment="Left" Margin="1,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0.6" Direction="270" Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0A84FF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#0A84FF"/>
                                <!-- final position comes from the margin; the transform only animates the slide -->
                                <Setter TargetName="Knob" Property="Margin" Value="15,0,0,0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" From="-14" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" From="14" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Knob" Property="Fill" Value="#DADADA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar row: rounded blue selection like System Settings -->
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#0A64D8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Traffic lights (close / minimise / zoom). Glyphs show while the cluster is hovered; grey when the window is inactive -->
        <Style x:Key="TrafficLight" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="0.5"/>
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="#4A4A4C"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless icon button (toolbar chevrons, clear-search) -->
        <Style x:Key="ToolbarBtn" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="FontFamily" Value="{StaticResource Glyphs}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search field text box (chrome drawn by the surrounding border) -->
        <Style x:Key="SearchTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#0A84FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider track pieces -->
        <Style x:Key="SliderFill" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2,0,0,2" Background="#0A84FF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="0,2,2,0" Background="#4A4A4D" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS slider: thin track, blue fill, white round knob -->
        <Style x:Key="PositionSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Ellipse x:Name="K" Fill="#F2F2F2" Stroke="#33000000" StrokeThickness="0.5">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0.8" Direction="270" Opacity="0.5"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="K" Property="Fill" Value="#DCDCDC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment of a segmented control (alignment buttons) -->
        <Style x:Key="AlignBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="FontFamily" Value="{StaticResource Glyphs}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pop-up menu items: blue highlight, check mark on the chosen one -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="5,0" Padding="6,3,12,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" FontSize="10" VerticalAlignment="Center" Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pop-up button face with the up/down chevrons -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Bd" Background="#3D3D40" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" Data="M0,4 L3.5,0.5 L7,4 M0,8 L3.5,11.5 L7,8" Stroke="#D8D8D8" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#47474A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#505053"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="8,2,8,10" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300"
                                        Background="#2F2F31" BorderBrush="#4A4A4D" BorderThickness="1" CornerRadius="8" Padding="0,5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS push button (works with any Background: hover/press add a light overlay) -->
        <Style x:Key="RoundedBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#47474A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <Border x:Name="Overlay" Background="#FFFFFF" CornerRadius="6" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin overlay-style scroll bars -->
        <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="T" Background="#59FFFFFF" CornerRadius="3.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#8CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="9"/>
            <Setter Property="MinWidth" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- overlay scroll bars: only visible while the pointer is over the scrolling area -->
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Width="7"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="9"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,1">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Height="7"/>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#2F2F31"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4A4A4D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- SIDEBAR                                         -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="#262628" BorderBrush="#0E0E0E" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Traffic lights -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Background="Transparent"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnWinClose" Style="{StaticResource TrafficLight}" Background="#FF5F57" ToolTip="Tutup" Click="BtnWinClose_Click">
                        <Path Data="M0,0 L5,5 M5,0 L0,5" Stroke="#6B0A04" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="BtnWinMin" Style="{StaticResource TrafficLight}" Background="#FEBC2E" ToolTip="Minimalkan" Click="BtnWinMin_Click">
                        <Path Data="M0,0 L6,0" Stroke="#8A5300" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="BtnWinMax" Style="{StaticResource TrafficLight}" Background="#28C840" ToolTip="Perbesar" Click="BtnWinMax_Click">
                        <Path Data="M0,6 L0,1.6 L4.4,6 Z M6,0 L6,4.4 L1.6,0 Z" Fill="#0A5D14"/>
                    </Button>
                </StackPanel>

                <!-- Search -->
                <Grid Grid.Row="1" Margin="10,0,10,10" Height="28">
                    <Border x:Name="SearchBox" CornerRadius="7" Background="#12FFFFFF" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=TxtSearch}" Value="True">
                                        <Setter Property="BorderBrush" Value="#B30A84FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="#8E8E93" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="Cari" Foreground="#8E8E93" FontSize="13" Margin="29,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="TxtSearch" Style="{StaticResource SearchTextBox}" Margin="27,0,24,0" TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                    <Button x:Name="BtnClearSearch" Style="{StaticResource ToolbarBtn}" Width="22" Height="22" HorizontalAlignment="Right" Margin="0,0,3,0"
                            FontSize="9" Content="&#xE711;" Visibility="Collapsed" ToolTip="Hapus pencarian" Click="BtnClearSearch_Click"/>
                </Grid>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,10">
                    <StackPanel Orientation="Vertical">

                        <!-- Profile card (Welcome page) -->
                        <Button x:Name="NavWelcome" Style="{StaticResource NavButtonStyle}" Height="Auto" Padding="8,7" Margin="0,0,0,8" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0" Background="#1A1A1A" BorderBrush="#24FFFFFF" BorderThickness="0.5">
                                    <Image Source="pack://application:,,,/DynamicIsland;component/Assets/logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dynamic Island Pro" FontWeight="SemiBold" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0" Opacity="0.7">
                                        <TextBlock x:Name="TxtNavWelcome" Text="Selamat Datang" FontSize="11"/>
                                        <TextBlock x:Name="TxtAppVersion" Text=" · v1.4" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="TxtSearchEmpty" Text="Tidak ada hasil" Foreground="#8E8E93" FontSize="12" Margin="8,6" Visibility="Collapsed"/>

                        <!-- SECTION: DYNAMIC -->
                        <TextBlock x:Name="TxtSectionDynamic" Text="Dynamic" Foreground="#8E8E93" FontWeight="SemiBold" FontSize="11" Margin="8,4,8,4"/>

                        <Button x:Name="NavGeneral" Style="{StaticResource NavButtonStyle}" Tag="Active" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#8E8E93"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/></Border>
                                <TextBlock x:Name="TxtNavGeneral" Text="General" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavModules" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#5E5CE6"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xEA86;"/></Border>
                                <TextBlock x:Name="TxtNavModules" Text="Modules" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLiveActivities" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#FF453A"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xEA8F;"/></Border>
                                <TextBlock x:Name="TxtNavLiveActivities" Text="Live Activities" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavCatBuddy" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#FF9F0A"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE76E;"/></Border>
                                <TextBlock x:Name="TxtNavCatBuddy" Text="Cat Buddy" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavCursor" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#32ADE6"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE962;"/></Border>
                                <TextBlock x:Name="TxtNavCursor" Text="Cursor" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- SECTION: MODULES -->
                        <TextBlock x:Name="TxtSectionModules" Text="Modul &amp; Fitur" Foreground="#8E8E93" FontWeight="SemiBold" FontSize="11" Margin="8,14,8,4"/>

                        <Button x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#636366"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE740;"/></Border>
                                <TextBlock x:Name="TxtNavDashboard" Text="Ukuran Dynamic" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavMedia" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#FF2D55"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8D6;"/></Border>
                                <TextBlock x:Name="TxtNavMedia" Text="Media" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavCalendar" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#F2F2F7"><TextBlock Style="{StaticResource NavGlyph}" Foreground="#FF3B30" Text="&#xE787;"/></Border>
                                <TextBlock x:Name="TxtNavCalendar" Text="Calendar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavWeather" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#30A8E0"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE706;"/></Border>
                                <TextBlock x:Name="TxtNavWeather" Text="Weather" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPrayerTimes" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#30D158"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE708;"/></Border>
                                <TextBlock x:Name="TxtNavPrayerTimes" Text="Prayer Times" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPomodoro" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#AF52DE"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE916;"/></Border>
                                <TextBlock x:Name="TxtNavPomodoro" Text="Pomodoro" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavHealth" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#FF375F"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE95E;"/></Border>
                                <TextBlock x:Name="TxtNavHealth" Text="Health" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavScreenTime" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#5856D6"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE823;"/></Border>
                                <TextBlock x:Name="TxtNavScreenTime" Text="Screen Time" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDayProgress" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#00B8A9"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE9D2;"/></Border>
                                <TextBlock x:Name="TxtNavDayProgress" Text="Day Progress" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBluetoothWifi" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#0A84FF"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE701;"/></Border>
                                <TextBlock x:Name="TxtNavBluetoothWifi" Text="Bluetooth &amp; Wi-Fi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDockApps" Style="{StaticResource NavButtonStyle}" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#A2845E"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE71D;"/></Border>
                                <TextBlock x:Name="TxtNavDockApps" Text="Aplikasi Dock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSupportCreator" Style="{StaticResource NavButtonStyle}" Margin="0,14,0,1" Click="NavTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavIcon}" Background="#FF375F"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xEB51;"/></Border>
                                <TextBlock x:Name="TxtNavSupportCreator" Text="Support Creator" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar footer -->
                <Border Grid.Row="2" Height="14" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00262628" Offset="0"/>
                            <GradientStop Color="#FF262628" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Grid.Row="3" Padding="12,10,12,12" BorderBrush="#33FFFFFF" BorderThickness="0,0.5,0,0">
                    <StackPanel Orientation="Vertical">
                        <Button x:Name="BtnQuickSupport" Content="Support Creator" Style="{StaticResource RoundedBtnStyle}" Height="26" Padding="10,0" Margin="0,0,0,6"
                                FontSize="12" Click="BtnQuickSupport_Click"/>
                        <Button x:Name="BtnExitApp" Content="Keluar Aplikasi" Style="{StaticResource RoundedBtnStyle}" Height="26" Padding="10,0" Foreground="#FF6961"
                                FontSize="12" Click="BtnExitApp_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- CONTENT                                         -->
        <!-- ============================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: back / forward + page title (drag area of the window) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Button x:Name="BtnNavBack" Style="{StaticResource ToolbarBtn}" Content="&#xE76B;" ToolTip="Kembali" IsEnabled="False" Click="BtnNavBack_Click"/>
                <Button x:Name="BtnNavForward" Style="{StaticResource ToolbarBtn}" Content="&#xE76C;" ToolTip="Maju" IsEnabled="False" Margin="2,0,0,0" Click="BtnNavForward_Click"/>
                <TextBlock x:Name="HeaderTitleText" Text="General" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,1"/>
            </StackPanel>
            <Border x:Name="ToolbarLine" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="#0E0E0E" Opacity="0"/>

            <!-- PAGES CONTAINER -->
            <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="PageScroller_ScrollChanged">
                <StackPanel MaxWidth="720" Margin="28,6,28,28">

                    <!-- Page hero: big icon, title and a short description (like the top of each System Settings pane) -->
                    <Border x:Name="HeroCard" Style="{StaticResource Group}" Padding="18,16" Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HeroIconBox" Width="52" Height="52" CornerRadius="12" Background="#8E8E93" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeroIconGlyph" Text="&#xE713;" FontFamily="{StaticResource Glyphs}" FontSize="26" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="HeroTitle" Text="General" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17"/>
                                <TextBlock x:Name="HeroDesc" Text="" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <!-- ========================================== -->
                        <!-- 1. PAGE: GENERAL                           -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageGeneral" Visibility="Visible">

                            <Border Style="{StaticResource Group}">
                                <StackPanel Orientation="Vertical">

                                    <!-- Launch at login -->
                                    <Grid Margin="0,10">
                                        <TextBlock x:Name="TxtLaunchAtLoginTitle" Text="Launch at login" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ToggleLaunchAtLogin" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleLaunchAtLogin_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Show Dynamic on -->
                                    <Grid Margin="0,10">
                                        <TextBlock x:Name="TxtShowDynamicOn" Text="Show Dynamic on" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbDisplay" Style="{StaticResource DarkComboBoxStyle}" Width="180" HorizontalAlignment="Right" SelectionChanged="CmbDisplay_SelectionChanged">
                                            <ComboBoxItem Content="Primary display"/>
                                            <ComboBoxItem Content="Monitor 1"/>
                                            <ComboBoxItem Content="Monitor 2"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Language / Bahasa Aplikasi -->
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtGeneralLanguageTitle" Text="Bahasa Aplikasi (Language)" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtGeneralLanguageDesc" Text="Pilih bahasa tampilan untuk Dynamic Island &amp; Menu Pengaturan" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="CmbLanguage" Style="{StaticResource DarkComboBoxStyle}" Width="220" SelectionChanged="CmbLanguage_SelectionChanged">
                                            <ComboBoxItem Tag="id" Content="Bahasa Indonesia"/>
                                            <ComboBoxItem Tag="en-US" Content="English (US)"/>
                                            <ComboBoxItem Tag="en-GB" Content="English (UK)"/>
                                            <ComboBoxItem Tag="zh" Content="简体中文 (Mandarin)"/>
                                            <ComboBoxItem Tag="ru" Content="Русский (Russian)"/>
                                            <ComboBoxItem Tag="de" Content="Deutsch (German)"/>
                                            <ComboBoxItem Tag="pl" Content="Polski (Polish)"/>
                                            <ComboBoxItem Tag="ja" Content="日本語 (Japanese)"/>
                                            <ComboBoxItem Tag="ko" Content="한국어 (Korean)"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Position along the top -->
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtPositionTitle" Text="Position along the top" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtPositionDesc" Text="Or just drag Dynamic left/right (when it's open: drag its top bar). It snaps to the centre." 
                                                       Foreground="#98989F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Border CornerRadius="6" Background="#3D3D40" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource AlignBtnStyle}" Content="&#xE8E4;" ToolTip="Rata Kiri" Click="BtnAlignLeft_Click"/><Button Style="{StaticResource AlignBtnStyle}" Content="&#xE8E3;" ToolTip="Tengah" Click="BtnAlignCenter_Click"/><Button Style="{StaticResource AlignBtnStyle}" Content="&#xE8E2;" ToolTip="Rata Kanan" Click="BtnAlignRight_Click"/></StackPanel></Border>
                                            <Slider x:Name="SliderPosition" Style="{StaticResource PositionSliderStyle}" Width="160" Minimum="0" Maximum="100" Value="50" 
                                                    ValueChanged="SliderPosition_ValueChanged" Margin="8,0,8,0"/>
                                            <TextBlock x:Name="TxtPositionPercent" Text="50%" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Lock position -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtLockPositionTitle" Text="Lock position" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtLockPositionDesc" Text="Stop Dynamic from being dragged by accident" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleLockPosition" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleLockPosition_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Hide when an app is fullscreen -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtHideFullscreenTitle" Text="Hide when an app is fullscreen" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtHideFullscreenDesc" Text="Games, videos and presentations" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleHideFullscreen" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleHideFullscreen_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Auto-hide -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtAutoHideTitle" Text="Auto-hide" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtAutoHideDesc" Text="Dynamic waits above the top edge of the screen and comes down when you move the mouse there, so maximized windows get the whole screen. Alerts, reminders and the volume HUD still show." 
                                                       Foreground="#98989F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleAutoHide" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleAutoHide_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Hide button -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtHideButtonTitle" Text="Hide button" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtHideButtonDesc" Text="An eye button at the top of the open Dynamic that tucks it away to a thin handle at the top edge, out of the way of tabs and title bars. Click or tap the handle to bring it back. Right-clicking Dynamic twice does the same." 
                                                       Foreground="#98989F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleHideButton" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleHideButton_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Touchscreen support -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtTouchscreenTitle" Text="Touchscreen support" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtTouchscreenDesc" Text="A tap on Dynamic reaches Dynamic. Without it, Dynamic only takes clicks once the mouse points at it, so a finger's tap goes to the window below. Taps beside Dynamic still go there." 
                                                       Foreground="#98989F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleTouchscreen" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleTouchscreen_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Keep windows below Dynamic -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtKeepWindowsBelowTitle" Text="Keep windows below Dynamic" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtKeepWindowsBelowDesc" Text="Maximized windows start under Dynamic, so it never covers tabs or title bars. Uses a thin strip at the top of the screen. Not used while Auto-hide is on." 
                                                       Foreground="#98989F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleKeepWindowsBelow" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Click="ToggleKeepWindowsBelow_Click"/>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 2. PAGE: MODULES (HABISIN SEMUA MODUL)     -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageModules" Visibility="Collapsed">
                            <TextBlock x:Name="TxtModulesHeaderTitle" Text="Aktifkan &amp; Sesuaikan Tampilan Modul Tab Ribbon" Style="{StaticResource GroupHeader}"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel Orientation="Vertical">
                                    <!-- Dynamic Island (Poni Atas) Switch -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock x:Name="TxtDynamicIslandModuleTitle" Text="Dynamic Island (Poni Atas)" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtDynamicIslandModuleDesc" Text="Tampilkan Dynamic Island di bagian atas layar. Matikan switch ini jika Anda hanya ingin menggunakan Dock saja tanpa Dynamic Island." Foreground="#98989F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleEnableDynamicIsland" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleEnableDynamicIsland_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Sound Effects -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSoundEffectsTitle" Text="Sound Effects (Audio Feedback)" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtSoundEffectsDesc" Text="Efek suara haptic audio saat klik dan buka tab Dynamic Island" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleSoundEffects" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleSoundEffects_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Clipboard Manager & Shelf -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtClipboardTitle" Text="Shelf &amp; Clipboard Drop Hub" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtClipboardDesc" Text="Aktifkan rak penyimpanan file sementara dan riwayat copy teks" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleClipboard" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleClipboard_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Quick Tools Palette -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtQuickToolsTitle" Text="Quick Tools &amp; Utilities" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtQuickToolsDesc" Text="Akses cepat Snipping Tool, Eyedropper, Task Manager, dan Kalkulator" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleQuickTools" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleQuickTools_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Taskbar Window Switcher -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTaskbarTitle" Text="Taskbar Window Switcher" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtTaskbarDesc" Text="Tampilkan preview thumbnail aplikasi Windows yang sedang aktif" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleTaskbarModule" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleTaskbarModule_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <!-- Pomodoro & Stand Widget (@weldraws_) -->
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtPomodoroModuleTitle" Text="Pomodoro &amp; Stand Widget (@weldraws_)" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtPomodoroModuleDesc" Text="Tampilkan widget Pomodoro fokus &amp; kebiasaan berdiri di Dynamic Island" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="TogglePomodoroModule" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="TogglePomodoroModule_Click"/>
                                    </Grid>
                                     <Border Height="1" Background="{StaticResource SepBrush}"/>

                                     <!-- Floating Dock & Launchpad Style (@weldraws_) -->
                                     <Grid Margin="0,10">
                                         <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">

                                        <Button x:Name="BtnAddAppToDockSettings" Content="Tambah Aplikasi..." Style="{StaticResource RoundedBtnStyle}"
                                                Background="#0A84FF" Foreground="#FFFFFF" Padding="12,4"
                                                FontSize="12.5" Click="BtnAddAppToDockSettings_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Items List Card -->
                            <Border Style="{StaticResource Group}">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,12,0,8">
                                        <TextBlock Text="Daftar Aplikasi yang Ditampilkan di Dock" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="TxtDockAppsCount" Text="Total: 12 Aplikasi" Foreground="#98989D" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}" Margin="0,0,0,10"/>

                                    <!-- Dynamic list container -->
                                    <StackPanel x:Name="PanelDockSettingsList" Orientation="Vertical"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
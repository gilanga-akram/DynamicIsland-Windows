                                                <TextBlock x:Name="TxtIdleClockLabel" Text="Jam &amp; Indikator Audio" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 5. PAGE: CURSOR                            -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageCursor" Visibility="Collapsed">
                            <TextBlock x:Name="TxtCursorHeaderTitle" Text="Interaksi Mouse &amp; Efek Kursor" Style="{StaticResource GroupHeader}"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDodgeBrowserTitle" Text="Mode Ngumpet Tab Browser (Auto-Dodge)" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtDodgeBrowserDesc" Text="Sembunyikan Dynamic Island otomatis ke atas layar saat kursor mendekati tab browser (Chrome, Edge, Firefox, dll), agar tab di belakangnya dapat diklik bebas." Foreground="#98989F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleDodgeBrowserTabs" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleDodgeBrowserTabs_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>
                                    <Grid Margin="0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCursorMagnetTitle" Text="Magnetic Snap ke Notch" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtCursorMagnetDesc" Text="Kursor memiliki daya tarik halus saat melintas dekat Dynamic Island" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleCursorMagnet" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleCursorMagnet_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtHoverDelayTitle" Text="Hover Dwell Delay (Pencegah Gesekan Tidak Sengaja)" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock x:Name="TxtHoverDelayDesc" Text="Waktu jeda kursor sebelum notch membuka otomatis (180ms)" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderHoverDelay" Style="{StaticResource PositionSliderStyle}" Width="150" Minimum="0" Maximum="400" Value="180" ValueChanged="SliderHoverDelay_ValueChanged"/>
                                            <TextBlock x:Name="TxtHoverDelay" Text="180ms" Foreground="#FFFFFF" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 6. PAGE: DASHBOARD (UKURAN DYNAMIC ISLAND) -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageDashboard" Visibility="Collapsed">

                            <!-- SECTION 1: UKURAN DYNAMIC ISLAND CARD -->
                            <Border Style="{StaticResource Group}" Padding="16,12" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDynamicSizeHeader" Text="Ukuran Dynamic Island" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="TxtDynamicSizeDesc" Text="Sesuaikan dimensi notch saat standby (Normal) dan saat terbuka (Expanded)" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- Quick Presets -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="BtnPresetCompact" Content="Kecil" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,0,6,0" Click="PresetCompact_Click"/>
                                            <Button x:Name="BtnPresetDefault" Content="Standar" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Margin="0,0,6,0" Click="PresetDefault_Click"/>
                                            <Button x:Name="BtnPresetLarge" Content="Besar" Style="{StaticResource RoundedBtnStyle}" Padding="12,4" Click="PresetLarge_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 2-Column Dimension Sliders -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Normal Size Controls -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtCompactGroup" Text="Saat Normal (Standby Island)" Foreground="#98989F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            
                                            <!-- Compact Width -->
                                            <Grid Margin="0,3">
                                                <TextBlock x:Name="TxtCompactWidth" Text="Lebar Normal" Foreground="#E5E5EA" FontSize="11.5" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCompactW" Text="240 px" Foreground="#98989D" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderCompactW" Style="{StaticResource PositionSliderStyle}" Minimum="160" Maximum="360" Value="240" ValueChanged="SliderCompactW_ValueChanged"/>

                                            <!-- Compact Height -->
                                            <Grid Margin="0,8,0,3">
                                                <TextBlock x:Name="TxtCompactHeight" Text="Tinggi Normal" Foreground="#E5E5EA" FontSize="11.5" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCompactH" Text="32 px" Foreground="#98989D" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderCompactH" Style="{StaticResource PositionSliderStyle}" Minimum="28" Maximum="46" Value="32" ValueChanged="SliderCompactH_ValueChanged"/>
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Rectangle Grid.Column="1" Fill="#3A3A3C" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                        <!-- Right: Expanded Size Controls -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="TxtExpandedGroup" Text="Saat Terbuka (Expanded Island)" Foreground="#98989F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            
                                            <!-- Expanded Width -->
                                            <Grid Margin="0,3">
                                                <TextBlock x:Name="TxtExpandedWidth" Text="Lebar Terbuka" Foreground="#E5E5EA" FontSize="11.5" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtExpandedW" Text="680 px" Foreground="#98989D" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderExpandedW" Style="{StaticResource PositionSliderStyle}" Minimum="480" Maximum="850" Value="680" ValueChanged="SliderExpandedW_ValueChanged"/>

                                            <!-- Expanded Height -->
                                            <Grid Margin="0,8,0,3">
                                                <TextBlock x:Name="TxtExpandedHeight" Text="Tinggi Terbuka" Foreground="#E5E5EA" FontSize="11.5" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtExpandedH" Text="95 px" Foreground="#98989D" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderExpandedH" Style="{StaticResource PositionSliderStyle}" Minimum="75" Maximum="140" Value="95" ValueChanged="SliderExpandedH_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>


                                    <Border Background="#1E1E1E" BorderBrush="#343436" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtShortcutHeader" Text="Pintasan Cepat:" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TxtShortcut1" Text="• Klik Kiri Notch: Membuka dan menutup panel menu lengkap." Foreground="#E5E5EA" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="TxtShortcut2" Text="• Klik Kanan Notch: Membuka jendela Dynamic Settings ini langsung!" Foreground="#E5E5EA" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="TxtShortcut3" Text="• Tarik File ke Notch: Otomatis masuk ke Shelf untuk disimpan / dibagikan." Foreground="#E5E5EA" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="TxtShortcut4" Text="• Klik Karakter Dino / Bob: Karakter melompat &amp; mengeluarkan suara." Foreground="#E5E5EA" FontSize="12" Margin="0,2"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- 17. PAGE: SUPPORT CREATOR                  -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="PageSupportCreator" Visibility="Collapsed">

                            <!-- DUAL QR PAYMENT METHODS (SAWERIA & PAYPAL SIDE BY SIDE) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <!-- Saweria (Left) -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- PayPal (Right) -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CARD 1: SAWERIA (QRIS INDONESIA) -->
                                <Border Grid.Column="0" Background="{StaticResource GroupBg}" BorderBrush="{StaticResource GroupLine}" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,8,0">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtSaweriaTitle" Text="Saweria (QRIS)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSaweriaDesc" Text="GoPay, OVO, DANA, BCA, Mandiri &amp; M-Banking" 
                                                   Foreground="#98989F" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <!-- White Container for Saweria QR -->
                                        <Border Background="#FFFFFF" CornerRadius="14" Padding="10" Width="210" Height="210" HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <Image Source="pack://application:,,,/DynamicIsland;component/Assets/saweria_qr.png" 
                                                   Stretch="Uniform" Width="190" Height="190" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="210">
                                            <Button x:Name="BtnOpenSaweriaUrl" Content="Buka Saweria di Browser" Style="{StaticResource RoundedBtnStyle}" 
                                                    Background="#0A84FF" BorderThickness="0" Padding="12,4" Margin="0,0,0,8" 
                                                    FontSize="12.5" Click="BtnOpenSaweriaUrl_Click"/>
                                            <Button x:Name="BtnCopySaweriaUrl" Content="Salin Link Saweria" Style="{StaticResource RoundedBtnStyle}" 
                                                    Padding="12,4" 
                                                    FontSize="12.5" Click="BtnCopySaweriaUrl_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2: PAYPAL (GLOBAL / INTERNATIONAL) -->
                                <Border Grid.Column="1" Background="{StaticResource GroupBg}" BorderBrush="{StaticResource GroupLine}" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="8,0,0,0">

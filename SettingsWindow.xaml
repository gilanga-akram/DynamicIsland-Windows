                                        </StackPanel>
                                        <CheckBox x:Name="ToggleNotifAll" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleNotifAll_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <Grid Margin="0,10">
                                        <Image Source="/Assets/icon_WhatsApp.png" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center" Margin="42,0,0,0">
                                            <TextBlock Text="WhatsApp" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock Text="Pesan masuk WhatsApp (aplikasi desktop atau WhatsApp Web)" Foreground="#98989F" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleNotifWhatsApp" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleNotifWhatsApp_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SepBrush}"/>

                                    <Grid Margin="0,10">
                                        <Image Source="/Assets/icon_Discord.png" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

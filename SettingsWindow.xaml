                                    <TextBlock x:Name="TxtSupportFooter" Text="Setiap dukungan &amp; traktiran kopi sangat berarti untuk pengembangan Dynamic Island Pro!" Foreground="#98989F" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>


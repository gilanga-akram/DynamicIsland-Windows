                                            <Button x:Name="BtnOpenPaypalUrl" Content="Buka PayPal di Browser" Style="{StaticResource RoundedBtnStyle}" 
                                                    Background="#0A84FF" BorderThickness="0" Padding="12,4" Margin="0,0,0,8" 
                                                    FontSize="12.5" Click="BtnOpenPaypalUrl_Click"/>
                                            <Button x:Name="BtnCopyPaypalUrl" Content="Salin Link PayPal" Style="{StaticResource RoundedBtnStyle}" 
                                                    Padding="12,4" 
                                                    FontSize="12.5" Click="BtnCopyPaypalUrl_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

